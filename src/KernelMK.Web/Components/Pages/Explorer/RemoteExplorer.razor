    private record Breadcrumb(string Name, string Path);

    private List<Breadcrumb> GetBreadcrumbs()
    {
        var list = new List<Breadcrumb>();
        if (string.IsNullOrWhiteSpace(_currentPath) || _currentPath == "/") return list;

        var parts = _currentPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var current = "";
        foreach (var p in parts)
        {
            current += "/" + p;
            list.Add(new Breadcrumb(p, current));
        }
        return list;
    }

    private static string GetFileIcon(string? ext) => ext switch
    {
        ".edi" => "📦",
        ".csv" or ".xlsx" or ".xls" => "📊",
        ".json" or ".xml" or ".yaml" or ".yml" => "⚙️",
        ".txt" or ".log" => "📝",
        ".zip" or ".tar" or ".gz" or ".7z" => "🗜️",
        ".pdf" => "📕",
        ".png" or ".jpg" or ".jpeg" => "🖼️",
        _ => "📄"
    };
