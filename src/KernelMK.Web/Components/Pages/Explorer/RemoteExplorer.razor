    private async Task UploadFileAsync(InputFileChangeEventArgs e)
    {
        var cred = CurrentCredential;
        if (cred is null) return;
        var host = cred.Host ?? "";
        if (string.IsNullOrWhiteSpace(host)) return;

        _isUploading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var secret = Protector.Unprotect(cred.EncryptedSecret);
            var passphrase = string.IsNullOrEmpty(cred.EncryptedPassphrase) ? null : Protector.Unprotect(cred.EncryptedPassphrase);
            var port = cred.Port is > 0 ? cred.Port.Value : (_protocol == StepType.TransfertSftp ? 22 : 21);

            var files = e.GetMultipleFiles(maximumFileCount: 30);
            foreach (var file in files)
            {
                await using var stream = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024); // 100 Mo max
                await BrowserService.UploadFileStreamAsync(_protocol, host, port, cred.Username ?? "anonymous", secret, _currentPath, file.Name, stream, cred.AuthType, passphrase);
            }

            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erreur lors de l'envoi du fichier : {ex.Message}";
        }
        finally
        {
            _isUploading = false;
            StateHasChanged();
        }
    }

    private List<string> GetPreviewLines()
    {
        if (string.IsNullOrEmpty(_previewContent)) return new();

        string content = _previewContent;

        if (_formatEdi && content.Contains('\''))
        {
            var segments = content.Split('\'', StringSplitOptions.RemoveEmptyEntries);
            return segments
                .Select(s => s.Trim())
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Select(s => s + "'")
                .ToList();
        }

        return content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None).ToList();
    }

    private async Task CopyPreviewAsync()
    {
        if (string.IsNullOrEmpty(_previewContent)) return;
        await JS.InvokeVoidAsync("kernelMK.copyToClipboard", _previewContent);
        _copiedToClipboard = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copiedToClipboard = false;
        StateHasChanged();
    }

