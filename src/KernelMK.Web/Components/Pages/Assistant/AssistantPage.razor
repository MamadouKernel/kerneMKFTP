@page "/assistant"
@rendermode InteractiveServer
@attribute [Authorize]
@using KernelMK.Engine.Assistant
@inject AssistantService Assistant

<PageTitle>Assistant · kernelMK</PageTitle>

<div class="mb-6">
    <h1 class="flex items-center gap-2.5">
        <span class="h-9 w-9 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center shadow-sm">
            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" /></svg>
        </span>
        Assistant
    </h1>
    <p class="text-sm text-slate-500 mt-1">
        Pose une question sur tes jobs — l'assistant répond en interrogeant directement les données réelles
        de la plateforme (aucune IA externe, tout reste local).
    </p>
</div>

<div class="kmk-card mb-6">
    <div class="kmk-card-body">
        <div class="flex gap-2 mb-4">
            <input class="kmk-input" placeholder="Ex : Pourquoi le job Sauvegarde_Logs a échoué ?"
                   @bind="_question" @bind:event="oninput" @onkeydown="OnKeyDown" />
            <button class="kmk-btn-primary shrink-0" @onclick="AskAsync" disabled="@_loading">Demander</button>
        </div>

        <div class="flex flex-wrap gap-2 mb-4">
            @foreach (var suggestion in Suggestions)
            {
                <button type="button" class="kmk-badge-info hover:opacity-80" @onclick="() => AskSuggestionAsync(suggestion)">@suggestion</button>
            }
        </div>

        @if (_loading)
        {
            <div class="flex items-center gap-2 text-sm text-slate-400">
                <svg class="animate-spin h-4 w-4 text-brand-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                Recherche en cours...
            </div>
        }

        @if (_history.Count > 0)
        {
            <div class="space-y-3 mt-2">
                @foreach (var (q, a) in Enumerable.Reverse(_history))
                {
                    <div class="flex justify-end">
                        <div class="bg-brand-600 text-white text-sm rounded-2xl rounded-tr-sm px-4 py-2.5 max-w-[80%] shadow-sm">@q</div>
                    </div>
                    <div class="flex justify-start">
                        <div class="bg-slate-100 text-slate-700 text-sm rounded-2xl rounded-tl-sm px-4 py-2.5 max-w-[80%] whitespace-pre-line">@a</div>
                    </div>
                }
            </div>
        }
        else if (!_loading)
        {
            <div class="text-center py-10 text-slate-400">
                <div class="text-3xl mb-2">💬</div>
                <p class="text-sm">Choisis une suggestion ci-dessus ou pose ta propre question pour démarrer.</p>
            </div>
        }
    </div>
</div>

@code {
    private string _question = "";
    private bool _loading;
    private readonly List<(string Question, string Answer)> _history = new();

    private static readonly string[] Suggestions =
    {
        "Combien de jobs y a-t-il ?",
        "Pourquoi le dernier job a-t-il échoué ?",
        "Combien de fichiers ont été traités ?",
        "Quels sont les types de transfert disponibles ?",
        "Quels types d'étapes existent ?",
        "À quoi sert un message COPARN ?"
    };

    private async Task OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AskAsync();
    }

    private async Task AskSuggestionAsync(string suggestion)
    {
        _question = suggestion;
        await AskAsync();
    }

    private async Task AskAsync()
    {
        if (string.IsNullOrWhiteSpace(_question)) return;
        _loading = true;
        var asked = _question;
        StateHasChanged();

        var answer = await Assistant.AskAsync(asked);
        _history.Add((asked, answer));
        _question = "";
        _loading = false;
    }
}
