    private async Task DownloadAsync(byte[] bytes, string mimeType, string fileNamePrefix, string extension)
    {
        var base64 = Convert.ToBase64String(bytes);
        var fileName = $"{fileNamePrefix}-{DateTime.Now:yyyyMMdd-HHmm}.{extension}";
        await JS.InvokeVoidAsync("kernelMK.downloadFile", fileName, mimeType, base64);
    }

    private static byte[] BuildCsv(string[] headers, IEnumerable<string[]> rows)
    {
        var sb = new StringBuilder();
        sb.Append('﻿');
        sb.AppendLine(string.Join(';', headers.Select(EscapeCsv)));
        foreach (var row in rows)
        {
            sb.AppendLine(string.Join(';', row.Select(EscapeCsv)));
        }
        return Encoding.UTF8.GetBytes(sb.ToString());
    }

    private static byte[] BuildExcel(string sheetName, string[] headers, IEnumerable<string[]> rows)
    {
        using var wb = new XLWorkbook();
        var ws = wb.Worksheets.Add(sheetName);

        for (var c = 0; c < headers.Length; c++)
        {
            ws.Cell(1, c + 1).Value = headers[c];
        }
        ws.Row(1).Style.Font.Bold = true;
        ws.Row(1).Style.Fill.BackgroundColor = XLColor.FromArgb(241, 245, 249);
        ws.SheetView.FreezeRows(1);

        var r = 2;
        foreach (var row in rows)
        {
            for (var c = 0; c < row.Length; c++)
            {
                // Même neutralisation que le CSV (voir EscapeCsv) : par défense en profondeur, on ne laisse
                // jamais une cellule commencer par =, +, -, @ ou une tabulation, même si le format .xlsx
                // stocke le texte comme littéral (moins exposé que le CSV, mais pas nul selon le lecteur).
                ws.Cell(r, c + 1).Value = EscapeSpreadsheetLeadingChar(row[c]);
            }
            r++;
        }

        ws.Columns().AdjustToContents();

        using var ms = new MemoryStream();
        wb.SaveAs(ms);
        return ms.ToArray();
    }

    private static byte[] BuildPdf(string title, string[] headers, IEnumerable<string[]> rows)
    {
        static IContainer HeaderCellStyle(IContainer c) => c.Background(Colors.Grey.Lighten3).Padding(4)
            .BorderBottom(1).BorderColor(Colors.Grey.Medium).DefaultTextStyle(t => t.Bold());
        static IContainer BodyCellStyle(IContainer c) => c.Padding(4).BorderBottom(0.5f).BorderColor(Colors.Grey.Lighten2);

        var document = Document.Create(container =>
        {
            container.Page(page =>
            {
                page.Size(PageSizes.A4.Landscape());
                page.Margin(24);
                page.DefaultTextStyle(x => x.FontSize(8));

                page.Header().Column(col =>
                {
                    col.Item().Text(title).FontSize(13).Bold();
                    col.Item().Text($"kernelMK · Côte d'Ivoire Terminal · Généré le {DateTime.Now:dd/MM/yyyy HH:mm}")
                        .FontSize(8).FontColor(Colors.Grey.Darken1);
                    col.Item().PaddingTop(8);
                });

                page.Content().Table(table =>
                {
                    table.ColumnsDefinition(columns =>
                    {
                        foreach (var _ in headers) columns.RelativeColumn();
                    });

                    table.Header(header =>
                    {
                        foreach (var h in headers)
                        {
                            header.Cell().Element(HeaderCellStyle).Text(h);
                        }
                    });

                    foreach (var row in rows)
                    {
                        foreach (var cell in row)
                        {
                            table.Cell().Element(BodyCellStyle).Text(cell);
                        }
                    }
                });

                page.Footer().AlignCenter().Text(x =>
                {
                    x.CurrentPageNumber();
                    x.Span(" / ");
                    x.TotalPages();
                });
            });
        });

        return document.GeneratePdf();
    }

    private static string EscapeCsv(string value)
    {
        value = EscapeSpreadsheetLeadingChar(value);

        if (value.Contains(';') || value.Contains('"') || value.Contains('\n') || value.Contains('\r'))
        {
            return string.Concat("\"", value.Replace("\"", "\"\""), "\"");
        }
        return value;
    }

    /// <summary>
    /// Neutralise l'injection de formule (CSV/Excel) : un tableur peut interpréter toute cellule commençant
    /// par =, +, -, @ ou une tabulation comme une formule à exécuter à l'ouverture. Appliqué à la fois au CSV
    /// (où le risque est direct) et à l'Excel généré via ClosedXML (où .xlsx stocke normalement le texte comme
    /// littéral, mais on neutralise quand même par défense en profondeur, le comportement variant selon le lecteur).
    /// </summary>
    private static string EscapeSpreadsheetLeadingChar(string value) =>
        value.Length > 0 && (value[0] is '=' or '+' or '-' or '@' or '\t') ? "'" + value : value;
}
