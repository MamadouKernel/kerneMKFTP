@page "/jobs/new"
@rendermode InteractiveServer
@page "/jobs/{JobId:guid}"
@page "/jobs/{JobId:guid}/edit"
@page "/jobs/edit/{JobId:guid}"
@attribute [Authorize(Roles = "Administrateur,Developpeur")]
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using KernelMK.Core.StepConfigs
@using KernelMK.Data.Security
@using KernelMK.Engine.Audit
@using KernelMK.Engine.Execution
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuditService Audit
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject ConnectionTestService TestService
@inject CredentialProtector Protector
@inject KernelMK.Engine.Notifications.NotificationDispatcher NotificationDispatcher

<PageTitle>@(IsNew ? "Nouveau job" : "Modifier le job") · kernelMK</PageTitle>

@if (_loading)
{
    <p class="text-sm text-slate-500">Chargement...</p>
}
else
{
    <h1 class="mb-6">@(IsNew ? "Nouveau job" : $"Job : {_job.Name}")</h1>

    <EditForm Model="_job" OnValidSubmit="SaveAsync">
        <div class="kmk-card mb-5">
            <div class="kmk-card-header">Informations générales</div>
            <div class="kmk-card-body grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="kmk-label">Nom</label>
                    <InputText class="kmk-input" @bind-Value="_job.Name" />
                </div>
                <div>
                    <label class="kmk-label">Propriétaire</label>
                    <InputText class="kmk-input" @bind-Value="_job.Owner" />
                </div>
                <div class="md:col-span-2">
                    <label class="kmk-label">Description / objectif</label>
                    <InputTextArea class="kmk-input" @bind-Value="_job.Description" />
                </div>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:col-span-2">
                    <div>
                        <label class="kmk-label">Criticité</label>
                        <InputSelect class="kmk-select" @bind-Value="_job.Criticite">
                            @foreach (var c in Enum.GetValues<Criticite>())
                            {
                                <option value="@c">@c</option>
                            }
                        </InputSelect>
                    </div>
                    <div>
                        <label class="kmk-label">Compte d'exécution</label>
                        <InputText class="kmk-input" @bind-Value="_job.ExecutionAccount" />
                    </div>
                    <div>
                        <label class="kmk-label">Timeout job (s)</label>
                        <InputNumber class="kmk-input" @bind-Value="_job.TimeoutSeconds" />
                    </div>
                    <div>
                        <label class="kmk-label">Tentatives max</label>
                        <InputNumber class="kmk-input" @bind-Value="_job.MaxRetries" />
                    </div>
                </div>
                <div>
                    <label class="kmk-label">Délai reprise (s)</label>
                    <InputNumber class="kmk-input" @bind-Value="_job.RetryDelaySeconds" />
                </div>
                <div class="flex items-end gap-6">
                    <label class="flex items-center gap-2 text-sm text-slate-700">
                        <InputCheckbox class="kmk-checkbox" @bind-Value="_job.AllowConcurrentExecution" />
                        Exécution concurrente autorisée
                    </label>
                    <label class="flex items-center gap-2 text-sm text-slate-700">
                        <InputCheckbox class="kmk-checkbox" @bind-Value="_job.Enabled" />
                        Job actif
                    </label>
                </div>
            </div>
        </div>

        <div class="kmk-card mb-5">
            <div class="kmk-card-header">
                <span>Étapes (tâches)</span>
                <button type="button" class="kmk-btn-primary kmk-btn-sm" @onclick="AddStep">+ Ajouter une étape</button>
            </div>
            <div class="kmk-card-body space-y-4">
                <p class="text-xs text-slate-400 -mt-1">
                    💡 Astuce : choisis le type d'étape puis clique sur « Modèle JSON » pour préremplir la configuration
                    avec les champs attendus — il ne reste plus qu'à ajuster les valeurs (chemins, hôte, requête...).
                </p>
                @foreach (var step in _job.Steps.OrderBy(s => s.Order).ToList())
                {
                    <div class="border border-slate-200 rounded-lg p-4">
                        <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-3">
                            <div>
                                <label class="kmk-label">Ordre</label>
                                <input type="number" class="kmk-input" @bind="step.Order" />
                            </div>
                            <div class="col-span-2">
                                <label class="kmk-label">Nom</label>
                                <input class="kmk-input" @bind="step.Name" />
                            </div>
                            <div class="col-span-2">
                                <label class="kmk-label">Type</label>
                                <select class="kmk-select" value="@step.Type" @onchange="(e) => OnStepTypeChanged(step, e.Value?.ToString())">
                                    @foreach (var t in Enum.GetValues<StepType>())
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="kmk-label">Timeout (s)</label>
                                <input type="number" class="kmk-input" @bind="step.TimeoutSeconds" />
                            </div>
                            <div>
                                <label class="kmk-label">Reprises</label>
                                <input type="number" class="kmk-input" @bind="step.MaxRetries" />
                            </div>
                            <div>
                                <label class="kmk-label">Délai reprise (s)</label>
                                <input type="number" class="kmk-input" @bind="step.RetryDelaySeconds" />
                            </div>
                            <div class="col-span-2">
                                <label class="kmk-label">Action en cas d'échec</label>
                                <select class="kmk-select" @bind="step.OnErrorAction">
                                    @foreach (var a in Enum.GetValues<OnErrorAction>())
                                    {
                                        <option value="@a">@a</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="kmk-label">Succès → ordre</label>
                                <input type="number" class="kmk-input" @bind="step.OnSuccessGoToOrder" />
                            </div>
                            <div>
                                <label class="kmk-label">Échec → ordre</label>
                                <input type="number" class="kmk-input" @bind="step.OnFailureGoToOrder" />
                            </div>
                            <div class="col-span-2">
                                <label class="kmk-label">Credential</label>
                                <select class="kmk-select" value="@step.CredentialId" @onchange="(e) => OnCredentialChanged(step, e.Value?.ToString())">
                                    <option value="">(aucun)</option>
                                    @foreach (var c in _credentials)
                                    {
                                        <option value="@c.Id">@c.Name @(!string.IsNullOrWhiteSpace(c.Host) ? $" · {c.Host}" : "")</option>
                                    }
                                </select>
                            </div>
                            <div class="flex items-end">
                                <button type="button" class="kmk-btn-secondary w-full" @onclick="() => LoadTemplate(step)">Modèle par défaut</button>
                            </div>

                            @if (IsTransferStep(step.Type))
                            {
                                var tConfig = GetOrCreateTransferConfig(step);
                                <div class="col-span-2 sm:col-span-4 md:col-span-6 bg-slate-50/90 border border-slate-200/90 rounded-xl p-4 mt-2">
                                    <div class="flex items-center justify-between mb-3 border-b border-slate-200/60 pb-2">
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs font-bold uppercase tracking-wider text-slate-700">Paramètres de transfert (@step.Type)</span>
                                            @if (step.CredentialId != null && !string.IsNullOrWhiteSpace(GetCredentialHost(step.CredentialId)))
                                            {
                                                <span class="kmk-badge kmk-badge-info text-[10px]">Hérite de @GetCredentialName(step.CredentialId)</span>
                                            }
                                        </div>
                                        <button type="button" class="kmk-btn-secondary kmk-btn-sm text-xs" @onclick="() => ToggleRawJson(step)">
                                            @(IsRawJsonMode(step) ? "Afficher le formulaire" : "Mode JSON brut")
                                        </button>
                                    </div>

                                    @if (IsRawJsonMode(step))
                                    {
                                        <div class="space-y-1">
                                            <label class="kmk-label">Configuration (JSON brut)</label>
                                            <textarea class="kmk-input font-mono text-xs" rows="4" @bind="step.ConfigJson"></textarea>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
                                            @if (step.Type != StepType.TransfertSmb)
                                            {
                                                <div class="md:col-span-3">
                                                    <label class="kmk-label">Hôte / Serveur distant (nom ou adresse IP)</label>
                                                    <input class="kmk-input" placeholder="ex: sftp.partenaire.fr ou 192.168.1.50"
                                                           value="@tConfig.Host"
                                                           @oninput="(e) => { tConfig.Host = e.Value?.ToString() ?? string.Empty; SyncTransferConfig(step); }" />
                                                </div>
                                                <div>
                                                    <label class="kmk-label">Port</label>
                                                    <input type="number" class="kmk-input" placeholder="@(step.Type == StepType.TransfertSftp ? "22" : "21")"
                                                           value="@tConfig.Port"
                                                           @oninput="(e) => { if (int.TryParse(e.Value?.ToString(), out var p)) tConfig.Port = p; SyncTransferConfig(step); }" />
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="md:col-span-4">
                                                    <label class="kmk-label">Partage réseau SMB (chemin UNC)</label>
                                                    <input class="kmk-input font-mono text-xs" placeholder="ex: \\serveur\partage\dossier"
                                                           value="@tConfig.SmbShare"
                                                           @oninput="(e) => { tConfig.SmbShare = e.Value?.ToString(); SyncTransferConfig(step); }" />
                                                </div>
                                            }

                                            <div class="col-span-1 sm:col-span-2 md:col-span-4">
                                                <label class="kmk-label">Sens du transfert</label>
                                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                                    <label class="flex items-center gap-2.5 p-2.5 rounded-xl border @(!tConfig.Upload ? "border-brand-500 bg-brand-50/60 font-semibold text-brand-900 shadow-sm" : "border-slate-200 bg-white text-slate-700") cursor-pointer transition-all">
                                                        <input type="radio" name="@($"transfer_dir_{step.Order}")" checked="@(!tConfig.Upload)"
                                                               @onchange="() => { tConfig.Upload = false; SyncTransferConfig(step); }" class="kmk-checkbox" />
                                                        <span class="text-xs">
                                                            <span class="text-sm mr-1">⬇️</span> <strong>Télécharger</strong> (Serveur distant ➔ Dossier local)
                                                        </span>
                                                    </label>
                                                    <label class="flex items-center gap-2.5 p-2.5 rounded-xl border @(tConfig.Upload ? "border-brand-500 bg-brand-50/60 font-semibold text-brand-900 shadow-sm" : "border-slate-200 bg-white text-slate-700") cursor-pointer transition-all">
                                                        <input type="radio" name="@($"transfer_dir_{step.Order}")" checked="@(tConfig.Upload)"
                                                               @onchange="() => { tConfig.Upload = true; SyncTransferConfig(step); }" class="kmk-checkbox" />
                                                        <span class="text-xs">
                                                            <span class="text-sm mr-1">⬆️</span> <strong>Déposer / Envoyer</strong> (Dossier local ➔ Serveur distant)
                                                        </span>
                                                    </label>
                                                </div>
                                            </div>

                                            <div class="col-span-1 sm:col-span-2">
                                                <label class="kmk-label">Chemin distant (@(tConfig.Upload ? "dossier cible sur le serveur" : "dossier/fichier source sur le serveur"))</label>
                                                <input class="kmk-input font-mono text-xs" placeholder="ex: /upload/fichiers/ ou /in/fichier.csv"
                                                       value="@tConfig.RemotePath"
                                                       @oninput="(e) => { tConfig.RemotePath = e.Value?.ToString() ?? string.Empty; SyncTransferConfig(step); }" />
                                            </div>

                                            <div class="col-span-1 sm:col-span-2">
                                                <label class="kmk-label">Chemin local (@(tConfig.Upload ? "dossier/fichier source local" : "dossier cible local"))</label>
                                                <input class="kmk-input font-mono text-xs" placeholder="ex: C:\Donnees\Local\ ou C:\data\mon_fichier.csv"
                                                       value="@tConfig.LocalPath"
                                                       @oninput="(e) => { tConfig.LocalPath = e.Value?.ToString() ?? string.Empty; SyncTransferConfig(step); }" />
                                            </div>

                                            <div class="col-span-1 sm:col-span-2">
                                                <label class="kmk-label">Filtre de fichiers (multi-fichiers)</label>
                                                <input class="kmk-input font-mono text-xs" placeholder="ex: *.csv;*.txt;*.edi (vide = fichier unique)"
                                                       value="@tConfig.Filter"
                                                       @oninput="(e) => { tConfig.Filter = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value?.ToString(); SyncTransferConfig(step); }" />
                                            </div>

                                            <div class="col-span-1 sm:col-span-2">
                                                <label class="kmk-label">Armateur / Ligne Maritime (Partenaire)</label>
                                                <div class="flex gap-2">
                                                    <select class="kmk-select text-xs w-44 shrink-0"
                                                            value="@(string.IsNullOrEmpty(tConfig.Armateur) ? "" : tConfig.Armateur)"
                                                            @onchange="(e) => { var val = e.Value?.ToString(); if (!string.IsNullOrEmpty(val)) { tConfig.Armateur = val; SyncTransferConfig(step); } }">
                                                        <option value="">(Sélection...)</option>
                                                        <option value="GUCE">GUCE (Guichet Unique)</option>
                                                        <option value="DOUANE">Douane CI</option>
                                                        <option value="MSC">MSC</option>
                                                        <option value="CMA CGM">CMA CGM</option>
                                                        <option value="MAERSK">MAERSK</option>
                                                        <option value="HAPAG-LLOYD">HAPAG-LLOYD</option>
                                                        <option value="COSCO">COSCO</option>
                                                        <option value="ONE">ONE</option>
                                                        <option value="GRIMALDI">GRIMALDI</option>
                                                        <option value="PIL">PIL</option>
                                                        <option value="ARKAS">ARKAS</option>
                                                    </select>
                                                    <input class="kmk-input text-xs flex-1" placeholder="Nom du partenaire ou armateur (ex: GUCE, MSC, CMA CGM...)"
                                                           value="@tConfig.Armateur"
                                                           @oninput="(e) => { tConfig.Armateur = e.Value?.ToString(); SyncTransferConfig(step); }" />
                                                </div>
                                            </div>

                                            <div class="col-span-1 sm:col-span-2 flex flex-col justify-center gap-2 pt-1">
                                                @if (step.Type == StepType.TransfertFtps || step.Type == StepType.TransfertFtp)
                                                {
                                                    <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer">
                                                        <input type="checkbox" class="kmk-checkbox" checked="@tConfig.UseTls"
                                                               @onchange="(e) => { 
                                                                   tConfig.UseTls = (bool)(e.Value ?? false); 
                                                                   step.Type = tConfig.UseTls ? StepType.TransfertFtps : StepType.TransfertFtp;
                                                                   SyncTransferConfig(step); 
                                                               }" />
                                                        <span class="font-semibold text-slate-800">Chiffrement TLS / SSL explicite (FTPS)</span>
                                                        <span class="text-brand-600 text-[11px] font-medium bg-brand-50 px-1.5 py-0.5 rounded border border-brand-200">Requis pour GUCE</span>
                                                    </label>
                                                }
                                                @if (tConfig.Upload)
                                                {
                                                    <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer">
                                                        <input type="checkbox" class="kmk-checkbox" checked="@tConfig.ArchiveAfterTransfer"
                                                               @onchange="(e) => { tConfig.ArchiveAfterTransfer = (bool)(e.Value ?? false); SyncTransferConfig(step); }" />
                                                        <span class="font-semibold text-slate-800">Couper / Déplacer vers l'archive</span>
                                                        <span class="text-slate-500 text-[11px]">(déplace le fichier local pour ne plus le renvoyer)</span>
                                                    </label>
                                                }
                                                else
                                                {
                                                    <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer">
                                                        <input type="checkbox" class="kmk-checkbox" checked="@tConfig.DeleteRemoteAfterDownload"
                                                               @onchange="(e) => { tConfig.DeleteRemoteAfterDownload = (bool)(e.Value ?? false); SyncTransferConfig(step); }" />
                                                        <span class="font-semibold text-slate-800">Supprimer le fichier distant</span>
                                                        <span class="text-slate-500 text-[11px]">(évite de re-télécharger le même fichier au prochain tour)</span>
                                                    </label>
                                                }
                                            </div>

                                            @if (tConfig.Upload && tConfig.ArchiveAfterTransfer)
                                            {
                                                <div class="col-span-1 sm:col-span-2 md:col-span-4">
                                                    <label class="kmk-label">Dossier d'archivage local (où couper et ranger les fichiers envoyés)</label>
                                                    <input class="kmk-input font-mono text-xs" placeholder="ex: C:\Donnees\Archives\"
                                                           value="@tConfig.ArchiveDirectory"
                                                           @oninput="(e) => { tConfig.ArchiveDirectory = e.Value?.ToString(); SyncTransferConfig(step); }" />
                                                </div>
                                            }

                                            <!-- Zone Test de connexion en direct -->
                                            <div class="col-span-1 sm:col-span-2 md:col-span-4 pt-3 border-t border-slate-200/80 mt-1 flex flex-wrap items-center justify-between gap-3">
                                                <button type="button" class="kmk-btn-secondary kmk-btn-sm flex items-center gap-1.5"
                                                        disabled="@(_isTesting.GetValueOrDefault(step))"
                                                        @onclick="() => TestStepConnectionAsync(step)">
                                                    @if (_isTesting.GetValueOrDefault(step))
                                                    {
                                                        <svg class="animate-spin h-3.5 w-3.5 text-brand-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                                                        <span>Test de connexion en cours...</span>
                                                    }
                                                    else
                                                    {
                                                        <span>🔌 Tester la connexion au serveur</span>
                                                    }
                                                </button>

                                                @if (_testResults.TryGetValue(step, out var testResult) && testResult is not null)
                                                {
                                                    <div class="flex-1 min-w-[280px]">
                                                        @if (testResult.Success)
                                                        {
                                                            <div class="p-2.5 rounded-xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-800 flex items-start gap-2">
                                                                <span class="text-emerald-600 font-bold text-sm">✓</span>
                                                                <div>
                                                                    <div class="font-semibold">@testResult.Message</div>
                                                                    @if (!string.IsNullOrWhiteSpace(testResult.WorkingDirectory))
                                                                    {
                                                                        <div class="text-emerald-700 mt-0.5">@testResult.WorkingDirectory</div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="p-2.5 rounded-xl bg-red-50 border border-red-200 text-xs text-red-800 flex items-start gap-2">
                                                                <span class="text-red-600 font-bold text-sm">✗</span>
                                                                <div>
                                                                    <div class="font-semibold">Échec du test de connexion</div>
                                                                    <div class="text-red-700 mt-0.5">@testResult.Message</div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="col-span-2 sm:col-span-4 md:col-span-6">
                                    <label class="kmk-label">Configuration (JSON)</label>
                                    <textarea class="kmk-input font-mono text-xs" rows="4" @bind="step.ConfigJson"></textarea>
                                </div>
                            }
                            <div class="col-span-2 sm:col-span-4 md:col-span-6 text-right">
                                <button type="button" class="kmk-btn-danger kmk-btn-sm" @onclick="() => RemoveStep(step)">Supprimer l'étape</button>
                            </div>
                        </div>
                    </div>
                }
                @if (_job.Steps.Count == 0)
                {
                    <p class="text-sm text-slate-400">Aucune étape définie.</p>
                }
            </div>
        </div>

        <div class="kmk-card mb-5">
            <div class="kmk-card-header">
                <span>Déclencheurs</span>
                <button type="button" class="kmk-btn-primary kmk-btn-sm" @onclick="AddTrigger">+ Ajouter un déclencheur</button>
            </div>
            <div class="kmk-card-body space-y-4">
                @foreach (var trigger in _job.Triggers)
                {
                    <div class="border border-slate-200 rounded-lg p-4">
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                            <div>
                                <label class="kmk-label">Type</label>
                                <select class="kmk-select" @bind="trigger.Type">
                                    @foreach (var t in TriggerTypeChoices)
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </select>
                            </div>
                            <div class="flex items-end pb-2">
                                <label class="flex items-center gap-2 text-sm text-slate-700">
                                    <input type="checkbox" class="kmk-checkbox" @bind="trigger.Enabled" />
                                    Actif
                                </label>
                            </div>

                            @if (trigger.Type is TriggerType.Horaire or TriggerType.Cron)
                            {
                                <div>
                                    <label class="kmk-label">Intervalle (secondes)</label>
                                    <input type="number" class="kmk-input" placeholder="3600" @bind="trigger.IntervalSeconds" />
                                    <p class="text-[11px] text-slate-500 mt-1">Ex: 3600 (1h), 900 (15 min), 300 (5 min)</p>
                                </div>
                                <div class="col-span-2">
                                    <label class="kmk-label">Ou Expression Cron (6 champs)</label>
                                    <input class="kmk-input font-mono text-xs" placeholder="0 0 22 * * *" @bind="trigger.CronExpression" />
                                    <p class="text-[11px] text-slate-500 mt-1">Ex: <code>0 0 22 * * *</code> (22h00), <code>0 */15 * * * *</code> (toutes les 15 min)</p>
                                </div>
                            }
                            else if (trigger.Type == TriggerType.Calendrier)
                            {
                                <div>
                                    <label class="kmk-label">Jours (Mon,Tue,...)</label>
                                    <input class="kmk-input" placeholder="Mon,Tue,Wed,Thu,Fri" @bind="trigger.DaysOfWeekCsv" />
                                    <p class="text-[11px] text-slate-500 mt-1">Ex: Mon,Tue,Wed,Thu,Fri</p>
                                </div>
                                <div>
                                    <label class="kmk-label">Heure d'exécution</label>
                                    <input type="time" class="kmk-input" value="@WindowStartString(trigger)" @onchange="e => SetWindowStart(trigger, e.Value?.ToString())" />
                                    <p class="text-[11px] text-slate-500 mt-1">Heure fixe du lancement</p>
                                </div>
                                <div class="flex items-end pb-2">
                                    <label class="flex items-center gap-2 text-sm text-slate-700">
                                        <input type="checkbox" class="kmk-checkbox" @bind="trigger.ExcludeWeekends" />
                                        Exclure week-ends
                                    </label>
                                </div>
                                <div class="flex items-end pb-2">
                                    <label class="flex items-center gap-2 text-sm text-slate-700">
                                        <input type="checkbox" class="kmk-checkbox" @bind="trigger.ExcludeHolidays" />
                                        Exclure jours fériés
                                    </label>
                                </div>
                                <div class="col-span-2 sm:col-span-4">
                                    <label class="kmk-label">Jours fériés (yyyy-MM-dd,...)</label>
                                    <input class="kmk-input" placeholder="2026-01-01, 2026-05-01, 2026-08-07" @bind="trigger.HolidayDatesCsv" />
                                    <p class="text-[11px] text-slate-500 mt-1">Dates au format AAAA-MM-JJ séparées par des virgules</p>
                                </div>
                            }
                            else if (trigger.Type == TriggerType.EvenementDossier)
                            {
                                <div class="col-span-2">
                                    <label class="kmk-label">Dossier surveillé (File Watcher)</label>
                                    <input class="kmk-input font-mono text-xs" placeholder="K:\EDI\GUCE\OUT\ ou C:\SFTP\Outbox" @bind="trigger.FolderPath" />
                                    <p class="text-[11px] text-slate-500 mt-1">Chemin absolu du dossier local ou réseau partagé</p>
                                </div>
                                <div>
                                    <label class="kmk-label">Filtre fichiers</label>
                                    <input class="kmk-input font-mono text-xs" placeholder="*.edi ou *.xml" @bind="trigger.FolderFilter" />
                                    <p class="text-[11px] text-slate-500 mt-1">Ex: *.edi, *.xml, *.csv, *.*</p>
                                </div>
                                <div>
                                    <label class="kmk-label">Événement</label>
                                    <select class="kmk-select" @bind="trigger.FolderWatchEvent">
                                        @foreach (var ev in Enum.GetValues<FolderWatchEventType>())
                                        {
                                            <option value="@ev">@ev</option>
                                        }
                                    </select>
                                    <p class="text-[11px] text-slate-500 mt-1">Arrivée = dès qu'un fichier est prêt</p>
                                </div>
                            }
                            else if (trigger.Type == TriggerType.Api)
                            {
                                <div class="col-span-3">
                                    <label class="kmk-label">Jeton d'authentification API (Webhook)</label>
                                    <input class="kmk-input font-mono text-xs" placeholder="token-secret-guce-cit" @bind="trigger.WebhookToken" />
                                    <p class="text-[11px] text-slate-500 mt-1">URL de déclenchement : <code>POST http://[serveur]:5000/api/triggers/@(string.IsNullOrWhiteSpace(trigger.WebhookToken) ? "{jeton}" : trigger.WebhookToken)</code></p>
                                </div>
                            }

                            <div class="col-span-2 sm:col-span-4 text-right">
                                <button type="button" class="kmk-btn-danger kmk-btn-sm" @onclick="() => _job.Triggers.Remove(trigger)">Supprimer le déclencheur</button>
                            </div>
                        </div>
                    </div>
                }
                @if (_job.Triggers.Count == 0)
                {
                    <p class="text-sm text-slate-400">Aucun déclencheur défini (exécution manuelle uniquement).</p>
                }
            </div>
        </div>

        <div class="kmk-card mb-5">
            <div class="kmk-card-header">
                <span>Dépendances (chaînage de jobs)</span>
                <button type="button" class="kmk-btn-primary kmk-btn-sm" @onclick="AddDependency">+ Ajouter une dépendance</button>
            </div>
            <div class="kmk-card-body space-y-2">
                @foreach (var dep in _job.Dependencies)
                {
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                        <select class="kmk-select sm:col-span-1" @bind="dep.DependsOnJobId">
                            @foreach (var j in _otherJobs)
                            {
                                <option value="@j.Id">@j.Name</option>
                            }
                        </select>
                        <select class="kmk-select" @bind="dep.Condition">
                            @foreach (var c in Enum.GetValues<JobDependencyCondition>())
                            {
                                <option value="@c">@c</option>
                            }
                        </select>
                        <button type="button" class="kmk-btn-danger kmk-btn-sm justify-self-start" @onclick="() => _job.Dependencies.Remove(dep)">Supprimer</button>
                    </div>
                }
                @if (_job.Dependencies.Count == 0)
                {
                    <p class="text-sm text-slate-400">Ce job ne dépend d'aucun autre job.</p>
                }
            </div>
        </div>

        <div class="kmk-card mb-5">
            <div class="kmk-card-header flex justify-between items-center">
                <div class="flex items-center gap-2">
                    <svg class="h-5 w-5 text-brand-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" /></svg>
                    <span>Règles de Notifications & Alertes</span>
                </div>
                <button type="button" class="kmk-btn-primary kmk-btn-sm flex items-center gap-1.5" @onclick="AddNotificationRule">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                    <span>+ Ajouter une règle</span>
                </button>
            </div>
            <div class="kmk-card-body space-y-4">
                @foreach (var rule in _job.NotificationRules)
                {
                    var testState = _ruleTestStates.GetValueOrDefault(rule.Id, (false, null, null));
                    <div class="border border-slate-200 rounded-lg p-4 bg-slate-50/50 hover:bg-slate-50 transition-colors">
                        <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-end">
                            <div class="sm:col-span-3">
                                <label class="kmk-label">Événement déclencheur</label>
                                <select class="kmk-select text-xs font-semibold" @bind="rule.Event">
                                    @foreach (var ev in Enum.GetValues<NotificationEvent>())
                                    {
                                        <option value="@ev">@ev</option>
                                    }
                                </select>
                            </div>

                            <div class="sm:col-span-2">
                                <label class="kmk-label">Canal</label>
                                <select class="kmk-select text-xs font-semibold" @bind="rule.Channel">
                                    @foreach (var ch in Enum.GetValues<NotificationChannel>())
                                    {
                                        <option value="@ch">@ch</option>
                                    }
                                </select>
                            </div>

                            <div class="sm:col-span-4">
                                @if (rule.Channel == NotificationChannel.Email)
                                {
                                    <label class="kmk-label">Destinataires e-mails (séparés par virgule)</label>
                                    <input class="kmk-input text-xs" placeholder="m.konate@@cotedivoireterminal.com, support@@cit.ci" @bind="rule.RecipientsCsv" />
                                }
                                else if (rule.Channel == NotificationChannel.Teams)
                                {
                                    <label class="kmk-label">URL Webhook Microsoft Teams (Incoming Webhook)</label>
                                    <input class="kmk-input text-xs font-mono" placeholder="https://cotedivoireterminal.webhook.office.com/..." @bind="rule.WebhookUrl" />
                                }
                                else
                                {
                                    <label class="kmk-label">URL Webhook HTTP (POST JSON)</label>
                                    <input class="kmk-input text-xs font-mono" placeholder="https://supervision.cit/api/alertes" @bind="rule.WebhookUrl" />
                                }
                            </div>

                            <div class="sm:col-span-3 flex items-center justify-end gap-2 pb-0.5">
                                <button type="button" 
                                        class="kmk-btn-secondary kmk-btn-sm text-xs font-medium flex items-center gap-1.5 shadow-xs" 
                                        disabled="@testState.Testing"
                                        @onclick="() => TestNotificationRuleAsync(rule)">
                                    @if (testState.Testing)
                                    {
                                        <span class="inline-block animate-spin h-3.5 w-3.5 border-2 border-brand-500 border-t-transparent rounded-full"></span>
                                        <span>Envoi...</span>
                                    }
                                    else
                                    {
                                        <svg class="h-3.5 w-3.5 text-brand-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" /></svg>
                                        <span>Tester</span>
                                    }
                                </button>

                                <label class="flex items-center gap-1.5 text-xs text-slate-700 cursor-pointer select-none px-2 py-1 bg-white border border-slate-200 rounded">
                                    <input type="checkbox" class="kmk-checkbox h-3.5 w-3.5" @bind="rule.Enabled" />
                                    <span>Actif</span>
                                </label>

                                <button type="button" class="kmk-btn-danger kmk-btn-sm text-xs px-2 py-1" title="Supprimer la règle" @onclick="() => _job.NotificationRules.Remove(rule)">✕</button>
                            </div>
                        </div>

                        @if (testState.Success.HasValue)
                        {
                            <div class="mt-2.5 px-3 py-2 rounded-lg text-xs flex items-center gap-2 @(testState.Success.Value ? "bg-emerald-50 text-emerald-800 border border-emerald-200" : "bg-rose-50 text-rose-800 border border-rose-200")">
                                @if (testState.Success.Value)
                                {
                                    <svg class="h-4 w-4 text-emerald-600 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" /></svg>
                                }
                                else
                                {
                                    <svg class="h-4 w-4 text-rose-600 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" /></svg>
                                }
                                <span class="font-medium">@testState.Message</span>
                            </div>
                        }
                    </div>
                }
                @if (_job.NotificationRules.Count == 0)
                {
                    <p class="text-sm text-slate-400">Aucune notification configurée. Cliquez sur « + Ajouter une règle » pour être alerté par e-mail ou Teams.</p>
                }
            </div>
        </div>

        <div class="flex gap-3 mb-8">
            <button type="submit" class="kmk-btn-primary">Enregistrer</button>
            <a class="kmk-btn-secondary" href="jobs">Annuler</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public Guid? JobId { get; set; }

    private bool IsNew => JobId is null;
    private Job _job = new();
    private bool _loading = true;
    private List<Credential> _credentials = new();
    private List<Job> _otherJobs = new();
    private string? _currentUser;

    private static readonly TriggerType[] TriggerTypeChoices =
    {
        TriggerType.Horaire, TriggerType.Calendrier, TriggerType.EvenementDossier,
        TriggerType.Demarrage, TriggerType.Api, TriggerType.Manuel
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        _currentUser = authState.User.Identity?.Name;

        await using var db = await DbFactory.CreateDbContextAsync();
        _credentials = await db.Credentials.OrderBy(c => c.Name).ToListAsync();

        if (JobId is { } id)
        {
            _job = await db.Jobs
                .Include(j => j.Steps)
                .Include(j => j.Triggers)
                .Include(j => j.Dependencies)
                .Include(j => j.NotificationRules)
                .FirstAsync(j => j.Id == id);
            _otherJobs = await db.Jobs.Where(j => j.Id != id).OrderBy(j => j.Name).ToListAsync();
        }
        else
        {
            _job = new Job { CreatedBy = _currentUser };
            _otherJobs = await db.Jobs.OrderBy(j => j.Name).ToListAsync();
        }

        _loading = false;
    }

    private void AddStep()
    {
        var nextOrder = _job.Steps.Count == 0 ? 1 : _job.Steps.Max(s => s.Order) + 1;
        _job.Steps.Add(new JobStep { Order = nextOrder, Name = $"Étape {nextOrder}", Type = StepType.ScriptPowerShell, ConfigJson = "{}" });
    }

    private void AddTrigger() => _job.Triggers.Add(new JobTrigger { Type = TriggerType.Horaire, Enabled = true });

    private void AddDependency()
    {
        if (_otherJobs.Count == 0) return;
        _job.Dependencies.Add(new JobDependency { DependsOnJobId = _otherJobs.First().Id, Condition = JobDependencyCondition.Succes });
    }

    private void AddNotificationRule() => _job.NotificationRules.Add(new NotificationRule { Event = NotificationEvent.Echec, Channel = NotificationChannel.Email, Enabled = true });

    private readonly Dictionary<Guid, (bool Testing, bool? Success, string? Message)> _ruleTestStates = new();

    private async Task TestNotificationRuleAsync(NotificationRule rule)
    {
        _ruleTestStates[rule.Id] = (true, null, null);
        StateHasChanged();

        var result = await NotificationDispatcher.TestRuleAsync(rule, _job.Name ?? "Nouveau Job");
        _ruleTestStates[rule.Id] = (false, result.Success, result.Message);
        StateHasChanged();
    }

    private string WindowStartString(JobTrigger trigger) => trigger.WindowStart?.ToString(@"hh\:mm") ?? "22:00";

    private void SetWindowStart(JobTrigger trigger, string? value)
    {
        if (TimeSpan.TryParse(value, out var ts)) trigger.WindowStart = ts;
    }

    private readonly Dictionary<JobStep, TransferStepConfig> _transferConfigs = new();
    private readonly Dictionary<JobStep, bool> _rawJsonMode = new();
    private readonly Dictionary<JobStep, ConnectionTestResult?> _testResults = new();
    private readonly Dictionary<JobStep, bool> _isTesting = new();

    private static bool IsTransferStep(StepType type) =>
        type is StepType.TransfertSftp or StepType.TransfertFtp or StepType.TransfertFtps or StepType.TransfertSmb;

    private bool IsRawJsonMode(JobStep step) => _rawJsonMode.GetValueOrDefault(step, false);

    private void ToggleRawJson(JobStep step)
    {
        var current = IsRawJsonMode(step);
        if (!current)
        {
            SyncTransferConfig(step);
        }
        else
        {
            _transferConfigs.Remove(step);
            _ = GetOrCreateTransferConfig(step);
        }
        _rawJsonMode[step] = !current;
    }

    private string? GetCredentialHost(Guid? credentialId) =>
        credentialId is null ? null : _credentials.FirstOrDefault(c => c.Id == credentialId)?.Host;

    private string? GetCredentialName(Guid? credentialId) =>
        credentialId is null ? null : _credentials.FirstOrDefault(c => c.Id == credentialId)?.Name;

    private TransferStepConfig GetOrCreateTransferConfig(JobStep step)
    {
        if (!_transferConfigs.TryGetValue(step, out var config))
        {
            try
            {
                if (!string.IsNullOrWhiteSpace(step.ConfigJson) && step.ConfigJson != "{}")
                {
                    config = JsonSerializer.Deserialize<TransferStepConfig>(step.ConfigJson) ?? new TransferStepConfig();
                }
                else
                {
                    config = new TransferStepConfig
                    {
                        Host = "",
                        Port = step.Type == StepType.TransfertSftp ? 22 : 21,
                        Upload = false,
                        RemotePath = "/upload/fichiers/",
                        LocalPath = @"C:\Donnees\Local\",
                        Filter = null
                    };
                }
            }
            catch
            {
                config = new TransferStepConfig();
            }

            if (step.CredentialId is not null)
            {
                var cred = _credentials.FirstOrDefault(c => c.Id == step.CredentialId.Value);
                if (cred is not null)
                {
                    if (string.IsNullOrWhiteSpace(config.Host) && !string.IsNullOrWhiteSpace(cred.Host))
                    {
                        config.Host = cred.Host;
                    }
                    if (config.Port <= 0 && cred.Port is > 0)
                    {
                        config.Port = cred.Port.Value;
                    }
                }
            }

            _transferConfigs[step] = config;
        }
        return config;
    }

    private void SyncTransferConfig(JobStep step)
    {
        if (_transferConfigs.TryGetValue(step, out var config))
        {
            step.ConfigJson = JsonSerializer.Serialize(config, new JsonSerializerOptions { WriteIndented = true });
        }
    }

    private void OnCredentialChanged(JobStep step, string? credIdStr)
    {
        if (Guid.TryParse(credIdStr, out var id))
        {
            step.CredentialId = id;
            if (IsTransferStep(step.Type))
            {
                var cred = _credentials.FirstOrDefault(c => c.Id == id);
                if (cred is not null)
                {
                    var config = GetOrCreateTransferConfig(step);
                    if (!string.IsNullOrWhiteSpace(cred.Host))
                    {
                        config.Host = cred.Host;
                    }
                    if (cred.Port is > 0)
                    {
                        config.Port = cred.Port.Value;
                    }

                    // Détection intelligente GUCE / FTPS
                    if (cred.Name.Contains("guce", StringComparison.OrdinalIgnoreCase) ||
                        (cred.Host?.Contains("guce", StringComparison.OrdinalIgnoreCase) ?? false))
                    {
                        config.UseTls = true;
                        step.Type = StepType.TransfertFtps;
                        if (string.IsNullOrWhiteSpace(config.Armateur))
                        {
                            config.Armateur = "GUCE";
                        }
                    }
                    else if (cred.Port == 22)
                    {
                        config.UseTls = false;
                        step.Type = StepType.TransfertSftp;
                    }

                    SyncTransferConfig(step);
                }
            }
        }
        else
        {
            step.CredentialId = null;
        }
    }

    private void OnStepTypeChanged(JobStep step, string? typeStr)
    {
        if (Enum.TryParse<StepType>(typeStr, out var newType))
        {
            step.Type = newType;
            if (IsTransferStep(newType))
            {
                var config = GetOrCreateTransferConfig(step);
                if (newType == StepType.TransfertSftp && (config.Port <= 0 || config.Port == 21)) config.Port = 22;
                if ((newType == StepType.TransfertFtp || newType == StepType.TransfertFtps) && (config.Port <= 0 || config.Port == 22)) config.Port = 21;
                if (newType == StepType.TransfertFtps) config.UseTls = true;
                if (newType == StepType.TransfertFtp) config.UseTls = false;
                SyncTransferConfig(step);
            }
        }
    }

    private async Task TestStepConnectionAsync(JobStep step)
    {
        _isTesting[step] = true;
        _testResults[step] = null;
        StateHasChanged();

        var config = GetOrCreateTransferConfig(step);
        string? username = null;
        string? secret = null;
        var authType = CredentialAuthType.MotDePasse;
        string? passphrase = null;

        if (step.CredentialId is not null)
        {
            var cred = _credentials.FirstOrDefault(c => c.Id == step.CredentialId.Value);
            if (cred is not null)
            {
                username = cred.Username;
                authType = cred.AuthType;
                try
                {
                    secret = Protector.Unprotect(cred.EncryptedSecret);
                    passphrase = string.IsNullOrEmpty(cred.EncryptedPassphrase) ? null : Protector.Unprotect(cred.EncryptedPassphrase);
                }
                catch
                {
                    secret = null;
                }

                if (string.IsNullOrWhiteSpace(config.Host) && !string.IsNullOrWhiteSpace(cred.Host))
                {
                    config.Host = cred.Host;
                }
                if (config.Port <= 0 && cred.Port is > 0)
                {
                    config.Port = cred.Port.Value;
                }
            }
        }

        var host = !string.IsNullOrWhiteSpace(config.Host)
            ? config.Host
            : (step.CredentialId != null ? _credentials.FirstOrDefault(c => c.Id == step.CredentialId)?.Host ?? "" : "");

        var defaultPort = step.Type == StepType.TransfertSftp ? 22 : 21;
        var port = config.Port > 0 ? config.Port : defaultPort;

        var isTls = config.UseTls || step.Type == StepType.TransfertFtps;
        var effectiveType = (step.Type == StepType.TransfertFtp && isTls)
            ? StepType.TransfertFtps
            : step.Type;

        if (string.IsNullOrWhiteSpace(host))
        {
            _testResults[step] = ConnectionTestResult.Fail("L'adresse de l'hôte distant (nom ou IP) est obligatoire. Renseignez le champ 'Hôte / Serveur distant' ou sélectionnez un Credential.");
            _isTesting[step] = false;
            StateHasChanged();
            return;
        }

        if (isTls && port == 22)
        {
            _testResults[step] = ConnectionTestResult.Fail($"Erreur de port ({host}:22) : Le port 22 est réservé au protocole SFTP (SSH). Pour tester en FTPS (TLS/SSL explicite comme GUCE), veuillez renseigner le port du serveur (21 ou 990) dans le champ 'Port'.");
            _isTesting[step] = false;
            StateHasChanged();
            return;
        }

        _testResults[step] = await TestService.TestConnectionAsync(
            effectiveType,
            host,
            port,
            username,
            secret,
            config.RemotePath,
            useTls: isTls,
            authType: authType,
            passphrase: passphrase);

        _isTesting[step] = false;
        StateHasChanged();
    }

    private void RemoveStep(JobStep step)
    {
        _job.Steps.Remove(step);
        _transferConfigs.Remove(step);
        _rawJsonMode.Remove(step);
        _testResults.Remove(step);
        _isTesting.Remove(step);
    }

    private void LoadTemplate(JobStep step)
    {
        if (IsTransferStep(step.Type))
        {
            var port = step.Type == StepType.TransfertSftp ? 22 : 21;
            var defaultHost = "";
            if (step.CredentialId is not null)
            {
                var cred = _credentials.FirstOrDefault(c => c.Id == step.CredentialId.Value);
                if (cred is not null)
                {
                    defaultHost = cred.Host ?? "";
                    if (cred.Port is > 0) port = cred.Port.Value;
                }
            }

            var tConfig = new TransferStepConfig
            {
                Host = defaultHost,
                Port = port,
                Upload = false,
                RemotePath = "/upload/fichiers/",
                LocalPath = @"C:\Donnees\Local\",
                Filter = null
            };
            _transferConfigs[step] = tConfig;
            _rawJsonMode[step] = false;
            SyncTransferConfig(step);
            return;
        }

        object template = step.Type switch
        {
            StepType.CommandeSysteme or StepType.ScriptPowerShell or StepType.ScriptPython or StepType.ScriptBatch =>
                new ScriptStepConfig { Path = @"C:\scripts\exemple.ps1", Arguments = "-Param valeur" },
            StepType.FichierCopier or StepType.FichierDeplacer or StepType.FichierRenommer or StepType.FichierSupprimer
                or StepType.FichierCompresser or StepType.FichierDecompresser or StepType.FichierVerifier =>
                new FileOpStepConfig { SourcePath = @"C:\source", DestinationPath = @"C:\destination", Filter = "*.csv;*.txt;*.xml" },
            StepType.TransfertFtp or StepType.TransfertFtps or StepType.TransfertSftp or StepType.TransfertSmb =>
                new TransferStepConfig
                {
                    Host = "sftp.exemple.fr", Port = 22, Upload = true,
                    RemotePath = "/upload/fichier.csv", LocalPath = @"C:\data\fichier.csv",
                    Filter = null
                },
            StepType.BaseDeDonneesRequete or StepType.ScriptSql =>
                new SqlStepConfig { Provider = "Sqlite", ConnectionString = "Data Source=exemple.db", CommandText = "SELECT 1;" },
            StepType.EmailSmtp =>
                new EmailStepConfig { SmtpHost = "smtp.exemple.fr", SmtpPort = 587, From = "jobs@exemple.fr", ToCsv = "support@exemple.fr", Subject = "Notification", Body = "Traitement terminé." },
            StepType.Webhook or StepType.TransfertHttp =>
                new WebhookStepConfig { Url = "https://exemple.fr/webhook", Method = "POST" },
            StepType.ControleAttente or StepType.ControleCondition or StepType.ControleAppelJob =>
                new ControlStepConfig { Operation = ControlOperation.Attente, WaitSeconds = 30 },
            StepType.EdifactMessage =>
                new EdifactStepConfig
                {
                    Operation = EdifactOperation.Generer,
                    MessageType = EdifactMessageType.Coparn,
                    SenderId = "FRLEH", ReceiverId = "TERMINAL1", DocumentNumber = "BKG123456",
                    LocationCode = "FRLEH", VesselName = "MSC EXEMPLE", VoyageNumber = "0042E",
                    OutputPath = @"C:\edi\sortie\coparn_exemple.edi",
                    Containers = new List<EdifactContainerInfo>
                    {
                        new() { ContainerNumber = "MSCU1234567", SizeType = "22G1", FullEmpty = EdifactFullEmptyIndicator.Plein, GrossWeightKg = 18500 }
                    }
                },
            _ => new { }
        };

        step.ConfigJson = JsonSerializer.Serialize(template, new JsonSerializerOptions { WriteIndented = true });
    }

    private async Task SaveAsync()
    {
        // Synchroniser tous les formulaires visuels de transfert vers le ConfigJson
        foreach (var s in _job.Steps)
        {
            if (IsTransferStep(s.Type) && !_rawJsonMode.GetValueOrDefault(s, false))
            {
                SyncTransferConfig(s);
            }
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        if (IsNew)
        {
            _job.CreatedAt = DateTime.UtcNow;
            _job.CreatedBy = _currentUser;
            db.Jobs.Add(_job);
            await db.SaveChangesAsync();
            await Audit.LogAsync(AuditAction.Creation, nameof(Job), _job.Id.ToString(), _job.Name, null, _currentUser);
        }
        else
        {
            var existing = await db.Jobs
                .Include(j => j.Steps)
                .Include(j => j.Triggers)
                .Include(j => j.Dependencies)
                .Include(j => j.NotificationRules)
                .FirstAsync(j => j.Id == _job.Id);

            existing.Name = _job.Name;
            existing.Description = _job.Description;
            existing.Owner = _job.Owner;
            existing.Criticite = _job.Criticite;
            existing.Enabled = _job.Enabled;
            existing.MaxRetries = _job.MaxRetries;
            existing.RetryDelaySeconds = _job.RetryDelaySeconds;
            existing.TimeoutSeconds = _job.TimeoutSeconds;
            existing.AllowConcurrentExecution = _job.AllowConcurrentExecution;
            existing.ExecutionAccount = _job.ExecutionAccount;
            existing.UpdatedAt = DateTime.UtcNow;
            existing.UpdatedBy = _currentUser;

            existing.Steps.Clear();
            foreach (var s in _job.Steps)
            {
                existing.Steps.Add(new JobStep
                {
                    Order = s.Order, Name = s.Name, Type = s.Type, ConfigJson = s.ConfigJson,
                    CredentialId = s.CredentialId, TimeoutSeconds = s.TimeoutSeconds, MaxRetries = s.MaxRetries,
                    RetryDelaySeconds = s.RetryDelaySeconds, OnErrorAction = s.OnErrorAction,
                    OnSuccessGoToOrder = s.OnSuccessGoToOrder, OnFailureGoToOrder = s.OnFailureGoToOrder
                });
            }

            existing.Triggers.Clear();
            foreach (var t in _job.Triggers)
            {
                existing.Triggers.Add(new JobTrigger
                {
                    Type = t.Type, Enabled = t.Enabled, CronExpression = t.CronExpression, IntervalSeconds = t.IntervalSeconds,
                    DaysOfWeekCsv = t.DaysOfWeekCsv, ExcludeWeekends = t.ExcludeWeekends, ExcludeHolidays = t.ExcludeHolidays,
                    HolidayDatesCsv = t.HolidayDatesCsv, WindowStart = t.WindowStart, WindowEnd = t.WindowEnd,
                    FolderPath = t.FolderPath, FolderFilter = t.FolderFilter, FolderWatchEvent = t.FolderWatchEvent,
                    WebhookToken = t.WebhookToken
                });
            }

            existing.Dependencies.Clear();
            foreach (var d in _job.Dependencies)
            {
                existing.Dependencies.Add(new JobDependency
                {
                    DependsOnJobId = d.DependsOnJobId, Condition = d.Condition
                });
            }

            existing.NotificationRules.Clear();
            foreach (var n in _job.NotificationRules)
            {
                existing.NotificationRules.Add(new NotificationRule
                {
                    Event = n.Event, Channel = n.Channel, RecipientsCsv = n.RecipientsCsv, WebhookUrl = n.WebhookUrl, Enabled = n.Enabled
                });
            }

            await db.SaveChangesAsync();
            await Audit.LogAsync(AuditAction.Modification, nameof(Job), existing.Id.ToString(), existing.Name, null, _currentUser);
            _job = existing;
        }

        Nav.NavigateTo("jobs");
    }
}
