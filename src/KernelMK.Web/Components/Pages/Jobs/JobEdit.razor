    private void OnCredentialChanged(JobStep step, string? credIdStr)
    {
        if (Guid.TryParse(credIdStr, out var id))
        {
            step.CredentialId = id;
            if (IsTransferStep(step.Type))
            {
                var cred = _credentials.FirstOrDefault(c => c.Id == id);
                if (cred is not null)
                {
                    var config = GetOrCreateTransferConfig(step);
                    if (!string.IsNullOrWhiteSpace(cred.Host))
                    {
                        config.Host = cred.Host;
                    }
                    if (cred.Port is > 0)
                    {
                        config.Port = cred.Port.Value;
                    }

                    // Détection intelligente GUCE / FTPS
                    if (cred.Name.Contains("guce", StringComparison.OrdinalIgnoreCase) ||
                        (cred.Host?.Contains("guce", StringComparison.OrdinalIgnoreCase) ?? false))
                    {
                        config.UseTls = true;
                        step.Type = StepType.TransfertFtps;
                        if (string.IsNullOrWhiteSpace(config.Armateur))
                        {
                            config.Armateur = "GUCE";
                        }
                    }
                    else if (cred.Port == 22)
                    {
                        config.UseTls = false;
                        step.Type = StepType.TransfertSftp;
                    }

                    SyncTransferConfig(step);
                }
            }
            else if (IsEmailStep(step.Type))
            {
                var cred = _credentials.FirstOrDefault(c => c.Id == id);
                if (cred is not null)
                {
                    var config = GetOrCreateEmailConfig(step);
                    if (!string.IsNullOrWhiteSpace(cred.Host)) config.SmtpHost = cred.Host;
                    if (cred.Port is > 0) config.SmtpPort = cred.Port.Value;
                    SyncEmailConfig(step);
                }
            }
        }
        else
        {
            step.CredentialId = null;
        }
    }

    private void OnStepTypeChanged(JobStep step, string? typeStr)
    {
        if (Enum.TryParse<StepType>(typeStr, out var newType))
        {
            step.Type = newType;
            if (IsTransferStep(newType))
            {
                var config = GetOrCreateTransferConfig(step);
                if (newType == StepType.TransfertSftp && (config.Port <= 0 || config.Port == 21)) config.Port = 22;
                if ((newType == StepType.TransfertFtp || newType == StepType.TransfertFtps) && (config.Port <= 0 || config.Port == 22)) config.Port = 21;
                if (newType == StepType.TransfertFtps) config.UseTls = true;
                if (newType == StepType.TransfertFtp) config.UseTls = false;
                SyncTransferConfig(step);
            }
        }
    }

    private async Task TestStepConnectionAsync(JobStep step)
    {
        if (_isTesting.GetValueOrDefault(step)) return;
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        if (!(await Authorization.AuthorizeAsync(user, "ApplicationAccess")).Succeeded ||
            !(user.IsInRole("Administrateur") || user.IsInRole("Developpeur")))
        {
            _testResults[step] = ConnectionTestResult.Fail("Votre rôle ne permet plus de tester cette connexion.");
            return;
        }
        if (step.CredentialId is { } credentialId)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var credential = await db.Credentials.AsNoTracking().FirstOrDefaultAsync(c => c.Id == credentialId);
            if (credential is null || !CredentialAccess.CanUse(user, credential))
            {
                _testResults[step] = ConnectionTestResult.Fail("Cet identifiant n'est plus disponible pour votre rôle.");
                return;
            }
            _credentials.RemoveAll(c => c.Id == credentialId);
            _credentials.Add(credential);
        }
        _isTesting[step] = true;
        _testResults[step] = null;
        StateHasChanged();

        var config = GetOrCreateTransferConfig(step);
        string? username = null;
        string? secret = null;
        var authType = CredentialAuthType.MotDePasse;
        string? passphrase = null;

        if (step.CredentialId is not null)
        {
            var cred = _credentials.FirstOrDefault(c => c.Id == step.CredentialId.Value);
            if (cred is not null)
            {
                username = cred.Username;
                authType = cred.AuthType;
                try
                {
                    secret = Protector.Unprotect(cred.EncryptedSecret);
                    passphrase = string.IsNullOrEmpty(cred.EncryptedPassphrase) ? null : Protector.Unprotect(cred.EncryptedPassphrase);
                }
                catch
                {
                    secret = null;
                }

                if (string.IsNullOrWhiteSpace(config.Host) && !string.IsNullOrWhiteSpace(cred.Host))
                {
                    config.Host = cred.Host;
                }
                if (config.Port <= 0 && cred.Port is > 0)
                {
                    config.Port = cred.Port.Value;
                }
            }
        }

        var host = !string.IsNullOrWhiteSpace(config.Host)
            ? config.Host
            : (step.CredentialId != null ? _credentials.FirstOrDefault(c => c.Id == step.CredentialId)?.Host ?? "" : "");

        var defaultPort = step.Type == StepType.TransfertSftp ? 22 : 21;
        var port = config.Port > 0 ? config.Port : defaultPort;

        var isTls = config.UseTls || step.Type == StepType.TransfertFtps;
        var effectiveType = (step.Type == StepType.TransfertFtp && isTls)
            ? StepType.TransfertFtps
            : step.Type;

        if (string.IsNullOrWhiteSpace(host))
        {
            _testResults[step] = ConnectionTestResult.Fail("L'adresse de l'hôte distant (nom ou IP) est obligatoire. Renseignez le champ 'Hôte / Serveur distant' ou sélectionnez un Credential.");
            _isTesting[step] = false;
            StateHasChanged();
            return;
        }

        if (isTls && port == 22)
        {
            _testResults[step] = ConnectionTestResult.Fail($"Erreur de port ({host}:22) : Le port 22 est réservé au protocole SFTP (SSH). Pour tester en FTPS (TLS/SSL explicite comme GUCE), veuillez renseigner le port du serveur (21 ou 990) dans le champ 'Port'.");
            _isTesting[step] = false;
            StateHasChanged();
            return;
        }

        _testResults[step] = await TestService.TestConnectionAsync(
            effectiveType,
            host,
            port,
            username,
            secret,
            config.RemotePath,
            useTls: isTls,
            authType: authType,
            passphrase: passphrase);

        _isTesting[step] = false;
        StateHasChanged();
    }

