                                                    </label>
                                                }
                                            </div>

                                            @if (hints.ShowArchive)
                                            {
                                                <div class="col-span-1 sm:col-span-2 md:col-span-4">
                                                    <label class="kmk-label">
                                                        Dossier d'archive
                                                        <span class="text-slate-400 font-normal text-[11px]">(facultatif — dépose une copie de sécurité en plus de l'opération, peut être sur un autre lecteur)</span>
                                                    </label>
                                                    <input class="kmk-input font-mono text-xs" placeholder="ex: E:\Archives\ (laisser vide pour ne rien archiver)"
                                                           value="@fConfig.ArchiveDirectory"
                                                           @oninput="(e) => { fConfig.ArchiveDirectory = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value?.ToString(); SyncFileOpConfig(step); }" />
                                                </div>
                                            }

                                            @if (hints.DestinationLabel is not null)
                                            {
                                                <div class="col-span-1 sm:col-span-2">
                                                    <label class="kmk-label">
                                                        Armateur / Partenaire
                                                        <span class="text-slate-400 font-normal text-[11px]">(facultatif — fait remonter cette étape dans le Rapport des flux et la Cartographie EDI)</span>
                                                    </label>
                                                    <input class="kmk-input text-xs" placeholder="ex: MSC, MAERSK... (déduit du nom si vide)"
                                                           value="@fConfig.Armateur"
                                                           @oninput="(e) => { fConfig.Armateur = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value?.ToString(); SyncFileOpConfig(step); }" />
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else if (IsEmailStep(step.Type))
                            {
                                var eConfig = GetOrCreateEmailConfig(step);
                                <div class="col-span-2 sm:col-span-4 md:col-span-6 bg-slate-50/90 border border-slate-200/90 rounded-xl p-4 mt-2">
                                    <div class="flex items-center justify-between mb-3 border-b border-slate-200/60 pb-2">
                                        <span class="text-xs font-bold uppercase tracking-wider text-slate-700">Paramètres email (SMTP)</span>
                                        <button type="button" class="kmk-btn-secondary kmk-btn-sm text-xs" @onclick="() => ToggleRawJson(step)">
                                            @(IsRawJsonMode(step) ? "Afficher le formulaire" : "Mode JSON brut")
                                        </button>
                                    </div>

                                    @if (IsRawJsonMode(step))
                                    {
                                        <div class="space-y-1">
                                            <label class="kmk-label">Configuration (JSON brut)</label>
                                            <textarea class="kmk-input font-mono text-xs" rows="4" @bind="step.ConfigJson"></textarea>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
                                            <div class="col-span-1 sm:col-span-3">
                                                <label class="kmk-label">Serveur SMTP</label>
                                                <input class="kmk-input font-mono text-xs" placeholder="ex: smtp.office365.com"
                                                       value="@eConfig.SmtpHost"
                                                       @oninput="(e) => { eConfig.SmtpHost = e.Value?.ToString() ?? string.Empty; SyncEmailConfig(step); }" />
                                            </div>
                                            <div>
                                                <label class="kmk-label">Port</label>
                                                <input type="number" class="kmk-input" placeholder="587"
                                                       value="@eConfig.SmtpPort"
                                                       @oninput="(e) => { if (int.TryParse(e.Value?.ToString(), out var p)) eConfig.SmtpPort = p; SyncEmailConfig(step); }" />
                                            </div>

                                            <div class="col-span-1 sm:col-span-2">
                                                <label class="kmk-label">Expéditeur (From)</label>
                                                <input class="kmk-input text-xs" placeholder="jobs@exemple.fr"
                                                       value="@eConfig.From"
                                                       @oninput="(e) => { eConfig.From = e.Value?.ToString() ?? string.Empty; SyncEmailConfig(step); }" />
                                            </div>
                                            <div class="col-span-1 sm:col-span-2">
                                                <label class="kmk-label">Destinataire(s)</label>
                                                <input class="kmk-input text-xs" placeholder="support@exemple.fr, autre@exemple.fr"
                                                       value="@eConfig.ToCsv"
                                                       @oninput="(e) => { eConfig.ToCsv = e.Value?.ToString() ?? string.Empty; SyncEmailConfig(step); }" />
                                            </div>

                                            <div class="col-span-1 sm:col-span-2 md:col-span-4">
                                                <label class="kmk-label">Objet</label>
                                                <input class="kmk-input text-xs" placeholder="Notification"
                                                       value="@eConfig.Subject"
                                                       @oninput="(e) => { eConfig.Subject = e.Value?.ToString() ?? string.Empty; SyncEmailConfig(step); }" />
                                            </div>
                                            <div class="col-span-1 sm:col-span-2 md:col-span-4">
                                                <label class="kmk-label">Message</label>
                                                <textarea class="kmk-input text-xs" rows="3" placeholder="Traitement terminé."
                                                          @oninput="(e) => { eConfig.Body = e.Value?.ToString() ?? string.Empty; SyncEmailConfig(step); }">@eConfig.Body</textarea>
                                            </div>

                                            <div class="col-span-1 sm:col-span-2">
                                                <label class="kmk-label">Pièce jointe <span class="text-slate-400 font-normal text-[11px]">(facultatif)</span></label>
                                                <input class="kmk-input font-mono text-xs" placeholder="ex: C:\rapports\bilan.csv"
                                                       value="@eConfig.AttachmentPath"
                                                       @oninput="(e) => { eConfig.AttachmentPath = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value?.ToString(); SyncEmailConfig(step); }" />
                                            </div>
                                            <div class="col-span-1 sm:col-span-2 flex items-end pb-1">
                                                <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer">
                                                    <input type="checkbox" class="kmk-checkbox" checked="@eConfig.UseTls"
                                                           @onchange="(e) => { eConfig.UseTls = (bool)(e.Value ?? false); SyncEmailConfig(step); }" />
                                                    <span class="font-semibold text-slate-800">Chiffrement TLS (recommandé)</span>
                                                </label>
                                            </div>
                                            <div class="col-span-1 sm:col-span-2">
                                                <label class="kmk-label">Armateur / partenaire <span class="text-slate-400 font-normal text-[11px]">(facultatif)</span></label>
                                                <input class="kmk-input text-xs" placeholder="ex: MSC, CMA CGM, MAERSK..."
                                                       value="@eConfig.Armateur"
                                                       @oninput="(e) => { eConfig.Armateur = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value?.ToString(); SyncEmailConfig(step); }" />
                                                <p class="text-[11px] text-slate-400 mt-1">Fait apparaître cet envoi (canal SMTP) dans la Cartographie EDI.</p>
                                            </div>
                                        </div>

                                        <p class="text-[11px] text-slate-400 mt-3 pt-2 border-t border-slate-200/60">
                                            Le credential sélectionné ci-dessus fournit l'utilisateur/mot de passe d'authentification SMTP — le serveur et le port doivent être renseignés ici.
                                        </p>
                                    }
                                </div>
                            }
                            else if (IsEmailReceptionStep(step.Type))
                            {
                                var rConfig = GetOrCreateEmailReceptionConfig(step);
                                <div class="col-span-2 sm:col-span-4 md:col-span-6 bg-slate-50/90 border border-slate-200/90 rounded-xl p-4 mt-2">
                                    <div class="flex items-center justify-between mb-3 border-b border-slate-200/60 pb-2">
                                        <span class="text-xs font-bold uppercase tracking-wider text-slate-700">Paramètres réception email (IMAP)</span>
                                        <button type="button" class="kmk-btn-secondary kmk-btn-sm text-xs" @onclick="() => ToggleRawJson(step)">
                                            @(IsRawJsonMode(step) ? "Afficher le formulaire" : "Mode JSON brut")
                                        </button>
                                    </div>

                                    @if (IsRawJsonMode(step))
                                    {
                                        <div class="space-y-1">
                                            <label class="kmk-label">Configuration (JSON brut)</label>
                                            <textarea class="kmk-input font-mono text-xs" rows="4" @bind="step.ConfigJson"></textarea>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
                                            <div class="col-span-1 sm:col-span-2">
                                                <label class="kmk-label">Dossier de la boîte mail</label>
                                                <input class="kmk-input font-mono text-xs" placeholder="INBOX"
                                                       value="@rConfig.MailboxFolder"
                                                       @oninput="(e) => { rConfig.MailboxFolder = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? DefaultMailboxFolder : e.Value!.ToString()!; SyncEmailReceptionConfig(step); }" />
                                            </div>
                                            <div class="col-span-1 sm:col-span-2">
                                                <label class="kmk-label">Nombre max de messages / exécution</label>
                                                <input type="number" class="kmk-input" placeholder="50"
                                                       value="@rConfig.MaxMessagesPerRun"
                                                       @oninput="(e) => { if (int.TryParse(e.Value?.ToString(), out var n)) rConfig.MaxMessagesPerRun = n; SyncEmailReceptionConfig(step); }" />
                                            </div>

                                            <div class="col-span-1 sm:col-span-2">
                                                <label class="kmk-label">Filtre expéditeur <span class="text-slate-400 font-normal text-[11px]">(facultatif)</span></label>
                                                <input class="kmk-input text-xs" placeholder="ex: guce.gouv.ci"
                                                       value="@rConfig.SenderFilter"
                                                       @oninput="(e) => { rConfig.SenderFilter = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value?.ToString(); SyncEmailReceptionConfig(step); }" />
                                            </div>
                                            <div class="col-span-1 sm:col-span-2">
                                                <label class="kmk-label">Filtre objet <span class="text-slate-400 font-normal text-[11px]">(facultatif)</span></label>
                                                <input class="kmk-input text-xs" placeholder="ex: EDI"
                                                       value="@rConfig.SubjectFilter"
                                                       @oninput="(e) => { rConfig.SubjectFilter = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value?.ToString(); SyncEmailReceptionConfig(step); }" />
                                            </div>

                                            <div class="col-span-1 sm:col-span-2">
                                                <label class="kmk-label">Extensions de pièces jointes à récupérer</label>
                                                <input class="kmk-input font-mono text-xs" placeholder=".edi;.txt;.xml"
                                                       value="@rConfig.AttachmentExtensionsCsv"
                                                       @oninput="(e) => { rConfig.AttachmentExtensionsCsv = e.Value?.ToString(); SyncEmailReceptionConfig(step); }" />
                                            </div>
                                            <div class="col-span-1 sm:col-span-2">
                                                <label class="kmk-label">Dossier local de dépôt</label>
                                                <input class="kmk-input font-mono text-xs" placeholder="ex: C:\edi\entrants\"
                                                       value="@rConfig.DownloadPath"
                                                       @oninput="(e) => { rConfig.DownloadPath = e.Value?.ToString() ?? string.Empty; SyncEmailReceptionConfig(step); }" />
                                            </div>

                                            <div class="col-span-1 sm:col-span-2 flex items-end pb-1">
                                                <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer">
                                                    <input type="checkbox" class="kmk-checkbox" checked="@rConfig.MarkAsReadAfterDownload"
                                                           @onchange="(e) => { rConfig.MarkAsReadAfterDownload = (bool)(e.Value ?? false); SyncEmailReceptionConfig(step); }" />
                                                    <span class="font-semibold text-slate-800">Marquer comme lu après téléchargement</span>
                                                </label>
                                            </div>
                                            <div class="col-span-1 sm:col-span-2 flex items-end pb-1">
                                                <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer">
                                                    <input type="checkbox" class="kmk-checkbox" checked="@rConfig.DeleteAfterDownload"
                                                           @onchange="(e) => { rConfig.DeleteAfterDownload = (bool)(e.Value ?? false); SyncEmailReceptionConfig(step); }" />
                                                    <span class="font-semibold text-slate-800">Supprimer l'email après téléchargement</span>
                                                </label>
                                            </div>
                                            <div class="col-span-1 sm:col-span-2">
                                                <label class="kmk-label">Armateur / partenaire <span class="text-slate-400 font-normal text-[11px]">(facultatif)</span></label>
                                                <input class="kmk-input text-xs" placeholder="ex: MSC, CMA CGM, MAERSK..."
                                                       value="@rConfig.Armateur"
                                                       @oninput="(e) => { rConfig.Armateur = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value?.ToString(); SyncEmailReceptionConfig(step); }" />
                                                <p class="text-[11px] text-slate-400 mt-1">Fait apparaître cette relève (canal SMTP) dans la Cartographie EDI.</p>
                                            </div>
                                        </div>

                                        <p class="text-[11px] text-slate-400 mt-3 pt-2 border-t border-slate-200/60">
                                            Le credential sélectionné ci-dessus (type "Email IMAP") fournit l'hôte, le port et les identifiants de connexion — seuls les filtres et le dépôt sont à renseigner ici.
                                        </p>
                                    }
                                </div>
                            }
                            else if (IsRobotStep(step.Type))
                            {
                                var rbConfig = GetOrCreateRobotConfig(step);
                                <div class="col-span-2 sm:col-span-4 md:col-span-6 bg-slate-50/90 border border-slate-200/90 rounded-xl p-4 mt-2">
                                    <div class="flex items-center justify-between mb-3 border-b border-slate-200/60 pb-2">
                                        <span class="text-xs font-bold uppercase tracking-wider text-slate-700">Paramètres RPA (Robot Framework)</span>
                                        <button type="button" class="kmk-btn-secondary kmk-btn-sm text-xs" @onclick="() => ToggleRawJson(step)">
                                            @(IsRawJsonMode(step) ? "Afficher le formulaire" : "Mode JSON brut")
                                        </button>
                                    </div>

                                    @if (IsRawJsonMode(step))
                                    {
                                        <div class="space-y-1">
                                            <label class="kmk-label">Configuration (JSON brut)</label>
                                            <textarea class="kmk-input font-mono text-xs" rows="4" @bind="step.ConfigJson"></textarea>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
                                            <div class="col-span-1 sm:col-span-3">
                                                <label class="kmk-label">Fichier .robot à exécuter</label>
                                                <input class="kmk-input font-mono text-xs" placeholder="ex: C:\rpa\saisie_guce.robot"
                                                       value="@rbConfig.RobotFilePath"
                                                       @oninput="(e) => { rbConfig.RobotFilePath = e.Value?.ToString() ?? string.Empty; SyncRobotConfig(step); }" />
                                            </div>
                                            <div>
                                                <label class="kmk-label">Exécutable "robot" <span class="text-slate-400 font-normal text-[11px]">(facultatif)</span></label>
                                                <input class="kmk-input font-mono text-xs" placeholder="robot"
                                                       value="@rbConfig.RobotExecutablePath"
                                                       @oninput="(e) => { rbConfig.RobotExecutablePath = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value?.ToString(); SyncRobotConfig(step); }" />
                                            </div>

                                            <div class="col-span-1 sm:col-span-2">
                                                <label class="kmk-label">Dossier de sortie (rapports) <span class="text-slate-400 font-normal text-[11px]">(facultatif)</span></label>
                                                <input class="kmk-input font-mono text-xs" placeholder="ex: C:\rpa\rapports\"
                                                       value="@rbConfig.OutputDirectory"
                                                       @oninput="(e) => { rbConfig.OutputDirectory = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value?.ToString(); SyncRobotConfig(step); }" />
                                            </div>
                                            <div class="col-span-1">
                                                <label class="kmk-label">Tags à inclure <span class="text-slate-400 font-normal text-[11px]">(facultatif)</span></label>
                                                <input class="kmk-input text-xs" placeholder="ex: smoke;critique"
                                                       value="@rbConfig.IncludeTagsCsv"
                                                       @oninput="(e) => { rbConfig.IncludeTagsCsv = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value?.ToString(); SyncRobotConfig(step); }" />
                                            </div>
                                            <div class="col-span-1">
                                                <label class="kmk-label">Tags à exclure <span class="text-slate-400 font-normal text-[11px]">(facultatif)</span></label>
                                                <input class="kmk-input text-xs" placeholder="ex: manuel"
                                                       value="@rbConfig.ExcludeTagsCsv"
                                                       @oninput="(e) => { rbConfig.ExcludeTagsCsv = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value?.ToString(); SyncRobotConfig(step); }" />
                                            </div>

                                            <div class="col-span-1 sm:col-span-2 md:col-span-4">
                                                <label class="kmk-label">Variables Robot Framework <span class="text-slate-400 font-normal text-[11px]">(une par ligne, format NOM:valeur)</span></label>
                                                <textarea class="kmk-input font-mono text-xs" rows="3" placeholder="URL_PORTAIL:https://guce.gouv.ci&#10;UTILISATEUR:hdl-cit"
                                                          @oninput="(e) => { rbConfig.VariablesText = e.Value?.ToString(); SyncRobotConfig(step); }">@rbConfig.VariablesText</textarea>
                                            </div>
                                            <div class="col-span-1 sm:col-span-2 md:col-span-4">
                                                <label class="kmk-label">Arguments supplémentaires <span class="text-slate-400 font-normal text-[11px]">(facultatif, utilisateurs avancés)</span></label>
                                                <input class="kmk-input font-mono text-xs" placeholder="ex: --loglevel DEBUG"
                                                       value="@rbConfig.ExtraArguments"
                                                       @oninput="(e) => { rbConfig.ExtraArguments = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value?.ToString(); SyncRobotConfig(step); }" />
                                            </div>
                                        </div>

                                        <p class="text-[11px] text-slate-400 mt-3 pt-2 border-t border-slate-200/60">
                                            Le fichier .robot lui-même doit être écrit au préalable avec un éditeur externe (RIDE, VS Code + extension Robot Framework...). kernelMK nécessite Python et le paquet
                                            <code class="font-mono">robotframework</code> installés sur ce serveur (<code class="font-mono">pip install robotframework</code>) pour pouvoir lancer la commande "robot".
                                        </p>
                                    }
                                </div>
                            }
                            else if (IsSqlStep(step.Type))
                            {
                                var sqlConfig = GetOrCreateSqlConfig(step);
                                <div class="col-span-2 sm:col-span-4 md:col-span-6 bg-slate-50/90 border border-slate-200/90 rounded-xl p-4 mt-2">
                                    <div class="flex items-center justify-between mb-3 border-b border-slate-200/60 pb-2">
                                        <span class="text-xs font-bold uppercase tracking-wider text-slate-700">Paramètres Base de données</span>
                                        <button type="button" class="kmk-btn-secondary kmk-btn-sm text-xs" @onclick="() => ToggleRawJson(step)">
                                            @(IsRawJsonMode(step) ? "Afficher le formulaire" : "Mode JSON brut")
                                        </button>
                                    </div>

                                    @if (IsRawJsonMode(step))
                                    {
                                        <div class="space-y-1">
                                            <label class="kmk-label">Configuration (JSON brut)</label>
                                            <textarea class="kmk-input font-mono text-xs" rows="4" @bind="step.ConfigJson"></textarea>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
                                            <div>
                                                <label class="kmk-label">Fournisseur</label>
                                                <select class="kmk-select" value="@sqlConfig.Provider"
                                                        @onchange='(e) => { sqlConfig.Provider = e.Value?.ToString() ?? "Sqlite"; SyncSqlConfig(step); }'>
                                                    <option value="Sqlite">Sqlite</option>
                                                    <option value="SqlServer">SqlServer</option>
                                                </select>
                                            </div>
                                            <div class="col-span-1 sm:col-span-2 flex items-end pb-1">
                                                <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer">
                                                    <input type="checkbox" class="kmk-checkbox" checked="@sqlConfig.IsStoredProcedure"
                                                           @onchange="(e) => { sqlConfig.IsStoredProcedure = (bool)(e.Value ?? false); SyncSqlConfig(step); }" />
                                                    <span class="font-semibold text-slate-800">Procédure stockée</span>
                                                </label>
                                            </div>
                                            <div>
                                                <label class="kmk-label">Timeout requête (s)</label>
                                                <input type="number" class="kmk-input" placeholder="300"
                                                       value="@sqlConfig.CommandTimeoutSeconds"
                                                       @oninput="(e) => { if (int.TryParse(e.Value?.ToString(), out var t)) sqlConfig.CommandTimeoutSeconds = t; SyncSqlConfig(step); }" />
                                            </div>

                                            @if (sqlConfig.Provider == "SqlServer" && step.CredentialId is not null)
                                            {
                                                <div class="col-span-1 sm:col-span-2 md:col-span-4">
                                                    <label class="kmk-label">Nom de la base</label>
                                                    <input class="kmk-input text-xs" placeholder="ex: KernelMK_EDI"
                                                           value="@sqlConfig.Database"
                                                           @oninput="(e) => { sqlConfig.Database = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value?.ToString(); SyncSqlConfig(step); }" />
                                                    <p class="text-[11px] text-slate-400 mt-1">Le credential sélectionné ci-dessus (type "Base de données") fournit l'hôte, le port et les identifiants — seul le nom de la base est à renseigner ici.</p>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="col-span-1 sm:col-span-2 md:col-span-4">
                                                    <label class="kmk-label">
                                                        Chaîne de connexion
                                                        @if (sqlConfig.Provider == "SqlServer")
                                                        {
                                                            <span class="text-slate-400 font-normal text-[11px]">(ou sélectionnez un credential "Base de données" ci-dessus pour éviter d'écrire le mot de passe ici)</span>
                                                        }
                                                    </label>
                                                    <input class="kmk-input font-mono text-xs" placeholder="@(sqlConfig.Provider == "SqlServer" ? "Server=...;Database=...;User Id=...;Password=...;" : "Data Source=chemin/vers/base.db")"
                                                           value="@sqlConfig.ConnectionString"
                                                           @oninput="(e) => { sqlConfig.ConnectionString = e.Value?.ToString() ?? string.Empty; SyncSqlConfig(step); }" />
                                                </div>
                                            }

                                            <div class="col-span-1 sm:col-span-2 md:col-span-4">
                                                <label class="kmk-label">Requête / commande SQL</label>
                                                <textarea class="kmk-input font-mono text-xs" rows="4" placeholder="SELECT * FROM ma_table WHERE ...;"
                                                          @oninput="(e) => { sqlConfig.CommandText = e.Value?.ToString() ?? string.Empty; SyncSqlConfig(step); }">@sqlConfig.CommandText</textarea>
                                            </div>
                                        </div>

                                        <p class="text-[11px] text-slate-400 mt-3 pt-2 border-t border-slate-200/60">
                                            Un SELECT affiche un aperçu des lignes retournées (jusqu'à 50) dans le diagnostic de l'étape ; toute autre commande (INSERT/UPDATE/DELETE/procédure) affiche le nombre de lignes affectées.
                                        </p>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="col-span-2 sm:col-span-4 md:col-span-6">
                                    <label class="kmk-label">Configuration (JSON)</label>
                                    <textarea class="kmk-input font-mono text-xs" rows="4" @bind="step.ConfigJson"></textarea>
                                </div>
                            }
                            <div class="col-span-2 sm:col-span-4 md:col-span-6 text-right">
                                <button type="button" class="kmk-btn-danger kmk-btn-sm" @onclick="() => RemoveStep(step)">Supprimer l'étape</button>
                            </div>
                        </div>
                    </div>
                }
                @if (_job.Steps.Count == 0)
                {
                    <p class="text-sm text-slate-400">Aucune étape définie.</p>
                }
            </div>
        </div>

        <div class="kmk-card mb-5">
            <div class="kmk-card-header">
                <span>Déclencheurs</span>
                <button type="button" class="kmk-btn-primary kmk-btn-sm" @onclick="AddTrigger">+ Ajouter un déclencheur</button>
            </div>
            <div class="kmk-card-body space-y-4">
                @foreach (var trigger in _job.Triggers)
                {
                    <div class="border border-slate-200 rounded-lg p-4">
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                            <div>
                                <label class="kmk-label">Type</label>
                                <select class="kmk-select" @bind="trigger.Type">
                                    @foreach (var t in TriggerTypeChoices)
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </select>
                            </div>
                            <div class="flex items-end pb-2">
                                <label class="flex items-center gap-2 text-sm text-slate-700">
                                    <input type="checkbox" class="kmk-checkbox" @bind="trigger.Enabled" />
                                    Actif
                                </label>
                            </div>

                            @if (trigger.Type is TriggerType.Horaire or TriggerType.Cron)
                            {
                                <div>
                                    <label class="kmk-label">Intervalle (secondes)</label>
                                    <input type="number" class="kmk-input" placeholder="3600" @bind="trigger.IntervalSeconds" />
                                    <p class="text-[11px] text-slate-500 mt-1">Ex: 3600 (1h), 900 (15 min), 300 (5 min)</p>
                                </div>
                                <div class="col-span-2">
                                    <label class="kmk-label">Ou Expression Cron (6 champs)</label>
                                    <input class="kmk-input font-mono text-xs" placeholder="0 0 22 * * *" @bind="trigger.CronExpression" />
                                    <p class="text-[11px] text-slate-500 mt-1">Ex: <code>0 0 22 * * *</code> (22h00), <code>0 */15 * * * *</code> (toutes les 15 min)</p>
                                </div>
                            }
                            else if (trigger.Type == TriggerType.Calendrier)
                            {
                                <div>
                                    <label class="kmk-label">Jours (Mon,Tue,...)</label>
                                    <input class="kmk-input" placeholder="Mon,Tue,Wed,Thu,Fri" @bind="trigger.DaysOfWeekCsv" />
                                    <p class="text-[11px] text-slate-500 mt-1">Ex: Mon,Tue,Wed,Thu,Fri</p>
                                </div>
                                <div>
                                    <label class="kmk-label">Heure d'exécution</label>
                                    <input type="time" class="kmk-input" value="@WindowStartString(trigger)" @onchange="e => SetWindowStart(trigger, e.Value?.ToString())" />
                                    <p class="text-[11px] text-slate-500 mt-1">Heure fixe du lancement</p>
                                </div>
                                <div class="flex items-end pb-2">
                                    <label class="flex items-center gap-2 text-sm text-slate-700">
                                        <input type="checkbox" class="kmk-checkbox" @bind="trigger.ExcludeWeekends" />
                                        Exclure week-ends
                                    </label>
                                </div>
                                <div class="flex items-end pb-2">
                                    <label class="flex items-center gap-2 text-sm text-slate-700">
                                        <input type="checkbox" class="kmk-checkbox" @bind="trigger.ExcludeHolidays" />
                                        Exclure jours fériés
                                    </label>
                                </div>
                                <div class="col-span-2 sm:col-span-4">
                                    <label class="kmk-label">Jours fériés (yyyy-MM-dd,...)</label>
                                    <input class="kmk-input" placeholder="2026-01-01, 2026-05-01, 2026-08-07" @bind="trigger.HolidayDatesCsv" />
                                    <p class="text-[11px] text-slate-500 mt-1">Dates au format AAAA-MM-JJ séparées par des virgules</p>
                                </div>
                            }
                            else if (trigger.Type == TriggerType.EvenementDossier)
                            {
                                <div class="col-span-2">
                                    <label class="kmk-label">Dossier surveillé (File Watcher)</label>
                                    <input class="kmk-input font-mono text-xs" placeholder="K:\EDI\GUCE\OUT\ ou C:\SFTP\Outbox" @bind="trigger.FolderPath" />
                                    <p class="text-[11px] text-slate-500 mt-1">Chemin absolu du dossier local ou réseau partagé</p>
                                </div>
                                <div>
                                    <label class="kmk-label">Filtre fichiers</label>
                                    <input class="kmk-input font-mono text-xs" placeholder="*.edi ou *.xml" @bind="trigger.FolderFilter" />
                                    <p class="text-[11px] text-slate-500 mt-1">Ex: *.edi, *.xml, *.csv, *.*</p>
                                </div>
                                <div>
                                    <label class="kmk-label">Événement</label>
                                    <select class="kmk-select" @bind="trigger.FolderWatchEvent">
                                        @foreach (var ev in Enum.GetValues<FolderWatchEventType>())
                                        {
                                            <option value="@ev">@ev</option>
                                        }
                                    </select>
                                    <p class="text-[11px] text-slate-500 mt-1">Arrivée = dès qu'un fichier est prêt</p>
                                </div>
                            }
                            else if (trigger.Type == TriggerType.Api)
                            {
                                <div class="col-span-3">
                                    <label class="kmk-label">Jeton d'authentification API (Webhook)</label>
                                    <div class="flex gap-2">
                                        <input class="kmk-input font-mono text-xs" readonly placeholder="Clique sur « Générer » pour créer un jeton sécurisé" value="@trigger.WebhookToken" />
                                        <button type="button" class="kmk-btn-secondary kmk-btn-sm whitespace-nowrap" @onclick="() => GenerateWebhookToken(trigger)">🔑 Générer</button>
                                    </div>
                                    <p class="text-[11px] text-slate-500 mt-1">URL de déclenchement : <code>POST http://[serveur]:5000/api/triggers/@(string.IsNullOrWhiteSpace(trigger.WebhookToken) ? "{jeton}" : trigger.WebhookToken)</code></p>
                                    <p class="text-[11px] text-amber-600 mt-1">⚠️ Ce jeton donne le droit de déclencher ce job à distance sans authentification supplémentaire. Ne le partage que via un canal sécurisé.</p>
                                </div>
                            }

                            <div class="col-span-2 sm:col-span-4 text-right">
                                <button type="button" class="kmk-btn-danger kmk-btn-sm" @onclick="() => _job.Triggers.Remove(trigger)">Supprimer le déclencheur</button>
                            </div>
                        </div>
                    </div>
                }
                @if (_job.Triggers.Count == 0)
                {
                    <p class="text-sm text-slate-400">Aucun déclencheur défini (exécution manuelle uniquement).</p>
                }
            </div>
        </div>

        <div class="kmk-card mb-5">
            <div class="kmk-card-header">
                <span>Dépendances (chaînage de jobs)</span>
                <button type="button" class="kmk-btn-primary kmk-btn-sm" @onclick="AddDependency">+ Ajouter une dépendance</button>
            </div>
            <div class="kmk-card-body space-y-2">
                @foreach (var dep in _job.Dependencies)
                {
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                        <select class="kmk-select sm:col-span-1" @bind="dep.DependsOnJobId">
                            @foreach (var j in _otherJobs)
                            {
                                <option value="@j.Id">@j.Name</option>
                            }
                        </select>
                        <select class="kmk-select" @bind="dep.Condition">
                            @foreach (var c in Enum.GetValues<JobDependencyCondition>())
                            {
                                <option value="@c">@c</option>
                            }
                        </select>
                        <button type="button" class="kmk-btn-danger kmk-btn-sm justify-self-start" @onclick="() => _job.Dependencies.Remove(dep)">Supprimer</button>
                    </div>
                }
                @if (_job.Dependencies.Count == 0)
                {
                    <p class="text-sm text-slate-400">Ce job ne dépend d'aucun autre job.</p>
                }
            </div>
        </div>

        <div class="kmk-card mb-5">
            <div class="kmk-card-header flex justify-between items-center">
                <div class="flex items-center gap-2">
                    <svg class="h-5 w-5 text-brand-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" /></svg>
                    <span>Règles de Notifications & Alertes</span>
                </div>
                <button type="button" class="kmk-btn-primary kmk-btn-sm flex items-center gap-1.5" @onclick="AddNotificationRule">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                    <span>+ Ajouter une règle</span>
                </button>
            </div>
            <div class="kmk-card-body space-y-4">
                @foreach (var rule in _job.NotificationRules)
                {
                    var testState = _ruleTestStates.GetValueOrDefault(rule.Id, (false, null, null));
                    <div class="border border-slate-200 rounded-lg p-4 bg-slate-50/50 hover:bg-slate-50 transition-colors">
                        <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-end">
                            <div class="sm:col-span-3">
                                <label class="kmk-label">Événement déclencheur</label>
                                <select class="kmk-select text-xs font-semibold" @bind="rule.Event">
                                    @foreach (var ev in Enum.GetValues<NotificationEvent>())
                                    {
                                        <option value="@ev">@ev</option>
                                    }
                                </select>
                            </div>

                            <div class="sm:col-span-2">
                                <label class="kmk-label">Canal</label>
                                <select class="kmk-select text-xs font-semibold" @bind="rule.Channel">
                                    @foreach (var ch in Enum.GetValues<NotificationChannel>())
                                    {
                                        <option value="@ch">@ch</option>
                                    }
                                </select>
                            </div>

                            <div class="sm:col-span-4">
                                @if (rule.Channel == NotificationChannel.Email)
                                {
                                    <label class="kmk-label">Destinataires e-mails (séparés par virgule)</label>
                                    <input class="kmk-input text-xs" placeholder="m.konate@@cotedivoireterminal.com, support@@cit.ci" @bind="rule.RecipientsCsv" />
                                }
                                else if (rule.Channel == NotificationChannel.Teams)
                                {
                                    <label class="kmk-label">URL Webhook Microsoft Teams (Incoming Webhook)</label>
                                    <input class="kmk-input text-xs font-mono" placeholder="https://cotedivoireterminal.webhook.office.com/..." @bind="rule.WebhookUrl" />
                                }
                                else
                                {
                                    <label class="kmk-label">URL Webhook HTTP (POST JSON)</label>
                                    <input class="kmk-input text-xs font-mono" placeholder="https://supervision.cit/api/alertes" @bind="rule.WebhookUrl" />
                                }
                            </div>

                            <div class="sm:col-span-3 flex items-center justify-end gap-2 pb-0.5">
                                <button type="button" 
                                        class="kmk-btn-secondary kmk-btn-sm text-xs font-medium flex items-center gap-1.5 shadow-xs" 
                                        disabled="@testState.Testing"
                                        @onclick="() => TestNotificationRuleAsync(rule)">
                                    @if (testState.Testing)
                                    {
                                        <span class="inline-block animate-spin h-3.5 w-3.5 border-2 border-brand-500 border-t-transparent rounded-full"></span>
                                        <span>Envoi...</span>
                                    }
                                    else
                                    {
                                        <svg class="h-3.5 w-3.5 text-brand-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" /></svg>
                                        <span>Tester</span>
                                    }
                                </button>

                                <label class="flex items-center gap-1.5 text-xs text-slate-700 cursor-pointer select-none px-2 py-1 bg-white border border-slate-200 rounded">
                                    <input type="checkbox" class="kmk-checkbox h-3.5 w-3.5" @bind="rule.Enabled" />
                                    <span>Actif</span>
                                </label>

                                <button type="button" class="kmk-btn-danger kmk-btn-sm text-xs px-2 py-1" title="Supprimer la règle" @onclick="() => _job.NotificationRules.Remove(rule)">✕</button>
                            </div>
                        </div>

                        @if (testState.Success.HasValue)
                        {
                            <div class="mt-2.5 px-3 py-2 rounded-lg text-xs flex items-center gap-2 @(testState.Success.Value ? "bg-emerald-50 text-emerald-800 border border-emerald-200" : "bg-rose-50 text-rose-800 border border-rose-200")">
                                @if (testState.Success.Value)
                                {
                                    <svg class="h-4 w-4 text-emerald-600 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" /></svg>
                                }
                                else
                                {
                                    <svg class="h-4 w-4 text-rose-600 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" /></svg>
                                }
                                <span class="font-medium">@testState.Message</span>
                            </div>
                        }
                    </div>
                }
                @if (_job.NotificationRules.Count == 0)
                {
                    <p class="text-sm text-slate-400">Aucune notification configurée. Cliquez sur « + Ajouter une règle » pour être alerté par e-mail ou Teams.</p>
                }
            </div>
        </div>

        <div class="flex gap-3 mb-8">
            <button type="submit" class="kmk-btn-primary" disabled="@_saving">@(_saving ? "Enregistrement..." : "Enregistrer")</button>
            <a class="kmk-btn-secondary" href="jobs">Annuler</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public Guid? JobId { get; set; }

    private bool IsNew => JobId is null;
    private Job _job = new();
    private bool _loading = true;
    private List<Credential> _credentials = new();
    private List<Job> _otherJobs = new();
    private string? _currentUser;
    private string? _saveError;
    private bool _saving;

    private static readonly TriggerType[] TriggerTypeChoices =
    {
        TriggerType.Horaire, TriggerType.Calendrier, TriggerType.EvenementDossier,
        TriggerType.Demarrage, TriggerType.Api, TriggerType.Manuel
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        _currentUser = authState.User.Identity?.Name;

        await using var db = await DbFactory.CreateDbContextAsync();
        _credentials = (await db.Credentials.AsNoTracking().OrderBy(c => c.Name).ToListAsync())
            .Where(c => CredentialAccess.CanUse(authState.User, c)).ToList();

        if (JobId is { } id)
        {
            _job = await db.Jobs
                .Include(j => j.Steps)
                .Include(j => j.Triggers)
                .Include(j => j.Dependencies)
                .Include(j => j.NotificationRules)
                .FirstAsync(j => j.Id == id);
            _otherJobs = await db.Jobs.Where(j => j.Id != id).OrderBy(j => j.Name).ToListAsync();
        }
        else
        {
            _job = new Job { CreatedBy = _currentUser };
            _otherJobs = await db.Jobs.OrderBy(j => j.Name).ToListAsync();
        }

        _loading = false;
    }

    private void AddStep()
    {
        var nextOrder = _job.Steps.Count == 0 ? 1 : _job.Steps.Max(s => s.Order) + 1;
        _job.Steps.Add(new JobStep { Order = nextOrder, Name = $"Étape {nextOrder}", Type = StepType.ScriptPowerShell, ConfigJson = "{}" });
    }

    private void AddTrigger() => _job.Triggers.Add(new JobTrigger { Type = TriggerType.Horaire, Enabled = true });

    private void GenerateWebhookToken(JobTrigger trigger)
    {
        trigger.WebhookToken = Convert.ToHexString(System.Security.Cryptography.RandomNumberGenerator.GetBytes(32)).ToLowerInvariant();
    }

    private void AddDependency()
    {
        if (_otherJobs.Count == 0) return;
        _job.Dependencies.Add(new JobDependency { DependsOnJobId = _otherJobs.First().Id, Condition = JobDependencyCondition.Succes });
    }

    private void AddNotificationRule() => _job.NotificationRules.Add(new NotificationRule { Event = NotificationEvent.Echec, Channel = NotificationChannel.Email, Enabled = true });

    private readonly Dictionary<Guid, (bool Testing, bool? Success, string? Message)> _ruleTestStates = new();

    private async Task TestNotificationRuleAsync(NotificationRule rule)
    {
        _ruleTestStates[rule.Id] = (true, null, null);
        StateHasChanged();

        var result = await NotificationDispatcher.TestRuleAsync(rule, _job.Name ?? "Nouveau Job");
        _ruleTestStates[rule.Id] = (false, result.Success, result.Message);
        StateHasChanged();
    }

    private string WindowStartString(JobTrigger trigger) => trigger.WindowStart?.ToString(@"hh\:mm") ?? "22:00";

    private void SetWindowStart(JobTrigger trigger, string? value)
    {
        if (TimeSpan.TryParse(value, out var ts)) trigger.WindowStart = ts;
    }

    private readonly Dictionary<JobStep, TransferStepConfig> _transferConfigs = new();
    private readonly Dictionary<JobStep, FileOpStepConfig> _fileOpConfigs = new();
    private readonly Dictionary<JobStep, EmailStepConfig> _emailConfigs = new();
    private readonly Dictionary<JobStep, EmailReceptionStepConfig> _emailReceptionConfigs = new();
    private readonly Dictionary<JobStep, RobotFrameworkStepConfig> _robotConfigs = new();
    private readonly Dictionary<JobStep, SqlStepConfig> _sqlConfigs = new();
    private readonly Dictionary<JobStep, bool> _rawJsonMode = new();
    private readonly Dictionary<JobStep, ConnectionTestResult?> _testResults = new();
    private readonly Dictionary<JobStep, bool> _isTesting = new();

    private static bool IsTransferStep(StepType type) =>
        type is StepType.TransfertSftp or StepType.TransfertFtp or StepType.TransfertFtps or StepType.TransfertSmb;

    private static bool IsEmailStep(StepType type) => type == StepType.EmailSmtp;

    private static bool IsEmailReceptionStep(StepType type) => type == StepType.ReceptionEmailImap;
    private const string DefaultMailboxFolder = "INBOX";

    private static bool IsRobotStep(StepType type) => type == StepType.RpaRobotFramework;

    private static bool IsSqlStep(StepType type) => type is StepType.ScriptSql or StepType.BaseDeDonneesRequete;

    private static bool IsFileOpStep(StepType type) =>
        type is StepType.FichierCopier or StepType.FichierDeplacer or StepType.FichierRenommer
            or StepType.FichierSupprimer or StepType.FichierCompresser or StepType.FichierDecompresser
            or StepType.FichierVerifier;

    private bool IsRawJsonMode(JobStep step) => _rawJsonMode.GetValueOrDefault(step, false);

    private void ToggleRawJson(JobStep step)
    {
        var current = IsRawJsonMode(step);
        if (!current)
        {
            if (IsTransferStep(step.Type)) SyncTransferConfig(step);
            else if (IsFileOpStep(step.Type)) SyncFileOpConfig(step);
            else if (IsEmailStep(step.Type)) SyncEmailConfig(step);
            else if (IsEmailReceptionStep(step.Type)) SyncEmailReceptionConfig(step);
            else if (IsRobotStep(step.Type)) SyncRobotConfig(step);
            else if (IsSqlStep(step.Type)) SyncSqlConfig(step);
        }
        else
        {
            if (IsTransferStep(step.Type))
            {
                _transferConfigs.Remove(step);
                _ = GetOrCreateTransferConfig(step);
            }
            else if (IsFileOpStep(step.Type))
            {
                _fileOpConfigs.Remove(step);
                _ = GetOrCreateFileOpConfig(step);
            }
            else if (IsEmailStep(step.Type))
            {
                _emailConfigs.Remove(step);
                _ = GetOrCreateEmailConfig(step);
            }
            else if (IsEmailReceptionStep(step.Type))
            {
                _emailReceptionConfigs.Remove(step);
                _ = GetOrCreateEmailReceptionConfig(step);
            }
            else if (IsRobotStep(step.Type))
            {
                _robotConfigs.Remove(step);
                _ = GetOrCreateRobotConfig(step);
            }
            else if (IsSqlStep(step.Type))
            {
                _sqlConfigs.Remove(step);
                _ = GetOrCreateSqlConfig(step);
            }
        }
        _rawJsonMode[step] = !current;
    }

    private record FileOpUiHints(string SourceLabel, string? DestinationLabel, bool ShowRecursive, bool ShowFilter, bool ShowArchive);

    private static FileOpUiHints GetFileOpUiHints(StepType type) => type switch
    {
        StepType.FichierCopier => new("Dossier ou fichier source", "Dossier de destination", true, true, true),
        StepType.FichierDeplacer => new("Dossier ou fichier source", "Dossier de destination", true, true, true),
        StepType.FichierRenommer => new("Fichier source (chemin complet)", "Nouveau chemin / nom du fichier", false, false, true),
        StepType.FichierSupprimer => new("Dossier ou fichier à supprimer", null, true, true, true),
        StepType.FichierCompresser => new("Dossier à compresser", "Fichier .zip de sortie", false, false, true),
        StepType.FichierDecompresser => new("Fichier .zip à extraire", "Dossier de destination", false, false, true),
        StepType.FichierVerifier => new("Dossier ou fichier à vérifier", null, true, true, false),
        _ => new("Chemin source", "Chemin destination", true, true, true)
    };

    private FileOpStepConfig GetOrCreateFileOpConfig(JobStep step)
    {
        if (!_fileOpConfigs.TryGetValue(step, out var config))
        {
            try
            {
                config = !string.IsNullOrWhiteSpace(step.ConfigJson) && step.ConfigJson != "{}"
                    ? JsonSerializer.Deserialize<FileOpStepConfig>(step.ConfigJson) ?? new FileOpStepConfig()
                    : new FileOpStepConfig();
            }
            catch
            {
                config = new FileOpStepConfig();
            }
            _fileOpConfigs[step] = config;
        }
        return config;
    }

    private void SyncFileOpConfig(JobStep step)
    {
        if (_fileOpConfigs.TryGetValue(step, out var config))
        {
            step.ConfigJson = JsonSerializer.Serialize(config, new JsonSerializerOptions { WriteIndented = true });
        }
    }

    private EmailStepConfig GetOrCreateEmailConfig(JobStep step)
    {
        if (!_emailConfigs.TryGetValue(step, out var config))
        {
            try
            {
                config = !string.IsNullOrWhiteSpace(step.ConfigJson) && step.ConfigJson != "{}"
                    ? JsonSerializer.Deserialize<EmailStepConfig>(step.ConfigJson) ?? new EmailStepConfig()
                    : new EmailStepConfig { SmtpPort = 587, UseTls = true };
            }
            catch
            {
                config = new EmailStepConfig { SmtpPort = 587, UseTls = true };
            }

            // Le credential ne fournit que l'authentification (utilisateur/mot de passe) à l'exécution — mais on
            // préremplit ici l'hôte/port pour l'écran si le credential en porte déjà (confort de saisie uniquement).
            if (string.IsNullOrWhiteSpace(config.SmtpHost) && step.CredentialId is not null)
            {
                var cred = _credentials.FirstOrDefault(c => c.Id == step.CredentialId.Value);
                if (cred is not null)
                {
                    if (!string.IsNullOrWhiteSpace(cred.Host)) config.SmtpHost = cred.Host;
                    if (cred.Port is > 0) config.SmtpPort = cred.Port.Value;
                }
            }

            _emailConfigs[step] = config;
        }
        return config;
    }

