    private TransferStepConfig GetOrCreateTransferConfig(JobStep step)
    {
        if (!_transferConfigs.TryGetValue(step, out var config))
        {
            try
            {
                if (!string.IsNullOrWhiteSpace(step.ConfigJson) && step.ConfigJson != "{}")
                {
                    config = JsonSerializer.Deserialize<TransferStepConfig>(step.ConfigJson) ?? new TransferStepConfig();
                }
                else
                {
                    config = new TransferStepConfig
                    {
                        Host = "",
                        Port = step.Type == StepType.TransfertSftp ? 22 : 21,
                        Upload = false,
                        RemotePath = "/upload/fichiers/",
                        LocalPath = @"C:\Donnees\Local\",
                        Filter = null
                    };
                }
            }
            catch
            {
                config = new TransferStepConfig();
            }

            if (step.CredentialId is not null)
            {
                var cred = _credentials.FirstOrDefault(c => c.Id == step.CredentialId.Value);
                if (cred is not null)
                {
                    if (string.IsNullOrWhiteSpace(config.Host) && !string.IsNullOrWhiteSpace(cred.Host))
                    {
                        config.Host = cred.Host;
                    }
                    if (config.Port <= 0 && cred.Port is > 0)
                    {
                        config.Port = cred.Port.Value;
                    }
                }
            }

            _transferConfigs[step] = config;
        }
        return config;
