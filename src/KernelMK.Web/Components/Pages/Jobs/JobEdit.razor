@page "/jobs/new"
@rendermode InteractiveServer
@page "/jobs/{JobId:guid}"
@page "/jobs/{JobId:guid}/edit"
@page "/jobs/edit/{JobId:guid}"
@attribute [Authorize(Roles = "Administrateur,Developpeur")]
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using KernelMK.Core.StepConfigs
@using KernelMK.Data.Security
@using KernelMK.Engine.Audit
@using KernelMK.Engine.Execution
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuditService Audit
@inject KernelMK.Engine.Queue.JobVersionService JobVersions
@inject AuthenticationStateProvider AuthState
@inject IAuthorizationService Authorization
@inject ILogger<JobEdit> Logger
@inject NavigationManager Nav
@inject ConnectionTestService TestService
@inject CredentialProtector Protector
@inject KernelMK.Engine.Notifications.NotificationDispatcher NotificationDispatcher

<PageTitle>@(IsNew ? "Nouveau job" : "Modifier le job") · kernelMK</PageTitle>

@if (_loading)
{
    <p class="text-sm text-slate-500">Chargement...</p>
}
else
{
    <div class="kmk-page-header mb-6">
        <h1>@(IsNew ? "Nouveau job" : $"Job : {_job.Name}")</h1>
        @if (!IsNew)
        {
            <a class="kmk-btn-secondary text-xs" href="@($"/jobs/{_job.Id}/versions")">Historique des versions</a>
        }
    </div>

    @if (_saveError is not null)
    {
        <p role="alert" class="mb-4 text-sm text-red-700">@_saveError</p>
    }
    <EditForm Model="_job" OnValidSubmit="SaveAsync">
        <div class="kmk-card mb-5">
            <div class="kmk-card-header">Informations générales</div>
            <div class="kmk-card-body grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="kmk-label">Nom</label>
                    <InputText class="kmk-input" @bind-Value="_job.Name" />
                </div>
                <div>
                    <label class="kmk-label">Propriétaire</label>
                    <InputText class="kmk-input" @bind-Value="_job.Owner" />
                </div>
                <div class="md:col-span-2">
                    <label class="kmk-label">Description / objectif</label>
                    <InputTextArea class="kmk-input" @bind-Value="_job.Description" />
                </div>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:col-span-2">
                    <div>
                        <label class="kmk-label">Criticité</label>
                        <InputSelect class="kmk-select" @bind-Value="_job.Criticite">
                            @foreach (var c in Enum.GetValues<Criticite>())
                            {
                                <option value="@c">@c</option>
                            }
                        </InputSelect>
                    </div>
                    <div>
                        <label class="kmk-label">Compte d'exécution</label>
                        <InputText class="kmk-input" @bind-Value="_job.ExecutionAccount" />
                    </div>
                    <div>
                        <label class="kmk-label">Timeout job (s)</label>
                        <InputNumber class="kmk-input" @bind-Value="_job.TimeoutSeconds" />
                    </div>
                    <div>
                        <label class="kmk-label">Tentatives max</label>
                        <InputNumber class="kmk-input" @bind-Value="_job.MaxRetries" />
                    </div>
                </div>
                <div>
                    <label class="kmk-label">Délai reprise (s)</label>
                    <InputNumber class="kmk-input" @bind-Value="_job.RetryDelaySeconds" />
                </div>
                <div class="flex items-end gap-6">
                    <label class="flex items-center gap-2 text-sm text-slate-700">
                        <InputCheckbox class="kmk-checkbox" @bind-Value="_job.AllowConcurrentExecution" />
                        Exécution concurrente autorisée
                    </label>
                    <label class="flex items-center gap-2 text-sm text-slate-700">
                        <InputCheckbox class="kmk-checkbox" @bind-Value="_job.Enabled" />
                        Job actif
                    </label>
                </div>
            </div>
        </div>

        <div class="kmk-card mb-5">
            <div class="kmk-card-header">
                <span>Étapes (tâches)</span>
                <button type="button" class="kmk-btn-primary kmk-btn-sm" @onclick="AddStep">+ Ajouter une étape</button>
            </div>
            <div class="kmk-card-body space-y-4">
                <p class="text-xs text-slate-400 -mt-1">
                    💡 Astuce : choisis le type d'étape puis clique sur « Modèle JSON » pour préremplir la configuration
                    avec les champs attendus — il ne reste plus qu'à ajuster les valeurs (chemins, hôte, requête...).
                </p>

                @if (_job.Steps.Count > 0)
                {
                    <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-3">
                        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-2">Aperçu du pipeline</p>
                        <JobPipelineDiagram Steps="_job.Steps" />
                    </div>
                }

                @foreach (var step in _job.Steps.OrderBy(s => s.Order).ToList())
                {
                    <div class="border border-slate-200 rounded-lg p-4">
                        <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-3">
                            <div>
                                <label class="kmk-label">Ordre</label>
                                <input type="number" class="kmk-input" @bind="step.Order" />
                            </div>
                            <div class="col-span-2">
                                <label class="kmk-label">Nom</label>
                                <input class="kmk-input" @bind="step.Name" />
                            </div>
                            <div class="col-span-2">
                                <label class="kmk-label">Type</label>
                                <select class="kmk-select" value="@step.Type" @onchange="(e) => OnStepTypeChanged(step, e.Value?.ToString())">
                                    @foreach (var t in Enum.GetValues<StepType>())
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="kmk-label">Timeout (s)</label>
                                <input type="number" class="kmk-input" @bind="step.TimeoutSeconds" />
                            </div>
                            <div>
                                <label class="kmk-label">Reprises</label>
                                <input type="number" class="kmk-input" @bind="step.MaxRetries" />
                            </div>
                            <div>
                                <label class="kmk-label">Délai reprise (s)</label>
                                <input type="number" class="kmk-input" @bind="step.RetryDelaySeconds" />
                            </div>
                            <div class="col-span-2">
                                <label class="kmk-label">Action en cas d'échec</label>
                                <select class="kmk-select" @bind="step.OnErrorAction">
                                    @foreach (var a in Enum.GetValues<OnErrorAction>())
                                    {
                                        <option value="@a">@a</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="kmk-label">Succès → ordre</label>
                                <input type="number" class="kmk-input" @bind="step.OnSuccessGoToOrder" />
                            </div>
                            <div>
                                <label class="kmk-label">Échec → ordre</label>
                                <input type="number" class="kmk-input" @bind="step.OnFailureGoToOrder" />
                            </div>
                            <div class="col-span-2">
                                <label class="kmk-label">Credential</label>
                                <select class="kmk-select" value="@step.CredentialId" @onchange="(e) => OnCredentialChanged(step, e.Value?.ToString())">
                                    <option value="">(aucun)</option>
                                    @foreach (var c in _credentials)
                                    {
                                        <option value="@c.Id">@c.Name @(!string.IsNullOrWhiteSpace(c.Host) ? $" · {c.Host}" : "")</option>
                                    }
                                </select>
                            </div>
                            <div class="flex items-end">
                                <button type="button" class="kmk-btn-secondary w-full" @onclick="() => LoadTemplate(step)">Modèle par défaut</button>
                            </div>

                            @if (IsTransferStep(step.Type))
                            {
                                var tConfig = GetOrCreateTransferConfig(step);
                                <div class="col-span-2 sm:col-span-4 md:col-span-6 bg-slate-50/90 border border-slate-200/90 rounded-xl p-4 mt-2">
                                    <div class="flex items-center justify-between mb-3 border-b border-slate-200/60 pb-2">
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs font-bold uppercase tracking-wider text-slate-700">Paramètres de transfert (@step.Type)</span>
                                            @if (step.CredentialId != null && !string.IsNullOrWhiteSpace(GetCredentialHost(step.CredentialId)))
                                            {
                                                <span class="kmk-badge kmk-badge-info text-[10px]">Hérite de @GetCredentialName(step.CredentialId)</span>
                                            }
                                        </div>
                                        <button type="button" class="kmk-btn-secondary kmk-btn-sm text-xs" @onclick="() => ToggleRawJson(step)">
                                            @(IsRawJsonMode(step) ? "Afficher le formulaire" : "Mode JSON brut")
                                        </button>
                                    </div>

                                    @if (IsRawJsonMode(step))
                                    {
                                        <div class="space-y-1">
                                            <label class="kmk-label">Configuration (JSON brut)</label>
                                            <textarea class="kmk-input font-mono text-xs" rows="4" @bind="step.ConfigJson"></textarea>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
                                            @if (step.Type != StepType.TransfertSmb)
                                            {
                                                <div class="md:col-span-3">
                                                    <label class="kmk-label">Hôte / Serveur distant (nom ou adresse IP)</label>
                                                    <input class="kmk-input" placeholder="ex: sftp.partenaire.fr ou 192.168.1.50"
                                                           value="@tConfig.Host"
                                                           @oninput="(e) => { tConfig.Host = e.Value?.ToString() ?? string.Empty; SyncTransferConfig(step); }" />
                                                </div>
                                                <div>
                                                    <label class="kmk-label">Port</label>
                                                    <input type="number" class="kmk-input" placeholder="@(step.Type == StepType.TransfertSftp ? "22" : "21")"
                                                           value="@tConfig.Port"
                                                           @oninput="(e) => { if (int.TryParse(e.Value?.ToString(), out var p)) tConfig.Port = p; SyncTransferConfig(step); }" />
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="md:col-span-4">
                                                    <label class="kmk-label">Partage réseau SMB (chemin UNC)</label>
                                                    <input class="kmk-input font-mono text-xs" placeholder="ex: \\serveur\partage\dossier"
                                                           value="@tConfig.SmbShare"
                                                           @oninput="(e) => { tConfig.SmbShare = e.Value?.ToString(); SyncTransferConfig(step); }" />
                                                </div>
                                            }

                                            <div class="col-span-1 sm:col-span-2 md:col-span-4">
                                                <label class="kmk-label">Sens du transfert</label>
                                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                                    <label class="flex items-center gap-2.5 p-2.5 rounded-xl border @(!tConfig.Upload ? "border-brand-500 bg-brand-50/60 font-semibold text-brand-900 shadow-sm" : "border-slate-200 bg-white text-slate-700") cursor-pointer transition-all">
                                                        <input type="radio" name="@($"transfer_dir_{step.Order}")" checked="@(!tConfig.Upload)"
                                                               @onchange="() => { tConfig.Upload = false; SyncTransferConfig(step); }" class="kmk-checkbox" />
                                                        <span class="text-xs">
                                                            <span class="text-sm mr-1">⬇️</span> <strong>Télécharger</strong> (Serveur distant ➔ Dossier local)
                                                        </span>
                                                    </label>
                                                    <label class="flex items-center gap-2.5 p-2.5 rounded-xl border @(tConfig.Upload ? "border-brand-500 bg-brand-50/60 font-semibold text-brand-900 shadow-sm" : "border-slate-200 bg-white text-slate-700") cursor-pointer transition-all">
                                                        <input type="radio" name="@($"transfer_dir_{step.Order}")" checked="@(tConfig.Upload)"
                                                               @onchange="() => { tConfig.Upload = true; SyncTransferConfig(step); }" class="kmk-checkbox" />
                                                        <span class="text-xs">
                                                            <span class="text-sm mr-1">⬆️</span> <strong>Déposer / Envoyer</strong> (Dossier local ➔ Serveur distant)
                                                        </span>
                                                    </label>
                                                </div>
                                            </div>

                                            <div class="col-span-1 sm:col-span-2">
                                                <label class="kmk-label">Chemin distant (@(tConfig.Upload ? "dossier cible sur le serveur" : "dossier/fichier source sur le serveur"))</label>
                                                <input class="kmk-input font-mono text-xs" placeholder="ex: /upload/fichiers/ ou /in/fichier.csv"
                                                       value="@tConfig.RemotePath"
                                                       @oninput="(e) => { tConfig.RemotePath = e.Value?.ToString() ?? string.Empty; SyncTransferConfig(step); }" />
                                            </div>

                                            <div class="col-span-1 sm:col-span-2">
                                                <label class="kmk-label">Chemin local (@(tConfig.Upload ? "dossier/fichier source local" : "dossier cible local"))</label>
                                                <input class="kmk-input font-mono text-xs" placeholder="ex: C:\Donnees\Local\ ou \\Serveur\Partage\Dossier\"
                                                       value="@tConfig.LocalPath"
                                                       @oninput="(e) => { tConfig.LocalPath = e.Value?.ToString() ?? string.Empty; SyncTransferConfig(step); }" />
                                            </div>

                                            @if (tConfig.LocalPath.StartsWith(@"\\"))
                                            {
                                                <div class="col-span-1 sm:col-span-2">
                                                    <label class="kmk-label">
                                                        Compte d'accès au partage réseau local
                                                        <span class="text-slate-400 font-normal text-[11px]">(si le service Windows n'y a pas accès directement)</span>
                                                    </label>
                                                    <select class="kmk-select text-xs"
                                                            value="@(tConfig.LocalCredentialId?.ToString() ?? "")"
                                                            @onchange="(e) => { var val = e.Value?.ToString(); tConfig.LocalCredentialId = Guid.TryParse(val, out var gid) ? gid : null; SyncTransferConfig(step); }">
                                                        <option value="">(Identité du service — lecteur déjà accessible)</option>
                                                        @foreach (var c in _credentials)
                                                        {
                                                            <option value="@c.Id">@c.Name @(!string.IsNullOrWhiteSpace(c.Host) ? $" · {c.Host}" : "")</option>
                                                        }
                                                    </select>
                                                    <p class="text-[11px] text-slate-400 mt-1">Se connecte au partage avec ces identifiants (équivalent de « net use » avec un compte dédié), indépendamment du Credential utilisé côté serveur distant ci-dessus.</p>
                                                </div>
                                            }

                                            <div class="col-span-1 sm:col-span-2">
                                                <label class="kmk-label">Filtre de fichiers (multi-fichiers)</label>
                                                <input class="kmk-input font-mono text-xs" placeholder="ex: *.csv;*.txt;*.edi (vide = fichier unique)"
                                                       value="@tConfig.Filter"
                                                       @oninput="(e) => { tConfig.Filter = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value?.ToString(); SyncTransferConfig(step); }" />
                                            </div>

                                            <div class="col-span-1 sm:col-span-2">
                                                <label class="kmk-label">Armateur / Ligne Maritime (Partenaire)</label>
                                                <div class="flex gap-2">
                                                    <select class="kmk-select text-xs w-44 shrink-0"
                                                            value="@(string.IsNullOrEmpty(tConfig.Armateur) ? "" : tConfig.Armateur)"
                                                            @onchange="(e) => { var val = e.Value?.ToString(); if (!string.IsNullOrEmpty(val)) { tConfig.Armateur = val; SyncTransferConfig(step); } }">
                                                        <option value="">(Sélection...)</option>
                                                        <option value="GUCE">GUCE (Guichet Unique)</option>
                                                        <option value="DOUANE">Douane CI</option>
                                                        <option value="MSC">MSC</option>
                                                        <option value="CMA CGM">CMA CGM</option>
                                                        <option value="MAERSK">MAERSK</option>
                                                        <option value="HAPAG-LLOYD">HAPAG-LLOYD</option>
                                                        <option value="COSCO">COSCO</option>
                                                        <option value="ONE">ONE</option>
                                                        <option value="GRIMALDI">GRIMALDI</option>
                                                        <option value="PIL">PIL</option>
                                                        <option value="ARKAS">ARKAS</option>
                                                    </select>
                                                    <input class="kmk-input text-xs flex-1" placeholder="Nom du partenaire ou armateur (ex: GUCE, MSC, CMA CGM...)"
                                                           value="@tConfig.Armateur"
                                                           @oninput="(e) => { tConfig.Armateur = e.Value?.ToString(); SyncTransferConfig(step); }" />
                                                </div>
                                            </div>

                                            <div class="col-span-1 sm:col-span-2 flex flex-col justify-center gap-2 pt-1">
                                                @if (step.Type == StepType.TransfertFtps || step.Type == StepType.TransfertFtp)
                                                {
                                                    <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer">
                                                        <input type="checkbox" class="kmk-checkbox" checked="@tConfig.UseTls"
                                                               @onchange="(e) => { 
                                                                   tConfig.UseTls = (bool)(e.Value ?? false); 
                                                                   step.Type = tConfig.UseTls ? StepType.TransfertFtps : StepType.TransfertFtp;
                                                                   SyncTransferConfig(step); 
                                                               }" />
                                                        <span class="font-semibold text-slate-800">Chiffrement TLS / SSL explicite (FTPS)</span>
                                                        <span class="text-brand-600 text-[11px] font-medium bg-brand-50 px-1.5 py-0.5 rounded border border-brand-200">Requis pour GUCE</span>
                                                    </label>
                                                }
                                                @if (tConfig.Upload)
                                                {
                                                    <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer">
                                                        <input type="checkbox" class="kmk-checkbox" checked="@tConfig.ArchiveAfterTransfer"
                                                               @onchange="(e) => { tConfig.ArchiveAfterTransfer = (bool)(e.Value ?? false); SyncTransferConfig(step); }" />
                                                        <span class="font-semibold text-slate-800">Couper / Déplacer vers l'archive</span>
                                                        <span class="text-slate-500 text-[11px]">(déplace le fichier local pour ne plus le renvoyer)</span>
                                                    </label>
                                                }
                                                else
                                                {
                                                    <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer">
                                                        <input type="checkbox" class="kmk-checkbox" checked="@tConfig.DeleteRemoteAfterDownload"
                                                               @onchange="(e) => { tConfig.DeleteRemoteAfterDownload = (bool)(e.Value ?? false); SyncTransferConfig(step); }" />
                                                        <span class="font-semibold text-slate-800">Supprimer le fichier distant</span>
                                                        <span class="text-slate-500 text-[11px]">(évite de re-télécharger le même fichier au prochain tour)</span>
                                                    </label>
                                                }
                                            </div>

                                            @if (tConfig.Upload && tConfig.ArchiveAfterTransfer)
                                            {
                                                <div class="col-span-1 sm:col-span-2 md:col-span-4">
                                                    <label class="kmk-label">Dossier d'archivage local (où couper et ranger les fichiers envoyés)</label>
                                                    <input class="kmk-input font-mono text-xs" placeholder="ex: C:\Donnees\Archives\"
                                                           value="@tConfig.ArchiveDirectory"
                                                           @oninput="(e) => { tConfig.ArchiveDirectory = e.Value?.ToString(); SyncTransferConfig(step); }" />
                                                </div>
                                            }

                                            <!-- Zone Test de connexion en direct -->
                                            <div class="col-span-1 sm:col-span-2 md:col-span-4 pt-3 border-t border-slate-200/80 mt-1 flex flex-wrap items-center justify-between gap-3">
                                                <button type="button" class="kmk-btn-secondary kmk-btn-sm flex items-center gap-1.5"
                                                        disabled="@(_isTesting.GetValueOrDefault(step))"
                                                        @onclick="() => TestStepConnectionAsync(step)">
                                                    @if (_isTesting.GetValueOrDefault(step))
                                                    {
                                                        <svg class="animate-spin h-3.5 w-3.5 text-brand-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                                                        <span>Test de connexion en cours...</span>
                                                    }
                                                    else
                                                    {
                                                        <span>🔌 Tester la connexion au serveur</span>
                                                    }
                                                </button>

                                                @if (_testResults.TryGetValue(step, out var testResult) && testResult is not null)
                                                {
                                                    <div class="kmk-flex-field flex-1 min-w-[280px]">
                                                        @if (testResult.Success)
                                                        {
                                                            <div class="p-2.5 rounded-xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-800 flex items-start gap-2">
                                                                <span class="text-emerald-600 font-bold text-sm">✓</span>
                                                                <div>
                                                                    <div class="font-semibold">@testResult.Message</div>
                                                                    @if (!string.IsNullOrWhiteSpace(testResult.WorkingDirectory))
                                                                    {
                                                                        <div class="text-emerald-700 mt-0.5">@testResult.WorkingDirectory</div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="p-2.5 rounded-xl bg-red-50 border border-red-200 text-xs text-red-800 flex items-start gap-2">
                                                                <span class="text-red-600 font-bold text-sm">✗</span>
                                                                <div>
                                                                    <div class="font-semibold">Échec du test de connexion</div>
                                                                    <div class="text-red-700 mt-0.5">@testResult.Message</div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (IsFileOpStep(step.Type))
                            {
                                var fConfig = GetOrCreateFileOpConfig(step);
                                var hints = GetFileOpUiHints(step.Type);
                                <div class="col-span-2 sm:col-span-4 md:col-span-6 bg-slate-50/90 border border-slate-200/90 rounded-xl p-4 mt-2">
                                    <div class="flex items-center justify-between mb-3 border-b border-slate-200/60 pb-2">
                                        <span class="text-xs font-bold uppercase tracking-wider text-slate-700">Paramètres fichier (@step.Type)</span>
                                        <button type="button" class="kmk-btn-secondary kmk-btn-sm text-xs" @onclick="() => ToggleRawJson(step)">
                                            @(IsRawJsonMode(step) ? "Afficher le formulaire" : "Mode JSON brut")
                                        </button>
                                    </div>

                                    @if (IsRawJsonMode(step))
                                    {
                                        <div class="space-y-1">
                                            <label class="kmk-label">Configuration (JSON brut)</label>
                                            <textarea class="kmk-input font-mono text-xs" rows="4" @bind="step.ConfigJson"></textarea>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
                                            <div class="@(hints.DestinationLabel is not null ? "col-span-1 sm:col-span-2" : "col-span-1 sm:col-span-2 md:col-span-4")">
                                                <label class="kmk-label">@hints.SourceLabel</label>
                                                <input class="kmk-input font-mono text-xs" placeholder="ex: C:\Donnees\Source\"
                                                       value="@fConfig.SourcePath"
                                                       @oninput="(e) => { fConfig.SourcePath = e.Value?.ToString() ?? string.Empty; SyncFileOpConfig(step); }" />
                                            </div>

                                            @if (hints.DestinationLabel is not null)
                                            {
                                                <div class="col-span-1 sm:col-span-2">
                                                    <label class="kmk-label">@hints.DestinationLabel</label>
                                                    <input class="kmk-input font-mono text-xs" placeholder="ex: D:\Donnees\Destination\ (un autre lecteur est possible)"
                                                           value="@fConfig.DestinationPath"
                                                           @oninput="(e) => { fConfig.DestinationPath = e.Value?.ToString(); SyncFileOpConfig(step); }" />
                                                </div>
                                            }

                                            @if (hints.ShowFilter)
                                            {
                                                <div class="col-span-1 sm:col-span-2">
                                                    <label class="kmk-label">Filtre de fichiers</label>
                                                    <input class="kmk-input font-mono text-xs" placeholder="ex: *.csv;*.txt;*.edi (vide = tous)"
                                                           value="@fConfig.Filter"
                                                           @oninput="(e) => { fConfig.Filter = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value?.ToString(); SyncFileOpConfig(step); }" />
                                                </div>
                                            }

                                            <div class="col-span-1 sm:col-span-2 flex items-end gap-4 pb-1">
                                                @if (hints.ShowRecursive)
                                                {
                                                    <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer">
                                                        <input type="checkbox" class="kmk-checkbox" checked="@fConfig.Recursive"
                                                               @onchange="(e) => { fConfig.Recursive = (bool)(e.Value ?? false); SyncFileOpConfig(step); }" />
                                                        <span class="font-semibold text-slate-800">Inclure les sous-dossiers</span>
                                                    </label>
                                                }
                                                @if (hints.DestinationLabel is not null)
                                                {
                                                    <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer">
                                                        <input type="checkbox" class="kmk-checkbox" checked="@fConfig.Overwrite"
                                                               @onchange="(e) => { fConfig.Overwrite = (bool)(e.Value ?? false); SyncFileOpConfig(step); }" />
