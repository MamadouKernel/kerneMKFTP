@page "/jobs"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrateur,Superviseur,Exploitant,Developpeur,Auditeur")]
@implements IDisposable
@using Microsoft.EntityFrameworkCore
@using System.Text
@using KernelMK.Engine.Execution
@using KernelMK.Engine.Workflow
@using KernelMK.Engine.Audit
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJobRunner JobRunner
@inject IJobExecutionCoordinator ExecutionCoordinator
@inject AuditService Audit
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Gestion des Jobs · kernelMK · Côte d'Ivoire Terminal</PageTitle>

<!-- Top Title Bar -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
        <div class="flex items-center gap-3">
            <h1 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2.5">
                <span class="h-9 w-9 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shadow-xs border border-indigo-100">
                    <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 0 1 0 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 0 1 0-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    </svg>
                </span>
                Gestion des Jobs
            </h1>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                Temps réel actif
            </span>
        </div>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
            Supervision, ordonnancement et contrôle des flux automatisés (Mise en pause &amp; Arrêt sans suppression).
        </p>
    </div>

    <div class="flex items-center gap-2.5">
        <button type="button" @onclick="ExportJobsCsv" class="kmk-btn-secondary text-xs py-2 px-3 flex items-center gap-1.5 shadow-xs" title="Exporter la cartographie des flux en CSV">
            <svg class="h-3.5 w-3.5 text-slate-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
            <span>Exporter CSV</span>
        </button>

        <button type="button" @onclick="LoadAsync" class="kmk-btn-secondary text-xs py-2 px-3 flex items-center gap-1.5 shadow-xs">
            <svg class="h-3.5 w-3.5 text-slate-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
            </svg>
            <span>Actualiser</span>
        </button>

        <AuthorizeView Roles="Administrateur,Developpeur">
            <a class="kmk-btn-primary text-xs py-2 px-3.5 shadow-sm" href="jobs/new">
                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                <span>Nouveau job</span>
            </a>
        </AuthorizeView>
    </div>
</div>

<!-- Key Metric Stat Cards -->
@if (!_loading)
{
    var total = _jobs.Count;
    var actives = _jobs.Count(j => j.Enabled);
    var paused = _jobs.Count(j => !j.Enabled);
    var runningCount = _jobs.Count(j => ExecutionCoordinator.IsJobRunning(j.Id) || _running.Contains(j.Id) || j.LastStatus == JobStatus.EnCours);
    var failedCount = _jobs.Count(j => j.LastStatus == JobStatus.Echec);

    <div class="grid grid-cols-2 lg:grid-cols-5 gap-3.5 mb-6">
        <div class="kmk-card p-4 flex items-center gap-3.5 hover:shadow-md transition-shadow">
            <div class="h-11 w-11 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center shrink-0 border border-slate-200/80">
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 0 1 0 3.75H5.625a1.875 1.875 0 0 1 0-3.75Z" />
                </svg>
            </div>
            <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block">Total Jobs</span>
                <span class="text-2xl font-bold text-slate-900 leading-none">@total</span>
            </div>
        </div>

        <div class="kmk-card p-4 flex items-center gap-3.5 hover:shadow-md transition-shadow">
            <div class="h-11 w-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 border border-emerald-200">
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
            </div>
            <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block">Actifs (Planifiés)</span>
                <span class="text-2xl font-bold text-emerald-600 leading-none">@actives</span>
            </div>
        </div>

        <div class="kmk-card p-4 flex items-center gap-3.5 hover:shadow-md transition-shadow">
            <div class="h-11 w-11 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0 border border-amber-200">
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9v6m-4.5 0V9M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
            </div>
            <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block">En pause / Arrêt</span>
                <span class="text-2xl font-bold text-amber-600 leading-none">@paused</span>
            </div>
        </div>

        <div class="kmk-card p-4 flex items-center gap-3.5 hover:shadow-md transition-shadow">
            <div class="h-11 w-11 rounded-xl @(runningCount > 0 ? "bg-indigo-50 text-indigo-600 border border-indigo-200 animate-pulse" : "bg-slate-100 text-slate-400 border border-slate-200") flex items-center justify-center shrink-0">
                <svg class="h-5 w-5 @(runningCount > 0 ? "animate-spin" : "")" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                </svg>
            </div>
            <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block">En cours</span>
                <span class="text-2xl font-bold @(runningCount > 0 ? "text-indigo-600" : "text-slate-800") leading-none">@runningCount</span>
            </div>
        </div>

        <div class="kmk-card p-4 flex items-center gap-3.5 hover:shadow-md transition-shadow col-span-2 lg:col-span-1">
            <div class="h-11 w-11 rounded-xl @(failedCount > 0 ? "bg-rose-50 text-rose-600 border border-rose-200" : "bg-slate-100 text-slate-400 border border-slate-200") flex items-center justify-center shrink-0">
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                </svg>
            </div>
            <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block">Dernier Échec</span>
                <span class="text-2xl font-bold @(failedCount > 0 ? "text-rose-600" : "text-slate-800") leading-none">@failedCount</span>
            </div>
        </div>
    </div>
}

<!-- Modern Filter & Search Bar -->
<div class="kmk-card p-3.5 mb-5 flex flex-col md:flex-row md:items-center justify-between gap-3 bg-white/95">
    <div class="flex-1 grid grid-cols-1 sm:grid-cols-3 gap-2.5">
        <!-- Recherche par nom -->
        <div class="relative">
            <input class="kmk-input !py-2 !pl-9 text-xs" placeholder="Filtrer par nom ou description..." @bind="_filterName" @bind:event="oninput" />
            <svg class="h-4 w-4 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
            </svg>
        </div>

        <!-- Filtre par Mode (Actif / Pause) -->
        <select class="kmk-select !py-2 text-xs" @bind="_filterMode">
            <option value="">Tous les modes (Actifs &amp; En pause)</option>
            <option value="active">Actifs seulement (planification en marche)</option>
            <option value="paused">En pause seulement (planification suspendue)</option>
        </select>

        <!-- Filtre par Statut d'exécution -->
        <select class="kmk-select !py-2 text-xs" @bind="_filterStatus">
            <option value="">Tous les résultats d'exécution</option>
            @foreach (var s in Enum.GetValues<JobStatus>())
            {
                <option value="@s">@FormatStatus(s)</option>
            }
        </select>
    </div>

    @if (!string.IsNullOrWhiteSpace(_filterName) || !string.IsNullOrWhiteSpace(_filterMode) || !string.IsNullOrWhiteSpace(_filterStatus))
    {
        <button type="button" @onclick="ResetFilters" class="kmk-btn-secondary !py-2 !px-3 text-xs text-slate-500 hover:text-slate-800 shrink-0">
            <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
            Réinitialiser (@FilteredJobs.Count() affiché(s))
        </button>
    }
</div>

<!-- Jobs Data Table with Enhanced Modern Design -->
@if (_loading)
{
    <div class="kmk-card p-12 flex flex-col items-center justify-center gap-3 text-sm text-slate-500">
        <svg class="animate-spin h-6 w-6 text-brand-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
        <span>Chargement des traitements automatisés...</span>
    </div>
}
else
{
    <div class="kmk-table-container">
        <table class="kmk-table">
            <thead>
                <tr>
                    <th class="w-1/3 min-w-[220px]">
                        <div class="flex items-center gap-1.5">
                            <svg class="h-3.5 w-3.5 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
                            <span>Nom &amp; Description</span>
                        </div>
                    </th>
                    <th class="min-w-[100px]">Criticité</th>
                    <th class="min-w-[140px]">
                        <div class="flex items-center gap-1.5">
                            <svg class="h-3.5 w-3.5 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5.636 5.636a9 9 0 1 0 12.728 0M12 3v9" /></svg>
                            <span>Mode / Planification</span>
                        </div>
                    </th>
                    <th class="min-w-[120px]">Dernier Résultat</th>
                    <th class="min-w-[140px]">Dernière exécution</th>
                    <th class="min-w-[140px]">Prochaine</th>
                    <th class="text-right min-w-[260px] pr-5">Actions de contrôle</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var job in FilteredJobs)
                {
                    var isCurrentlyRunning = ExecutionCoordinator.IsJobRunning(job.Id) || _running.Contains(job.Id) || job.LastStatus == JobStatus.EnCours;

                    <tr class="@(!job.Enabled ? "bg-slate-50/50 opacity-85" : "")">
                        <!-- Nom et Description -->
                        <td>
                            <div class="flex items-start gap-2.5">
                                <div class="mt-0.5 h-7 w-7 rounded-lg flex items-center justify-center shrink-0 @(job.Enabled ? "bg-indigo-50 text-indigo-600 border border-indigo-100" : "bg-slate-100 text-slate-400 border border-slate-200")">
                                    <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 13.5V3.75m0 9.75a1.5 1.5 0 0 1 0 3m0-3a1.5 1.5 0 0 0 0 3m0 3.75V16.5m12-3V3.75m0 9.75a1.5 1.5 0 0 1 0 3m0-3a1.5 1.5 0 0 0 0 3m0 3.75V16.5m-6-9V3.75m0 3.75a1.5 1.5 0 0 1 0 3m0-3a1.5 1.5 0 0 0 0 3m0 9.75V10.5" />
                                    </svg>
                                </div>
                                <div class="min-w-0">
                                    <div class="flex items-center gap-2">
                                        <a href="@($"jobs/{job.Id}/edit")" class="font-semibold text-slate-900 hover:text-brand-600 transition-colors text-sm truncate max-w-xs">
                                            @job.Name
                                        </a>
                                        @if (job.Steps.Count > 0)
                                        {
                                            <span class="text-[10px] font-medium px-1.5 py-0.5 rounded bg-slate-100 text-slate-500 border border-slate-200 shrink-0">
                                                @(job.Steps.Count) ét.
                                            </span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(job.Description))
                                    {
                                        <div class="text-xs text-slate-400 truncate max-w-sm mt-0.5" title="@job.Description">
                                            @job.Description
                                        </div>
                                    }
                                </div>
                            </div>
                        </td>

                        <!-- Criticité -->
                        <td>
                            <span class="@CriticiteBadge(job.Criticite)">
                                <span class="h-1.5 w-1.5 rounded-full @CriticiteDot(job.Criticite)"></span>
                                @job.Criticite
                            </span>
                        </td>

                        <!-- État / Mode (Actif vs En Pause / Arrêt) -->
                        <td>
                            <AuthorizeView Roles="Administrateur,Developpeur" Context="authCtx">
                                <Authorized>
                                    @if (job.Enabled)
                                    {
                                        <button type="button" @onclick="() => TogglePause(job)"
                                                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100 hover:border-emerald-300 transition-all shadow-xs cursor-pointer"
                                                title="Job actif (planification en marche). Cliquer pour mettre en pause sans le supprimer.">
                                            <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                            <span>Actif</span>
                                            <svg class="h-3 w-3 text-emerald-600 opacity-60 ml-0.5" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24"><path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/></svg>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" @onclick="() => TogglePause(job)"
                                                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-300 hover:bg-amber-100 hover:border-amber-400 transition-all shadow-xs cursor-pointer"
                                                title="Job suspendu (en pause). Cliquer pour réactiver la planification automatique.">
                                            <svg class="h-3 w-3 text-amber-600" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24"><path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/></svg>
                                            <span>En pause</span>
                                            <svg class="h-3 w-3 text-amber-600 opacity-60 ml-0.5" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                                        </button>
                                    }
                                </Authorized>
                                <NotAuthorized>
                                    @if (job.Enabled)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                                            Actif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-200">
                                            En pause
                                        </span>
                                    }
                                </NotAuthorized>
                            </AuthorizeView>
                        </td>

                        <!-- Statut du dernier run -->
                        <td>
                            @if (isCurrentlyRunning)
                            {
                                <span class="kmk-badge-running animate-pulse">
                                    <svg class="animate-spin h-3 w-3 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                                    </svg>
                                    En cours...
                                </span>
                            }
                            else
                            {
                                <span class="@StatusBadge(job.LastStatus)">
                                    <span class="h-1.5 w-1.5 rounded-full @StatusDot(job.LastStatus)"></span>
                                    @FormatStatus(job.LastStatus)
                                </span>
                            }
                        </td>

                        <!-- Dernière exécution -->
                        <td class="text-xs text-slate-600">
                            @if (job.LastRunAt.HasValue)
                            {
                                <div>@job.LastRunAt.Value.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                <div class="text-[11px] text-slate-400 font-mono">@job.LastRunAt.Value.ToLocalTime().ToString("HH:mm:ss")</div>
                            }
                            else
                            {
                                <span class="text-slate-400 italic">Jamais exécuté</span>
                            }
                        </td>

                        <!-- Prochaine exécution -->
                        <td class="text-xs">
                            @if (!job.Enabled)
                            {
                                <span class="text-amber-600/90 font-medium text-[11px] flex items-center gap-1">
                                    <svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24"><path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/></svg>
                                    Suspendue
                                </span>
                            }
                            else if (job.NextRunAt.HasValue)
                            {
                                <div class="text-slate-700 font-medium">@job.NextRunAt.Value.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                <div class="text-[11px] text-slate-400 font-mono">@job.NextRunAt.Value.ToLocalTime().ToString("HH:mm:ss")</div>
                            }
                            else
                            {
                                <span class="text-slate-400">-</span>
                            }
                        </td>

                        <!-- Actions de Contrôle (Lancer / Arrêter / Pause / Détail / etc.) -->
                        <td class="text-right whitespace-nowrap pr-4">
                            <div class="flex items-center justify-end gap-1.5">
                                <AuthorizeView Roles="Administrateur,Superviseur,Exploitant" Context="ctrlCtx">
                                    <!-- Si le job tourne : bouton ARRÊTER (Stop execution sans supprimer) -->
                                    @if (isCurrentlyRunning)
                                    {
                                        <button type="button" class="kmk-btn-stop kmk-btn-sm flex items-center gap-1 animate-pulse"
                                                @onclick="() => StopJob(job)"
                                                title="Arrêter immédiatement l'exécution en cours de ce job sans le supprimer">
                                            <svg class="h-3.5 w-3.5 text-rose-700" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M5.25 5.25h13.5v13.5H5.25z" />
                                            </svg>
                                            <span>Arrêter</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <!-- Bouton LANCER -->
                                        <button type="button" class="kmk-btn-run kmk-btn-sm flex items-center gap-1"
                                                @onclick="() => RunNow(job)"
                                                title="Lancer une exécution manuelle de ce traitement">
                                            <svg class="h-3.5 w-3.5 text-emerald-700" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M8 5v14l11-7z" />
                                            </svg>
                                            <span>Lancer</span>
                                        </button>
                                    }

                                    <!-- Bouton Pause / Reprendre (Mettre en pause sans supprimer) -->
                                    @if (job.Enabled)
                                    {
                                        <button type="button" class="kmk-btn-secondary kmk-btn-sm text-amber-700 hover:text-amber-800 border-amber-200 hover:bg-amber-50"
                                                @onclick="() => TogglePause(job)"
                                                title="Mettre ce job en pause (suspend les planifications sans le supprimer)">
                                            <svg class="h-3.5 w-3.5 text-amber-600" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z" />
                                            </svg>
                                            <span class="hidden md:inline">Pause</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="kmk-btn-secondary kmk-btn-sm text-indigo-700 hover:text-indigo-800 border-indigo-200 hover:bg-indigo-50"
                                                @onclick="() => TogglePause(job)"
                                                title="Réactiver ce job (reprend les déclencheurs automatiques)">
                                            <svg class="h-3.5 w-3.5 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M8 5v14l11-7z" />
                                            </svg>
                                            <span class="hidden md:inline">Reprendre</span>
                                        </button>
                                    }
                                </AuthorizeView>

                                <!-- Détail / Édition -->
                                <a class="kmk-btn-secondary kmk-btn-sm" href="@($"jobs/{job.Id}/edit")" title="Configurer et modifier ce job">
                                    <svg class="h-3.5 w-3.5 text-slate-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                                    </svg>
                                    <span class="hidden xl:inline">Éditer</span>
                                </a>

                                <AuthorizeView Roles="Administrateur,Developpeur" Context="dupCtx">
                                    <!-- Dupliquer -->
                                    <button type="button" class="kmk-btn-secondary kmk-btn-sm" @onclick="() => DuplicateJob(job)" title="Dupliquer ce job comme nouveau modèle">
                                        <svg class="h-3.5 w-3.5 text-slate-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" />
                                        </svg>
                                    </button>

                                    <!-- Supprimer -->
                                    <button type="button" class="kmk-btn-danger kmk-btn-sm" @onclick="() => ConfirmDelete(job)" title="Supprimer définitivement ce job">
                                        <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                        </svg>
                                    </button>
                                </AuthorizeView>
                            </div>
                        </td>
                    </tr>
                }

                @if (!FilteredJobs.Any() && _jobs.Count > 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-12">
                            <div class="flex flex-col items-center justify-center text-slate-400">
                                <svg class="h-8 w-8 mb-2 text-slate-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                                </svg>
                                <p class="text-sm font-medium">Aucun job ne correspond aux critères de recherche.</p>
                                <button type="button" @onclick="ResetFilters" class="mt-2 text-xs text-brand-600 font-semibold hover:underline">
                                    Effacer les filtres
                                </button>
                            </div>
                        </td>
                    </tr>
                }

                @if (_jobs.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-16">
                            <div class="max-w-sm mx-auto flex flex-col items-center">
                                <div class="h-12 w-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center mb-3">
                                    <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                                    </svg>
                                </div>
                                <h3 class="text-base font-bold text-slate-800 mb-1">Aucun job automatisé configuré</h3>
                                <p class="text-xs text-slate-500 mb-4 text-center">
                                    Commencez par créer votre premier job pour automatiser les transferts SFTP et les flux EDI à Côte d'Ivoire Terminal.
                                </p>
                                <AuthorizeView Roles="Administrateur,Developpeur">
                                    <a class="kmk-btn-primary text-xs" href="jobs/new">
                                        + Créer un nouveau job
                                    </a>
                                </AuthorizeView>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Modal de confirmation de suppression -->
@if (_jobToDelete is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4 animate-in fade-in duration-150">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200">
            <div class="flex items-center gap-3 text-rose-600 mb-3">
                <div class="h-10 w-10 rounded-xl bg-rose-50 border border-rose-200 flex items-center justify-center shrink-0">
                    <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-base font-bold text-slate-900">Supprimer définitivement ce job ?</h3>
                    <p class="text-xs text-slate-500">Cette action est irréversible.</p>
                </div>
            </div>

            <p class="text-xs text-slate-600 mb-4 bg-slate-50 p-3 rounded-xl border border-slate-200">
                Vous êtes sur le point de supprimer le job <strong>« @_jobToDelete.Name »</strong>.
                <br /><br />
                <em>Astuce :</em> Si vous souhaitez simplement stopper son exécution automatique sans perdre la configuration, vous pouvez plutôt utiliser l'option <strong>« Mettre en pause »</strong>.
            </p>

            <div class="flex items-center justify-end gap-2.5">
                <button type="button" class="kmk-btn-secondary text-xs" @onclick="() => _jobToDelete = null">
                    Annuler
                </button>
                <button type="button" class="kmk-btn-secondary text-xs text-amber-700 border-amber-200 hover:bg-amber-50" @onclick="() => PauseInsteadOfDelete(_jobToDelete)">
                    Plutôt mettre en pause
                </button>
                <button type="button" class="kmk-btn-danger text-xs" @onclick="ExecuteDelete">
                    Oui, supprimer
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<Job> _jobs = new();
    private bool _loading = true;
    private string _filterName = "";
    private string _filterMode = "";
    private string _filterStatus = "";
    private readonly HashSet<Guid> _running = new();
    private string? _currentUser;
    private Job? _jobToDelete;
    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _timerCts;

    private IEnumerable<Job> FilteredJobs => _jobs.Where(j =>
    {
        if (!string.IsNullOrWhiteSpace(_filterName) &&
            !j.Name.Contains(_filterName, StringComparison.OrdinalIgnoreCase) &&
            !(j.Description?.Contains(_filterName, StringComparison.OrdinalIgnoreCase) ?? false))
        {
            return false;
        }

        if (_filterMode == "active" && !j.Enabled) return false;
        if (_filterMode == "paused" && j.Enabled) return false;

        if (!string.IsNullOrWhiteSpace(_filterStatus) && j.LastStatus.ToString() != _filterStatus)
        {
            return false;
        }

        return true;
    });

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        _currentUser = authState.User.Identity?.Name;
        await LoadAsync();

        // Timer de rafraîchissement temps réel toutes les 3 secondes pour suivre les arrêts et lancements
        _timerCts = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        _ = RunPeriodicRefreshAsync(_timerCts.Token);
    }

    private async Task RunPeriodicRefreshAsync(CancellationToken ct)
    {
        try
        {
            while (await _refreshTimer!.WaitForNextTickAsync(ct))
            {
                await LoadSilentAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        await LoadSilentAsync();
        _loading = false;
    }

    private async Task LoadSilentAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _jobs = await db.Jobs
            .Include(j => j.Steps)
            .OrderBy(j => j.Name)
            .ToListAsync();
    }

    private void ResetFilters()
    {
        _filterName = "";
        _filterMode = "";
        _filterStatus = "";
    }

    /// <summary>
    /// Met le job en pause ou le réactive sans le supprimer (arrête la planification).
    /// </summary>
    private async Task TogglePause(Job job)
    {
        var newEnabledState = !job.Enabled;
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Jobs.FindAsync(job.Id);
        if (entity is null) return;

        entity.Enabled = newEnabledState;
        entity.UpdatedAt = DateTime.UtcNow;
        entity.UpdatedBy = _currentUser;
        await db.SaveChangesAsync();

        job.Enabled = newEnabledState;

        await Audit.LogAsync(
            newEnabledState ? AuditAction.Activation : AuditAction.Desactivation,
            nameof(Job),
            job.Id.ToString(),
            job.Name,
            null,
            _currentUser,
            newEnabledState
                ? "Job réactivé : reprise des déclencheurs et de la surveillance"
                : "Job mis en pause : suspension des déclencheurs et de la surveillance");

        StateHasChanged();
    }

    /// <summary>
    /// Arrête immédiatement l'exécution en cours du job sans le supprimer.
    /// </summary>
    private async Task StopJob(Job job)
    {
        var stopped = ExecutionCoordinator.TryStopJob(job.Id);
        if (stopped)
        {
            await Audit.LogAsync(
                AuditAction.Annulation,
                nameof(Job),
                job.Id.ToString(),
                job.Name,
                null,
                _currentUser,
                "Demande d'arrêt immédiat de l'exécution en cours");
        }

        await Task.Delay(400);
        await LoadSilentAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Lance l'exécution manuelle du job.
    /// </summary>
    private async Task RunNow(Job job)
    {
        _running.Add(job.Id);
        StateHasChanged();
        try
        {
            await Audit.LogAsync(AuditAction.ExecutionManuelle, nameof(Job), job.Id.ToString(), job.Name, null, _currentUser);
            await JobRunner.RunAsync(job.Id, $"Manuel ({_currentUser})");
            await LoadSilentAsync();
        }
        finally
        {
            _running.Remove(job.Id);
            StateHasChanged();
        }
    }

    private async Task DuplicateJob(Job job)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var original = await db.Jobs
            .Include(j => j.Steps)
            .Include(j => j.Triggers)
            .Include(j => j.NotificationRules)
            .AsNoTracking()
            .FirstAsync(j => j.Id == job.Id);

        var copy = new Job
        {
            Name = original.Name + " (copie)",
            Description = original.Description,
            Owner = original.Owner,
            Criticite = original.Criticite,
            Enabled = false, // Par défaut une copie commence en pause
            MaxRetries = original.MaxRetries,
            RetryDelaySeconds = original.RetryDelaySeconds,
            TimeoutSeconds = original.TimeoutSeconds,
            AllowConcurrentExecution = original.AllowConcurrentExecution,
            ExecutionAccount = original.ExecutionAccount,
            CreatedBy = _currentUser,
            Steps = original.Steps.Select(s => new JobStep
            {
                Order = s.Order, Name = s.Name, Type = s.Type, ConfigJson = s.ConfigJson,
                TimeoutSeconds = s.TimeoutSeconds, MaxRetries = s.MaxRetries, RetryDelaySeconds = s.RetryDelaySeconds,
                OnErrorAction = s.OnErrorAction, OnSuccessGoToOrder = s.OnSuccessGoToOrder, OnFailureGoToOrder = s.OnFailureGoToOrder
            }).ToList(),
            Triggers = original.Triggers.Select(t => new JobTrigger
            {
                Type = t.Type, Enabled = t.Enabled, CronExpression = t.CronExpression, IntervalSeconds = t.IntervalSeconds,
                DaysOfWeekCsv = t.DaysOfWeekCsv, ExcludeWeekends = t.ExcludeWeekends, ExcludeHolidays = t.ExcludeHolidays,
                HolidayDatesCsv = t.HolidayDatesCsv, WindowStart = t.WindowStart, WindowEnd = t.WindowEnd,
                FolderPath = t.FolderPath, FolderFilter = t.FolderFilter, FolderWatchEvent = t.FolderWatchEvent
            }).ToList(),
            NotificationRules = original.NotificationRules.Select(n => new NotificationRule
            {
                Event = n.Event, Channel = n.Channel, RecipientsCsv = n.RecipientsCsv, WebhookUrl = n.WebhookUrl, Enabled = n.Enabled
            }).ToList()
        };

        db.Jobs.Add(copy);
        await db.SaveChangesAsync();
        await Audit.LogAsync(AuditAction.Creation, nameof(Job), copy.Id.ToString(), copy.Name, null, _currentUser, $"Dupliqué depuis {original.Name}");
        Nav.NavigateTo($"jobs/{copy.Id}/edit");
    }

    private void ConfirmDelete(Job job)
    {
        _jobToDelete = job;
    }

    private async Task PauseInsteadOfDelete(Job job)
    {
        _jobToDelete = null;
        if (job.Enabled)
        {
            await TogglePause(job);
        }
    }

    private async Task ExecuteDelete()
    {
        if (_jobToDelete is null) return;
        var job = _jobToDelete;
        _jobToDelete = null;

        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Jobs.FindAsync(job.Id);
        if (entity is null) return;

        db.Jobs.Remove(entity);
        await db.SaveChangesAsync();
        await Audit.LogAsync(AuditAction.Suppression, nameof(Job), job.Id.ToString(), job.Name, null, _currentUser);
        await LoadSilentAsync();
        StateHasChanged();
    }

    private static string FormatStatus(JobStatus status) => status switch
    {
        JobStatus.Succes => "Succès",
        JobStatus.Echec => "Échec",
        JobStatus.EnCours => "En cours",
        JobStatus.Annule => "Arrêté",
        JobStatus.Inactif => "Inactif",
        JobStatus.EnAttente => "En attente",
        _ => status.ToString()
    };

    private static string StatusBadge(JobStatus status) => status switch
    {
        JobStatus.Succes => "kmk-badge-success",
        JobStatus.Echec => "kmk-badge-danger",
        JobStatus.EnCours => "kmk-badge-running",
        JobStatus.Annule => "kmk-badge-neutral",
        _ => "kmk-badge-neutral"
    };

    private static string StatusDot(JobStatus status) => status switch
    {
        JobStatus.Succes => "bg-emerald-500",
        JobStatus.Echec => "bg-rose-500",
        JobStatus.EnCours => "bg-indigo-500",
        JobStatus.Annule => "bg-slate-400",
        _ => "bg-slate-400"
    };

    private static string CriticiteBadge(Criticite c) => c switch
    {
        Criticite.Critique => "kmk-badge-danger",
        Criticite.Haute => "kmk-badge-warning",
        Criticite.Moyenne => "kmk-badge-info",
        _ => "kmk-badge-neutral"
    };

    private static string CriticiteDot(Criticite c) => c switch
    {
        Criticite.Critique => "bg-red-500",
        Criticite.Haute => "bg-amber-500",
        Criticite.Moyenne => "bg-sky-500",
        _ => "bg-slate-400"
    };

    private async Task ExportJobsCsv()
    {
        var sb = new StringBuilder();
        sb.Append('\uFEFF');
        sb.AppendLine("Nom du Job;Description;Mode;Dernier Statut;Criticité;Dernière Exécution");

        foreach (var j in FilteredJobs)
        {
            var nom = EscapeCsv(j.Name);
            var desc = EscapeCsv(j.Description ?? "");
            var mode = j.Enabled ? "Actif (Planifié)" : "En pause (Suspendu)";
            var status = j.LastStatus.ToString();
            var crit = j.Criticite.ToString();
            var lastRun = j.LastRunAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "Jamais";

            sb.AppendLine($"{nom};{desc};{mode};{status};{crit};{lastRun}");
        }

        var bytes = Encoding.UTF8.GetBytes(sb.ToString());
        var base64 = Convert.ToBase64String(bytes);
        var fileName = $"jobs-cit-{DateTime.Now:yyyyMMdd-HHmm}.csv";

        await JS.InvokeVoidAsync("kernelMK.downloadFile", fileName, "text/csv;charset=utf-8", base64);
    }

    private static string EscapeCsv(string value)
    {
        if (value.Contains(';') || value.Contains('"') || value.Contains('\n') || value.Contains('\r'))
        {
            return string.Concat("\"", value.Replace("\"", "\"\""), "\"");
        }
        return value;
    }

    public void Dispose()
    {
        _timerCts?.Cancel();
        _timerCts?.Dispose();
        _refreshTimer?.Dispose();
    }
}
