@page "/backup"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrateur")]
@using KernelMK.Engine.Backup
@using KernelMK.Engine.Audit
@inject BackupService Backup
@inject AuditService Audit
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

<PageTitle>Sauvegarde &amp; restauration · kernelMK</PageTitle>

<div class="mb-6">
    <h1 class="flex items-center gap-2.5">
        <span class="h-9 w-9 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center shadow-sm">
            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 6.75-3-3m3 3 3-3M6.75 19.5a4.5 4.5 0 0 1-1.41-8.775 5.25 5.25 0 0 1 10.233-2.33 3 3 0 0 1 3.758 3.848A3.752 3.752 0 0 1 18 19.5H6.75Z" /></svg>
        </span>
        Sauvegarde &amp; restauration
    </h1>
    <p class="text-sm text-slate-500 mt-1">Section 3.1 / 5.4 / 9 du cahier des charges : sauvegarde et restauration de la configuration (jobs, déclencheurs, notifications) et du fichier de base SQLite.</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
    <div class="kmk-card flex flex-col">
        <div class="kmk-card-header">
            <span class="flex items-center gap-2">
                <span class="h-7 w-7 rounded-lg bg-sky-50 text-sky-600 flex items-center justify-center">
                    <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M7.5 3v13.5m0 0-3-3m3 3 3-3" /></svg>
                </span>
                Export de la configuration
            </span>
        </div>
        <div class="kmk-card-body flex-1 flex flex-col">
            <p class="text-sm text-slate-500 mb-4 flex-1">Télécharge tous les jobs (étapes, déclencheurs, notifications) au format JSON.</p>
            <button class="kmk-btn-primary" @onclick="ExportConfigAsync">Exporter la configuration</button>
        </div>
    </div>

    <div class="kmk-card flex flex-col">
        <div class="kmk-card-header">
            <span class="flex items-center gap-2">
                <span class="h-7 w-7 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center">
                    <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" /></svg>
                </span>
                Import de configuration
            </span>
        </div>
        <div class="kmk-card-body flex-1 flex flex-col">
            <p class="text-sm text-slate-500 mb-4 flex-1">Recharge un export JSON précédent (utile pour dupliquer vers un autre serveur).</p>
            <InputFile OnChange="ImportConfigAsync" class="text-sm" />
            @if (!string.IsNullOrEmpty(_importMessage))
            {
                <p class="text-sm text-emerald-700 mt-3 font-medium">✓ @_importMessage</p>
            }
        </div>
    </div>

    <div class="kmk-card flex flex-col">
        <div class="kmk-card-header">
            <span class="flex items-center gap-2">
                <span class="h-7 w-7 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
                    <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 3.375c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" /></svg>
                </span>
                Base de données
            </span>
        </div>
        <div class="kmk-card-body flex-1 flex flex-col">
            <p class="text-sm text-slate-500 mb-4 flex-1">Copie complète horodatée du fichier SQLite (jobs, historique, utilisateurs).</p>
            <button class="kmk-btn-secondary" @onclick="BackupDatabaseAsync">Sauvegarder maintenant</button>
            @if (!string.IsNullOrEmpty(_backupPath))
            {
                <p class="text-xs text-slate-600 mt-3 break-all">Créée : <code class="bg-slate-100 rounded px-1.5 py-0.5">@_backupPath</code></p>
            }
        </div>
    </div>
</div>

@code {
    private string? _importMessage;
    private string? _backupPath;
    private string? _currentUser;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        _currentUser = authState.User.Identity?.Name;
    }

    private async Task ExportConfigAsync()
    {
        var json = await Backup.ExportConfigurationAsync();
        await Audit.LogAsync(AuditAction.ExportRapport, "Configuration", null, null, null, _currentUser, "Export de la configuration des jobs");
        var bytes = System.Text.Encoding.UTF8.GetBytes(json);
        await JS.InvokeVoidAsync("kernelMK.downloadFile", $"configuration_{DateTime.Now:yyyyMMdd_HHmmss}.json", "application/json", Convert.ToBase64String(bytes));
    }

    private async Task ImportConfigAsync(InputFileChangeEventArgs e)
    {
        using var reader = new StreamReader(e.File.OpenReadStream(maxAllowedSize: 20_000_000));
        var json = await reader.ReadToEndAsync();
        var count = await Backup.ImportConfigurationAsync(json, _currentUser);
        await Audit.LogAsync(AuditAction.Restauration, "Configuration", null, null, null, _currentUser, $"{count} job(s) importé(s)");
        _importMessage = $"{count} job(s) importé(s) avec succès.";
    }

    private async Task BackupDatabaseAsync()
    {
        _backupPath = Backup.BackupDatabaseFile();
        await Audit.LogAsync(AuditAction.Sauvegarde, "Base de données", null, null, null, _currentUser, _backupPath);
    }
}
