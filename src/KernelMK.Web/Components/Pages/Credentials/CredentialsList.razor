@page "/credentials"
@page "/credentials/new"
@page "/credentials/add"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrateur,Developpeur")]
@using Microsoft.EntityFrameworkCore
@using KernelMK.Data.Security
@using KernelMK.Engine.Audit
@using KernelMK.Engine.Execution
@inject IDbContextFactory<AppDbContext> DbFactory
@inject CredentialProtector Protector
@inject AuditService Audit
@inject AuthenticationStateProvider AuthState
@inject ConnectionTestService TestService

<PageTitle>Credentials · kernelMK</PageTitle>

<h1 class="mb-6">Coffre-fort de credentials</h1>

<div class="kmk-card mb-6">
    <div class="kmk-card-body">
        <EditForm Model="_newCredential" OnValidSubmit="AddAsync">
            <div class="grid grid-cols-2 sm:grid-cols-7 gap-3 items-end">
                <div><label class="kmk-label">Nom</label><InputText class="kmk-input" @bind-Value="_newCredential.Name" /></div>
                <div>
                    <label class="kmk-label">Type</label>
                    <InputSelect class="kmk-select" @bind-Value="_newCredential.Type" @bind-Value:after="OnNewTypeChanged">
                        @foreach (var t in Enum.GetValues<CredentialType>())
                        {
                            <option value="@t">@t</option>
                        }
                    </InputSelect>
                </div>
                <div><label class="kmk-label">Utilisateur</label><InputText class="kmk-input" @bind-Value="_newCredential.Username" /></div>
                <div><label class="kmk-label">Hôte</label><InputText class="kmk-input" placeholder="sftp.exemple.fr" @bind-Value="_newCredential.Host" /></div>
                <div><label class="kmk-label">Port</label><InputNumber class="kmk-input" placeholder="22" @bind-Value="_newCredential.Port" /></div>
                <div>
                    <label class="kmk-label">Authentification</label>
                    <InputSelect class="kmk-select" @bind-Value="_newCredential.AuthType">
                        <option value="@CredentialAuthType.MotDePasse">Mot de passe</option>
                        @if (_newCredential.Type == CredentialType.FtpSftp)
                        {
                            <option value="@CredentialAuthType.ClePriveeSsh">Clé privée SSH (SFTP)</option>
                        }
                        @if (_newCredential.Type == CredentialType.Smtp || _newCredential.Type == CredentialType.ImapEmail)
                        {
                            <option value="@CredentialAuthType.OAuth2Microsoft365">OAuth2 Microsoft 365</option>
                        }
                    </InputSelect>
                    @if (_newCredential.Type != CredentialType.FtpSftp && _newCredential.AuthType != CredentialAuthType.OAuth2Microsoft365)
                    {
                        <p class="text-[11px] text-slate-400 mt-1">La clé SSH n'existe que pour le protocole SSH/SFTP ; les autres types (réseau local, base de données...) s'authentifient par mot de passe.</p>
                    }
                </div>
                <div><button type="submit" class="kmk-btn-primary w-full">Ajouter</button></div>

                @if (_newCredential.AuthType == CredentialAuthType.ClePriveeSsh)
                {
                    <div class="col-span-2 sm:col-span-4">
                        <label class="kmk-label">Clé privée SSH (format PEM, ex: -----BEGIN OPENSSH PRIVATE KEY-----...)</label>
                        <InputTextArea class="kmk-input font-mono text-xs" rows="3" @bind-Value="_plainSecret" placeholder="-----BEGIN OPENSSH PRIVATE KEY-----&#10;...&#10;-----END OPENSSH PRIVATE KEY-----" />
                    </div>
                    <div class="col-span-2 sm:col-span-3">
                        <label class="kmk-label">Passphrase de la clé <span class="text-slate-400 font-normal text-[11px]">(facultatif)</span></label>
                        <div class="kmk-password-wrapper">
                            <InputText type="password" class="kmk-input" @bind-Value="_newPassphrase" />
                            <button type="button" class="kmk-password-toggle" data-kmk-action="toggle-password" aria-label="Afficher la passphrase" tabindex="-1">
                                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                            </button>
                        </div>
                    </div>
                }
                else if (_newCredential.AuthType == CredentialAuthType.OAuth2Microsoft365)
                {
                    <div>
                        <label class="kmk-label">Id d'application (ClientId)</label>
                        <InputText class="kmk-input font-mono text-xs" @bind-Value="_newCredential.OAuth2ClientId" placeholder="ex: 3fa2b1c4-..." />
                    </div>
                    <div>
                        <label class="kmk-label">Id de tenant (TenantId)</label>
                        <InputText class="kmk-input font-mono text-xs" @bind-Value="_newCredential.OAuth2TenantId" placeholder="ex: 8e4d5f2a-..." />
                    </div>
                    <div class="col-span-2 sm:col-span-3">
                        <label class="kmk-label">Client secret</label>
                        <div class="kmk-password-wrapper">
                            <InputText type="password" class="kmk-input" @bind-Value="_plainSecret" />
                            <button type="button" class="kmk-password-toggle" data-kmk-action="toggle-password" aria-label="Afficher le secret" tabindex="-1">
                                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                            </button>
                        </div>
                    </div>
                    <div class="col-span-2 sm:col-span-7">
                        <p class="text-[11px] text-slate-400">Nécessite une application enregistrée dans Entra ID (Azure AD) avec l'autorisation d'application "IMAP.AccessAsApp" / "SMTP.SendAsApp" (API Office 365 Exchange Online) consentie par un administrateur du tenant, plus une politique d'authentification autorisant OAuth pour la boîte mail utilisée (champ "Utilisateur" ci-dessus).</p>
                    </div>
                }
                else
                {
                    <div class="col-span-2 sm:col-span-4">
                        <label class="kmk-label">Secret (mot de passe)</label>
                        <div class="kmk-password-wrapper">
                            <InputText type="password" class="kmk-input" @bind-Value="_plainSecret" />
                            <button type="button" class="kmk-password-toggle" data-kmk-action="toggle-password" aria-label="Afficher le mot de passe" tabindex="-1">
                                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </EditForm>
    </div>
</div>

@if (_loading)
{
    <p class="text-sm text-slate-500">Chargement...</p>
}
else
{
    <div class="kmk-card p-3.5 mb-4">
        <input class="kmk-input !py-2 text-xs max-w-sm" placeholder="Rechercher par nom, hôte ou utilisateur..."
               @bind="_searchQuery" @bind:event="oninput" @bind:after="() => _page = 1" />
    </div>
    <div class="kmk-table-container">
        <table class="kmk-table">
            <thead>
                <tr>
                    <th class="min-w-[160px]">Nom</th>
                    <th class="min-w-[120px]">Type</th>
                    <th class="min-w-[140px]">Utilisateur</th>
                    <th class="min-w-[180px]">Hôte : Port</th>
                    <th class="min-w-[140px]">Créé le</th>
                    <th class="text-right min-w-[160px] pr-5">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in PagedCredentials)
                {
                    <tr>
                        <td class="font-medium">@c.Name</td>
                        <td class="text-slate-500">
                            @c.Type
                            @if (c.AuthType == CredentialAuthType.ClePriveeSsh)
                            {
                                <span class="kmk-badge kmk-badge-info text-[10px] ml-1">🔑 Clé SSH</span>
                            }
                        </td>
                        <td class="text-slate-500">@c.Username</td>
                        <td class="text-slate-500">@c.Host@if (c.Port is > 0) { <span class="text-slate-400">:@c.Port</span> }</td>
                        <td class="text-slate-500">@c.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td class="text-right space-x-2 whitespace-nowrap">
                            @if (!string.IsNullOrWhiteSpace(c.Host))
                            {
                                @if (c.Type == CredentialType.BaseDeDonnees)
                                {
                                    <input class="kmk-input !py-1 !text-[11px] !w-40 inline-block align-middle" placeholder="Nom de la base (obligatoire)"
                                           value="@GetTestPath(c.Id)" @oninput="e => _testPaths[c.Id] = e.Value?.ToString() ?? string.Empty" />
                                }
                                else if (c.Type != CredentialType.FtpSftp && c.Type != CredentialType.ImapEmail && c.Type != CredentialType.Smtp && c.Type != CredentialType.ApiKey && c.AuthType != CredentialAuthType.ClePriveeSsh)
                                {
                                    <input class="kmk-input !py-1 !text-[11px] !w-40 inline-block align-middle" placeholder="\\serveur\partage (facultatif)"
                                           value="@GetTestPath(c.Id)" @oninput="e => _testPaths[c.Id] = e.Value?.ToString() ?? string.Empty" />
                                }
                                <button class="kmk-btn-secondary kmk-btn-sm" disabled="@_testingCreds.Contains(c.Id)" @onclick="() => TestCredAsync(c)"
                                        title="@GetTestButtonTitle(c)">
                                    @if (_testingCreds.Contains(c.Id)) { <span>Test...</span> } else { <span>Tester</span> }
                                </button>
                            }
                            <button type="button" class="kmk-btn-secondary kmk-btn-sm" @onclick="() => StartEdit(c)">
                                <svg class="h-3.5 w-3.5 mr-1 text-slate-500 inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                                </svg>
                                <span>Modifier</span>
                            </button>
                            <button class="kmk-btn-danger kmk-btn-sm" @onclick="() => DeleteAsync(c)">Supprimer</button>
                        </td>
                    </tr>
                    @if (_credTestResults.TryGetValue(c.Id, out var res) && res is not null)
                    {
                        <tr class="bg-slate-50/70">
                            <td colspan="6" class="py-2 px-4">
                                @if (res.Success)
                                {
                                    <div class="text-xs text-emerald-700 font-medium flex items-center gap-1.5">
                                        <span class="font-bold">✓</span> @res.Message @(!string.IsNullOrWhiteSpace(res.WorkingDirectory) ? $"({res.WorkingDirectory})" : "")
                                    </div>
                                }
                                else
                                {
                                    <div class="text-xs text-red-700 font-medium flex items-center gap-1.5">
                                        <span class="font-bold">✗</span> Échec : @res.Message
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
                @if (FilteredCredentials.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-slate-400 py-8">Aucun credential ne correspond.</td></tr>
                }
            </tbody>
        </table>
        <Pagination @bind-CurrentPage="_page" @bind-PageSize="_pageSize" TotalItems="FilteredCredentials.Count" />
    </div>

    @if (_editingCredential != null)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-xs">
            <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full p-6 border border-slate-200">
                <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-5">
                    <div class="flex items-center gap-2.5">
                        <div class="h-9 w-9 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center border border-indigo-100">
                            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-base font-bold text-slate-900">Modifier le credential</h3>
                            <p class="text-xs text-slate-500">Mettez à jour les paramètres de connexion ou changez le mot de passe.</p>
                        </div>
                    </div>
                    <button type="button" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg hover:bg-slate-100" @onclick="CancelEdit">
                        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                    </button>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="kmk-label">Nom du credential</label>
                        <input class="kmk-input" @bind="_editingCredential.Name" placeholder="ex: GESTMAM" />
                    </div>
                    <div>
                        <label class="kmk-label">Type</label>
                        <select class="kmk-select" @bind="_editingCredential.Type" @bind:after="OnEditTypeChanged">
                            @foreach (var t in Enum.GetValues<CredentialType>())
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="kmk-label">Nom d'utilisateur / Identifiant</label>
                        <input class="kmk-input" @bind="_editingCredential.Username" placeholder="ex: admin" />
                    </div>
                    <div>
                        <label class="kmk-label">Hôte / Serveur</label>
                        <input class="kmk-input" @bind="_editingCredential.Host" placeholder="ex: sftp.cit.ci ou 192.168.1.50" />
                    </div>
                    <div>
                        <label class="kmk-label">Port</label>
                        <input type="number" class="kmk-input" @bind="_editingCredential.Port" placeholder="ex: 22 (SFTP) ou 21 (FTP)" />
                    </div>
                    <div>
                        <label class="kmk-label">Authentification</label>
                        <select class="kmk-select" @bind="_editingCredential.AuthType">
                            <option value="@CredentialAuthType.MotDePasse">Mot de passe</option>
                            @if (_editingCredential.Type == CredentialType.FtpSftp)
                            {
                                <option value="@CredentialAuthType.ClePriveeSsh">Clé privée SSH (SFTP)</option>
                            }
                            @if (_editingCredential.Type == CredentialType.Smtp || _editingCredential.Type == CredentialType.ImapEmail)
                            {
                                <option value="@CredentialAuthType.OAuth2Microsoft365">OAuth2 Microsoft 365</option>
                            }
                        </select>
                        @if (_editingCredential.Type != CredentialType.FtpSftp && _editingCredential.AuthType != CredentialAuthType.OAuth2Microsoft365)
                        {
                            <p class="text-[11px] text-slate-400 mt-1">La clé SSH n'existe que pour le protocole SSH/SFTP.</p>
                        }
                    </div>
                    @if (_editingCredential.AuthType == CredentialAuthType.OAuth2Microsoft365)
                    {
                        <div>
                            <label class="kmk-label">Id d'application (ClientId)</label>
                            <input class="kmk-input font-mono text-xs" @bind="_editingCredential.OAuth2ClientId" placeholder="ex: 3fa2b1c4-..." />
                        </div>
                        <div>
                            <label class="kmk-label">Id de tenant (TenantId)</label>
                            <input class="kmk-input font-mono text-xs" @bind="_editingCredential.OAuth2TenantId" placeholder="ex: 8e4d5f2a-..." />
                        </div>
                    }
                    <div class="sm:col-span-2">
                        <label class="kmk-label">
                            Rôles autorisés à utiliser ce credential
                            <span class="text-slate-400 font-normal text-[11px] ml-1">(tous cochés = aucune restriction)</span>
                        </label>
                        <div class="flex flex-wrap gap-3 mt-1">
                            @foreach (var role in Enum.GetValues<AppRole>())
                            {
                                <label class="flex items-center gap-1.5 text-xs text-slate-600 cursor-pointer select-none">
                                    <input type="checkbox" class="kmk-checkbox" checked="@_editAllowedRoles.Contains(role)"
                                           @onchange="e => ToggleEditRole(role, (bool)e.Value!)" />
                                    @role
                                </label>
                            }
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1">
                            Restreint uniquement la visibilité/sélection de ce credential dans l'Explorateur distant et l'édition
                            des jobs — sans effet sur l'exécution automatique des jobs déjà planifiés.
                        </p>
                    </div>
                    @if (_editingCredential.AuthType == CredentialAuthType.ClePriveeSsh)
                    {
                        <div class="sm:col-span-2">
                            <label class="kmk-label">
                                Clé privée SSH (PEM)
                                <span class="text-slate-400 font-normal text-[11px] ml-1">(inchangée si vide)</span>
                            </label>
                            <textarea class="kmk-input font-mono text-xs" rows="3" @bind="_editPlainSecret" placeholder="•••••••• (inchangée) ou collez une nouvelle clé -----BEGIN OPENSSH PRIVATE KEY-----..."></textarea>
                        </div>
                        <div>
                            <label class="kmk-label">
                                Passphrase de la clé
                                <span class="text-slate-400 font-normal text-[11px] ml-1">(inchangée si vide)</span>
                            </label>
                            <div class="kmk-password-wrapper">
                                <input type="password" class="kmk-input" @bind="_editPassphrase" placeholder="•••••••• (inchangée)" />
                                <button type="button" class="kmk-password-toggle" data-kmk-action="toggle-password" aria-label="Afficher la passphrase" tabindex="-1">
                                    <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div>
                            <label class="kmk-label">
                                @(_editingCredential.AuthType == CredentialAuthType.OAuth2Microsoft365 ? "Client secret" : "Secret (mot de passe)")
                                <span class="text-slate-400 font-normal text-[11px] ml-1">(inchangé si vide)</span>
                            </label>
                            <div class="kmk-password-wrapper">
                                <input type="password" class="kmk-input" @bind="_editPlainSecret" placeholder="•••••••• (inchangé)" />
                                <button type="button" class="kmk-password-toggle" data-kmk-action="toggle-password" aria-label="Afficher le mot de passe" tabindex="-1">
                                    <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                                </button>
                            </div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_editMessage))
                {
                    <div class="mt-4 p-3 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-700">
                        @_editMessage
                    </div>
                }

                <div class="flex items-center justify-end gap-3 mt-6 pt-4 border-t border-slate-100">
                    <button type="button" class="kmk-btn-secondary text-xs" @onclick="CancelEdit">Annuler</button>
                    <button type="button" class="kmk-btn-primary text-xs" @onclick="SaveEditAsync">💾 Enregistrer les modifications</button>
                </div>
            </div>
        </div>
    }
}

@code {
    private List<Credential> _credentials = new();
    private bool _loading = true;
    private string _searchQuery = "";
    private int _page = 1;
    private int _pageSize = 10;

    private List<Credential> FilteredCredentials => string.IsNullOrWhiteSpace(_searchQuery)
        ? _credentials
        : _credentials.Where(c =>
            (c.Name?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (c.Host?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (c.Username?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();

    private IEnumerable<Credential> PagedCredentials => FilteredCredentials.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private Credential _newCredential = new();
    private string _plainSecret = "";
    private string _newPassphrase = "";
    private string? _currentUser;
    private readonly HashSet<Guid> _testingCreds = new();
    private readonly Dictionary<Guid, ConnectionTestResult> _credTestResults = new();
    private readonly Dictionary<Guid, string> _testPaths = new();

    private string GetTestPath(Guid id) => _testPaths.GetValueOrDefault(id, "");

    private static string GetTestButtonTitle(Credential c) => c.Type switch
    {
        CredentialType.FtpSftp => "Tester la connexion SFTP/FTP",
        CredentialType.ImapEmail => "Tester la connexion et l'authentification IMAP",
        CredentialType.Smtp => "Tester la connexion et l'authentification SMTP (sans envoyer d'email)",
        CredentialType.BaseDeDonnees => "Tester la connexion SQL Server (nom de base requis ci-contre)",
        CredentialType.ApiKey => "Une clé API ne peut pas être testée isolément — utilisez-la dans une étape Webhook",
        _ => "Tester l'authentification réseau (SMB), et l'accès au dossier si un chemin est précisé"
    };

    private Credential? _editingCredential;
    private string _editPlainSecret = "";
    private string _editPassphrase = "";
    private string? _editMessage;
    private readonly HashSet<AppRole> _editAllowedRoles = new();

    private void ToggleEditRole(AppRole role, bool isChecked)
    {
        if (isChecked) _editAllowedRoles.Add(role);
        else _editAllowedRoles.Remove(role);
    }

    private void OnNewTypeChanged()
    {
        if (_newCredential.Type != CredentialType.FtpSftp && _newCredential.AuthType == CredentialAuthType.ClePriveeSsh)
        {
            _newCredential.AuthType = CredentialAuthType.MotDePasse;
        }
        if (_newCredential.Type != CredentialType.Smtp && _newCredential.Type != CredentialType.ImapEmail && _newCredential.AuthType == CredentialAuthType.OAuth2Microsoft365)
        {
            _newCredential.AuthType = CredentialAuthType.MotDePasse;
        }
    }

    private void OnEditTypeChanged()
    {
        if (_editingCredential is null) return;
        if (_editingCredential.Type != CredentialType.FtpSftp && _editingCredential.AuthType == CredentialAuthType.ClePriveeSsh)
        {
            _editingCredential.AuthType = CredentialAuthType.MotDePasse;
        }
        if (_editingCredential.Type != CredentialType.Smtp && _editingCredential.Type != CredentialType.ImapEmail && _editingCredential.AuthType == CredentialAuthType.OAuth2Microsoft365)
        {
            _editingCredential.AuthType = CredentialAuthType.MotDePasse;
        }
    }

    private void StartEdit(Credential c)
    {
        _editingCredential = new Credential
        {
            Id = c.Id,
            Name = c.Name,
            Description = c.Description,
            Type = c.Type,
            Username = c.Username,
            Host = c.Host,
            Port = c.Port,
            CreatedAt = c.CreatedAt,
            CreatedBy = c.CreatedBy,
            EncryptedSecret = c.EncryptedSecret,
            AuthType = c.AuthType,
            EncryptedPassphrase = c.EncryptedPassphrase,
            AllowedRolesCsv = c.AllowedRolesCsv,
            OAuth2ClientId = c.OAuth2ClientId,
            OAuth2TenantId = c.OAuth2TenantId
        };
        _editPlainSecret = "";
        _editPassphrase = "";
        _editMessage = null;

        _editAllowedRoles.Clear();
        var restricted = (c.AllowedRolesCsv ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(r => Enum.TryParse<AppRole>(r, out var parsed) ? parsed : (AppRole?)null)
            .Where(r => r.HasValue)
            .Select(r => r!.Value)
            .ToList();

        // CSV vide (comportement historique) = aucune restriction : toutes les cases partent cochées.
        foreach (var role in restricted.Count > 0 ? restricted : Enum.GetValues<AppRole>().ToList())
        {
            _editAllowedRoles.Add(role);
        }
    }

    private void CancelEdit()
    {
        _editingCredential = null;
        _editPlainSecret = "";
        _editPassphrase = "";
        _editMessage = null;
    }

    private async Task SaveEditAsync()
    {
        if (_editingCredential is null) return;
        if (string.IsNullOrWhiteSpace(_editingCredential.Name))
        {
            _editMessage = "Le nom du credential est obligatoire.";
            return;
        }
        if (_editAllowedRoles.Count == 0)
        {
            _editMessage = "Sélectionne au moins un rôle autorisé (ou tous, pour ne restreindre personne).";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Credentials.FindAsync(_editingCredential.Id);
        if (entity is null)
        {
            _editMessage = "Credential introuvable en base.";
            return;
        }

        entity.Name = _editingCredential.Name.Trim();
        entity.Type = _editingCredential.Type;
        entity.Username = string.IsNullOrWhiteSpace(_editingCredential.Username) ? null : _editingCredential.Username.Trim();
        entity.Host = string.IsNullOrWhiteSpace(_editingCredential.Host) ? null : _editingCredential.Host.Trim();
        entity.Port = _editingCredential.Port;
        entity.AuthType = _editingCredential.AuthType;
        entity.OAuth2ClientId = string.IsNullOrWhiteSpace(_editingCredential.OAuth2ClientId) ? null : _editingCredential.OAuth2ClientId.Trim();
        entity.OAuth2TenantId = string.IsNullOrWhiteSpace(_editingCredential.OAuth2TenantId) ? null : _editingCredential.OAuth2TenantId.Trim();

        // Toutes les cases cochées = aucune restriction (équivalent au comportement historique, stocké comme null).
        var allAppRoles = Enum.GetValues<AppRole>();
        entity.AllowedRolesCsv = _editAllowedRoles.Count == allAppRoles.Length
            ? null
            : string.Join(',', _editAllowedRoles);

        if (!string.IsNullOrWhiteSpace(_editPlainSecret))
        {
            entity.EncryptedSecret = Protector.Protect(_editPlainSecret);
        }
        if (!string.IsNullOrWhiteSpace(_editPassphrase))
        {
            entity.EncryptedPassphrase = Protector.Protect(_editPassphrase);
        }
        if (entity.AuthType == CredentialAuthType.MotDePasse)
        {
            entity.EncryptedPassphrase = null;
        }

        await db.SaveChangesAsync();
        await Audit.LogAsync(AuditAction.Modification, nameof(Credential), entity.Id.ToString(), entity.Name, null, _currentUser);

        _editingCredential = null;
        _editPlainSecret = "";
        _editMessage = null;
        await LoadAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        _currentUser = authState.User.Identity?.Name;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        _credentials = await db.Credentials.OrderBy(c => c.Name).ToListAsync();
        _loading = false;
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(_newCredential.Name) || string.IsNullOrWhiteSpace(_plainSecret)) return;

        _newCredential.EncryptedSecret = Protector.Protect(_plainSecret);
        _newCredential.EncryptedPassphrase = string.IsNullOrWhiteSpace(_newPassphrase) ? null : Protector.Protect(_newPassphrase);
        _newCredential.CreatedBy = _currentUser;

        await using var db = await DbFactory.CreateDbContextAsync();
        db.Credentials.Add(_newCredential);
        await db.SaveChangesAsync();
        await Audit.LogAsync(AuditAction.Creation, nameof(Credential), _newCredential.Id.ToString(), _newCredential.Name, null, _currentUser);

        _newCredential = new Credential();
        _plainSecret = "";
        _newPassphrase = "";
        await LoadAsync();
    }

    private async Task DeleteAsync(Credential c)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Credentials.FindAsync(c.Id);
        if (entity is null) return;
        db.Credentials.Remove(entity);
        await db.SaveChangesAsync();
        await Audit.LogAsync(AuditAction.Suppression, nameof(Credential), c.Id.ToString(), c.Name, null, _currentUser);
        await LoadAsync();
    }

    private async Task TestCredAsync(Credential c)
    {
        if (string.IsNullOrWhiteSpace(c.Host)) return;

        _testingCreds.Add(c.Id);
        StateHasChanged();

        try
        {
            if (c.Type == CredentialType.FtpSftp)
            {
                var secret = Protector.Unprotect(c.EncryptedSecret);
                var passphrase = string.IsNullOrEmpty(c.EncryptedPassphrase) ? null : Protector.Unprotect(c.EncryptedPassphrase);
                var port = c.Port is > 0 ? c.Port.Value : 22;
                var stepType = port == 21 ? StepType.TransfertFtp : StepType.TransfertSftp;

                _credTestResults[c.Id] = await TestService.TestConnectionAsync(stepType, c.Host, port, c.Username, secret, authType: c.AuthType, passphrase: passphrase);
            }
            else if (c.Type == CredentialType.ImapEmail)
            {
                var secret = Protector.Unprotect(c.EncryptedSecret);
                var port = c.Port is > 0 ? c.Port.Value : 993;
                _credTestResults[c.Id] = await TestService.TestImapAccountAsync(c.Host, port, c.Username, secret, c.AuthType, c.OAuth2ClientId, c.OAuth2TenantId);
            }
            else if (c.Type == CredentialType.Smtp)
            {
                var secret = Protector.Unprotect(c.EncryptedSecret);
                var port = c.Port is > 0 ? c.Port.Value : 587;
                _credTestResults[c.Id] = await TestService.TestSmtpAccountAsync(c.Host, port, c.Username, secret, useTls: true, c.AuthType, c.OAuth2ClientId, c.OAuth2TenantId);
            }
            else if (c.Type == CredentialType.BaseDeDonnees)
            {
                var secret = Protector.Unprotect(c.EncryptedSecret);
                var database = _testPaths.GetValueOrDefault(c.Id);
                _credTestResults[c.Id] = await TestService.TestDatabaseAccountAsync(c.Host, c.Port, c.Username, secret, database);
            }
            else if (c.Type == CredentialType.ApiKey)
            {
                // Une clé API seule n'a pas de serveur à joindre pour un "test de connexion" au sens propre —
                // sa validité se vérifie en l'utilisant réellement (étape Webhook, qui l'injecte automatiquement
                // dans l'en-tête Authorization). On l'indique clairement plutôt que de tenter un test SMB absurde.
                _credTestResults[c.Id] = ConnectionTestResult.Fail("Une clé API ne peut pas être testée isolément (pas de serveur cible) — utilisez-la dans une étape Webhook pour la valider en conditions réelles.");
            }
            else if (c.AuthType == CredentialAuthType.ClePriveeSsh)
            {
                // L'authentification SMB Windows exige un mot de passe classique ; une clé privée SSH y serait rejetée.
                _credTestResults[c.Id] = ConnectionTestResult.Fail("Ce credential est configuré en clé privée SSH — incompatible avec un test d'authentification réseau (SMB), qui exige un mot de passe.");
            }
            else
            {
                // Compte destiné à un accès réseau local (SMB) : on ne connaît pas de partage précis ici,
                // on valide uniquement que le compte s'authentifie sur le serveur (voir TestSmbAccountAsync).
                var secret = Protector.Unprotect(c.EncryptedSecret);
                var sharePath = _testPaths.GetValueOrDefault(c.Id);
                _credTestResults[c.Id] = await TestService.TestSmbAccountAsync(c.Host, c.Username, secret, sharePath);
            }
        }
        catch (Exception ex)
        {
            _credTestResults[c.Id] = ConnectionTestResult.Fail($"Erreur : {ex.Message}");
        }
        finally
        {
            _testingCreds.Remove(c.Id);
            StateHasChanged();
        }
    }
}
