@page "/credentials"
@page "/credentials/new"
@page "/credentials/add"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrateur,Developpeur")]
@using Microsoft.EntityFrameworkCore
@using KernelMK.Data.Security
@using KernelMK.Engine.Audit
@using KernelMK.Engine.Execution
@inject IDbContextFactory<AppDbContext> DbFactory
@inject CredentialProtector Protector
@inject AuditService Audit
@inject AuthenticationStateProvider AuthState
@inject ConnectionTestService TestService

<PageTitle>Credentials · kernelMK</PageTitle>

<h1>Coffre-fort de credentials</h1>
<p class="text-sm text-slate-500 mt-1 mb-6">Les secrets sont chiffrés (ASP.NET Data Protection) avant stockage — jamais affichés en clair après création.</p>

<div class="kmk-card mb-6">
    <div class="kmk-card-body">
        <EditForm Model="_newCredential" OnValidSubmit="AddAsync">
            <div class="grid grid-cols-2 sm:grid-cols-7 gap-3 items-end">
                <div><label class="kmk-label">Nom</label><InputText class="kmk-input" @bind-Value="_newCredential.Name" /></div>
                <div>
                    <label class="kmk-label">Type</label>
                    <InputSelect class="kmk-select" @bind-Value="_newCredential.Type">
                        @foreach (var t in Enum.GetValues<CredentialType>())
                        {
                            <option value="@t">@t</option>
                        }
                    </InputSelect>
                </div>
                <div><label class="kmk-label">Utilisateur</label><InputText class="kmk-input" @bind-Value="_newCredential.Username" /></div>
                <div><label class="kmk-label">Hôte</label><InputText class="kmk-input" placeholder="sftp.exemple.fr" @bind-Value="_newCredential.Host" /></div>
                <div><label class="kmk-label">Port</label><InputNumber class="kmk-input" placeholder="22" @bind-Value="_newCredential.Port" /></div>
                <div>
                    <label class="kmk-label">Authentification</label>
                    <InputSelect class="kmk-select" @bind-Value="_newCredential.AuthType">
                        <option value="@CredentialAuthType.MotDePasse">Mot de passe</option>
                        <option value="@CredentialAuthType.ClePriveeSsh">Clé privée SSH (SFTP)</option>
                    </InputSelect>
                </div>
                <div><button type="submit" class="kmk-btn-primary w-full">Ajouter</button></div>

                @if (_newCredential.AuthType == CredentialAuthType.ClePriveeSsh)
                {
                    <div class="col-span-2 sm:col-span-4">
                        <label class="kmk-label">Clé privée SSH (format PEM, ex: -----BEGIN OPENSSH PRIVATE KEY-----...)</label>
                        <InputTextArea class="kmk-input font-mono text-xs" rows="3" @bind-Value="_plainSecret" placeholder="-----BEGIN OPENSSH PRIVATE KEY-----&#10;...&#10;-----END OPENSSH PRIVATE KEY-----" />
                    </div>
                    <div class="col-span-2 sm:col-span-3">
                        <label class="kmk-label">Passphrase de la clé <span class="text-slate-400 font-normal text-[11px]">(facultatif)</span></label>
                        <div class="kmk-password-wrapper">
                            <InputText type="password" class="kmk-input" @bind-Value="_newPassphrase" />
                            <button type="button" class="kmk-password-toggle" onclick="kernelMK.togglePasswordVisibility(this)" aria-label="Afficher la passphrase" tabindex="-1">
                                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-span-2 sm:col-span-4">
                        <label class="kmk-label">Secret (mot de passe)</label>
                        <div class="kmk-password-wrapper">
                            <InputText type="password" class="kmk-input" @bind-Value="_plainSecret" />
                            <button type="button" class="kmk-password-toggle" onclick="kernelMK.togglePasswordVisibility(this)" aria-label="Afficher le mot de passe" tabindex="-1">
                                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </EditForm>
    </div>
</div>

@if (_loading)
{
    <p class="text-sm text-slate-500">Chargement...</p>
}
else
{
    <div class="kmk-table-container">
        <table class="kmk-table">
            <thead>
                <tr>
                    <th class="min-w-[160px]">Nom</th>
                    <th class="min-w-[120px]">Type</th>
                    <th class="min-w-[140px]">Utilisateur</th>
                    <th class="min-w-[180px]">Hôte : Port</th>
                    <th class="min-w-[140px]">Créé le</th>
                    <th class="text-right min-w-[160px] pr-5">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in _credentials)
                {
                    <tr>
                        <td class="font-medium">@c.Name</td>
                        <td class="text-slate-500">
                            @c.Type
                            @if (c.AuthType == CredentialAuthType.ClePriveeSsh)
                            {
                                <span class="kmk-badge kmk-badge-info text-[10px] ml-1">🔑 Clé SSH</span>
                            }
                        </td>
                        <td class="text-slate-500">@c.Username</td>
                        <td class="text-slate-500">@c.Host@if (c.Port is > 0) { <span class="text-slate-400">:@c.Port</span> }</td>
                        <td class="text-slate-500">@c.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td class="text-right space-x-2 whitespace-nowrap">
                            @if (c.Type == CredentialType.FtpSftp && !string.IsNullOrWhiteSpace(c.Host))
                            {
                                <button class="kmk-btn-secondary kmk-btn-sm" disabled="@_testingCreds.Contains(c.Id)" @onclick="() => TestCredAsync(c)">
                                    @if (_testingCreds.Contains(c.Id)) { <span>Test...</span> } else { <span>Tester</span> }
                                </button>
                            }
                            <button type="button" class="kmk-btn-secondary kmk-btn-sm" @onclick="() => StartEdit(c)">
                                <svg class="h-3.5 w-3.5 mr-1 text-slate-500 inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                                </svg>
                                <span>Modifier</span>
                            </button>
                            <button class="kmk-btn-danger kmk-btn-sm" @onclick="() => DeleteAsync(c)">Supprimer</button>
                        </td>
                    </tr>
                    @if (_credTestResults.TryGetValue(c.Id, out var res) && res is not null)
                    {
                        <tr class="bg-slate-50/70">
                            <td colspan="6" class="py-2 px-4">
                                @if (res.Success)
                                {
                                    <div class="text-xs text-emerald-700 font-medium flex items-center gap-1.5">
                                        <span class="font-bold">✓</span> @res.Message @(!string.IsNullOrWhiteSpace(res.WorkingDirectory) ? $"({res.WorkingDirectory})" : "")
                                    </div>
                                }
                                else
                                {
                                    <div class="text-xs text-red-700 font-medium flex items-center gap-1.5">
                                        <span class="font-bold">✗</span> Échec : @res.Message
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
                @if (_credentials.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-slate-400 py-8">Aucun credential enregistré.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (_editingCredential != null)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-xs">
            <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full p-6 border border-slate-200">
                <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-5">
                    <div class="flex items-center gap-2.5">
                        <div class="h-9 w-9 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center border border-indigo-100">
                            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-base font-bold text-slate-900">Modifier le credential</h3>
                            <p class="text-xs text-slate-500">Mettez à jour les paramètres de connexion ou changez le mot de passe.</p>
                        </div>
                    </div>
                    <button type="button" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg hover:bg-slate-100" @onclick="CancelEdit">
                        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                    </button>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="kmk-label">Nom du credential</label>
                        <input class="kmk-input" @bind="_editingCredential.Name" placeholder="ex: GESTMAM" />
                    </div>
                    <div>
                        <label class="kmk-label">Type</label>
                        <select class="kmk-select" @bind="_editingCredential.Type">
                            @foreach (var t in Enum.GetValues<CredentialType>())
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="kmk-label">Nom d'utilisateur / Identifiant</label>
                        <input class="kmk-input" @bind="_editingCredential.Username" placeholder="ex: admin" />
                    </div>
                    <div>
                        <label class="kmk-label">Hôte / Serveur</label>
                        <input class="kmk-input" @bind="_editingCredential.Host" placeholder="ex: sftp.cit.ci ou 192.168.1.50" />
                    </div>
                    <div>
                        <label class="kmk-label">Port</label>
                        <input type="number" class="kmk-input" @bind="_editingCredential.Port" placeholder="ex: 22 (SFTP) ou 21 (FTP)" />
                    </div>
                    <div>
                        <label class="kmk-label">Authentification</label>
                        <select class="kmk-select" @bind="_editingCredential.AuthType">
                            <option value="@CredentialAuthType.MotDePasse">Mot de passe</option>
                            <option value="@CredentialAuthType.ClePriveeSsh">Clé privée SSH (SFTP)</option>
                        </select>
                    </div>
                    @if (_editingCredential.AuthType == CredentialAuthType.ClePriveeSsh)
                    {
                        <div class="sm:col-span-2">
                            <label class="kmk-label">
                                Clé privée SSH (PEM)
                                <span class="text-slate-400 font-normal text-[11px] ml-1">(inchangée si vide)</span>
                            </label>
                            <textarea class="kmk-input font-mono text-xs" rows="3" @bind="_editPlainSecret" placeholder="•••••••• (inchangée) ou collez une nouvelle clé -----BEGIN OPENSSH PRIVATE KEY-----..."></textarea>
                        </div>
                        <div>
                            <label class="kmk-label">
                                Passphrase de la clé
                                <span class="text-slate-400 font-normal text-[11px] ml-1">(inchangée si vide)</span>
                            </label>
                            <div class="kmk-password-wrapper">
                                <input type="password" class="kmk-input" @bind="_editPassphrase" placeholder="•••••••• (inchangée)" />
                                <button type="button" class="kmk-password-toggle" onclick="kernelMK.togglePasswordVisibility(this)" aria-label="Afficher la passphrase" tabindex="-1">
                                    <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div>
                            <label class="kmk-label">
                                Secret (mot de passe)
                                <span class="text-slate-400 font-normal text-[11px] ml-1">(inchangé si vide)</span>
                            </label>
                            <div class="kmk-password-wrapper">
                                <input type="password" class="kmk-input" @bind="_editPlainSecret" placeholder="•••••••• (inchangé)" />
                                <button type="button" class="kmk-password-toggle" onclick="kernelMK.togglePasswordVisibility(this)" aria-label="Afficher le mot de passe" tabindex="-1">
                                    <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                                </button>
                            </div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_editMessage))
                {
                    <div class="mt-4 p-3 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-700">
                        @_editMessage
                    </div>
                }

                <div class="flex items-center justify-end gap-3 mt-6 pt-4 border-t border-slate-100">
                    <button type="button" class="kmk-btn-secondary text-xs" @onclick="CancelEdit">Annuler</button>
                    <button type="button" class="kmk-btn-primary text-xs" @onclick="SaveEditAsync">💾 Enregistrer les modifications</button>
                </div>
            </div>
        </div>
    }
}

@code {
    private List<Credential> _credentials = new();
    private bool _loading = true;
    private Credential _newCredential = new();
    private string _plainSecret = "";
    private string _newPassphrase = "";
    private string? _currentUser;
    private readonly HashSet<Guid> _testingCreds = new();
    private readonly Dictionary<Guid, ConnectionTestResult> _credTestResults = new();

    private Credential? _editingCredential;
    private string _editPlainSecret = "";
    private string _editPassphrase = "";
    private string? _editMessage;

    private void StartEdit(Credential c)
    {
        _editingCredential = new Credential
        {
            Id = c.Id,
            Name = c.Name,
            Description = c.Description,
            Type = c.Type,
            Username = c.Username,
            Host = c.Host,
            Port = c.Port,
            CreatedAt = c.CreatedAt,
            CreatedBy = c.CreatedBy,
            EncryptedSecret = c.EncryptedSecret,
            AuthType = c.AuthType,
            EncryptedPassphrase = c.EncryptedPassphrase
        };
        _editPlainSecret = "";
        _editPassphrase = "";
        _editMessage = null;
    }

    private void CancelEdit()
    {
        _editingCredential = null;
        _editPlainSecret = "";
        _editPassphrase = "";
        _editMessage = null;
    }

    private async Task SaveEditAsync()
    {
        if (_editingCredential is null) return;
        if (string.IsNullOrWhiteSpace(_editingCredential.Name))
        {
            _editMessage = "Le nom du credential est obligatoire.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Credentials.FindAsync(_editingCredential.Id);
        if (entity is null)
        {
            _editMessage = "Credential introuvable en base.";
            return;
        }

        entity.Name = _editingCredential.Name.Trim();
        entity.Type = _editingCredential.Type;
        entity.Username = string.IsNullOrWhiteSpace(_editingCredential.Username) ? null : _editingCredential.Username.Trim();
        entity.Host = string.IsNullOrWhiteSpace(_editingCredential.Host) ? null : _editingCredential.Host.Trim();
        entity.Port = _editingCredential.Port;
        entity.AuthType = _editingCredential.AuthType;

        if (!string.IsNullOrWhiteSpace(_editPlainSecret))
        {
            entity.EncryptedSecret = Protector.Protect(_editPlainSecret);
        }
        if (!string.IsNullOrWhiteSpace(_editPassphrase))
        {
            entity.EncryptedPassphrase = Protector.Protect(_editPassphrase);
        }
        if (entity.AuthType == CredentialAuthType.MotDePasse)
        {
            entity.EncryptedPassphrase = null;
        }

        await db.SaveChangesAsync();
        await Audit.LogAsync(AuditAction.Modification, nameof(Credential), entity.Id.ToString(), entity.Name, null, _currentUser);

        _editingCredential = null;
        _editPlainSecret = "";
        _editMessage = null;
        await LoadAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        _currentUser = authState.User.Identity?.Name;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        _credentials = await db.Credentials.OrderBy(c => c.Name).ToListAsync();
        _loading = false;
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(_newCredential.Name) || string.IsNullOrWhiteSpace(_plainSecret)) return;

        _newCredential.EncryptedSecret = Protector.Protect(_plainSecret);
        _newCredential.EncryptedPassphrase = string.IsNullOrWhiteSpace(_newPassphrase) ? null : Protector.Protect(_newPassphrase);
        _newCredential.CreatedBy = _currentUser;

        await using var db = await DbFactory.CreateDbContextAsync();
        db.Credentials.Add(_newCredential);
        await db.SaveChangesAsync();
        await Audit.LogAsync(AuditAction.Creation, nameof(Credential), _newCredential.Id.ToString(), _newCredential.Name, null, _currentUser);

        _newCredential = new Credential();
        _plainSecret = "";
        _newPassphrase = "";
        await LoadAsync();
    }

    private async Task DeleteAsync(Credential c)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Credentials.FindAsync(c.Id);
        if (entity is null) return;
        db.Credentials.Remove(entity);
        await db.SaveChangesAsync();
        await Audit.LogAsync(AuditAction.Suppression, nameof(Credential), c.Id.ToString(), c.Name, null, _currentUser);
        await LoadAsync();
    }

    private async Task TestCredAsync(Credential c)
    {
        if (string.IsNullOrWhiteSpace(c.Host)) return;

        _testingCreds.Add(c.Id);
        StateHasChanged();

        try
        {
            var secret = Protector.Unprotect(c.EncryptedSecret);
            var passphrase = string.IsNullOrEmpty(c.EncryptedPassphrase) ? null : Protector.Unprotect(c.EncryptedPassphrase);
            var port = c.Port is > 0 ? c.Port.Value : 22;
            var stepType = port == 21 ? StepType.TransfertFtp : StepType.TransfertSftp;

            var res = await TestService.TestConnectionAsync(stepType, c.Host, port, c.Username, secret, authType: c.AuthType, passphrase: passphrase);
            _credTestResults[c.Id] = res;
        }
        catch (Exception ex)
        {
            _credTestResults[c.Id] = ConnectionTestResult.Fail($"Erreur : {ex.Message}");
        }
        finally
        {
            _testingCreds.Remove(c.Id);
            StateHasChanged();
        }
    }
}
