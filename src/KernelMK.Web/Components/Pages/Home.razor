    </div>
</div>

}
else if (_loadError is null)
{
    <div class="kmk-card p-8 text-sm text-slate-500" role="status" aria-live="polite">Chargement de la supervision…</div>
}

@code {
    private bool _refreshing;
    private bool _hasLoaded;
    private bool _disposed;
    private DateTime _snapshotAt;
    private readonly CancellationTokenSource _lifetime = new();
    private string? _loadError = null;
    private int _periodHours = 24;

    private string PeriodLabel => _periodHours switch { 24 => "24h", 168 => "7j", 720 => "30j", _ => $"{_periodHours}h" };

    private async Task SetPeriod(int hours)
    {
        if (_periodHours == hours) return;
        _periodHours = hours;
        _armateurPage = _incidentsPage = 1;
        _hasLoaded = false;
        await LoadDashboardAsync();
    }
    private int _totalJobs;
    private int _activeJobs, _inactiveJobs, _runningCount, _successCount, _failedCount;
    private long _filesProcessed;
    private int? _successRate = null;
    private double _avgDurationSeconds;
    private IReadOnlyList<DashboardTrigger> _upcoming = [];
    private IReadOnlyList<DashboardIncident> _recentIncidents = [];
    private IReadOnlyList<DashboardExecution> _recentExecutions = [];
    private IReadOnlyList<RemoteServer> _remoteCredentials = [];

    // Armateur Flux Statistics (Sent vs Received)
    private IReadOnlyList<DashboardPartner> _armateurStats = [];
    private int _armateurPage = 1;
    private int _armateurPageSize = 10;
    private IEnumerable<DashboardPartner> PagedArmateurStats => _armateurStats.Skip((_armateurPage - 1) * _armateurPageSize).Take(_armateurPageSize);

    private const int SilenceAttentionDays = 3;
    private const int SilenceAlerteDays = 7;

    private static (string Label, string CssClass) FormatSilence(DateTime? dernierEchange)
    {
        if (dernierEchange is null) return ("Jamais", "bg-red-100 text-red-700");
        var days = (DateTime.UtcNow - dernierEchange.Value).TotalDays;
        var label = days < 1 ? "Aujourd'hui" : $"Il y a {(int)days} j";
        if (days >= SilenceAlerteDays) return (label, "bg-red-100 text-red-700");
        if (days >= SilenceAttentionDays) return (label, "bg-amber-100 text-amber-700");
        return (label, "bg-emerald-100 text-emerald-700");
    }

    private long _totalEnvoyes;
    private long _totalRecuperes;

    // Nouveaux indicateurs (jobs jamais exécutés, alertes proactives, fiabilité par partenaire)
    private IReadOnlyList<DashboardJob> _neverRunJobs = [];
    private IReadOnlyList<DashboardNotification> _recentNotifications = [];
    private IReadOnlyList<DashboardReliability> _leastReliablePartners = [];

    // Pagination des listes du dashboard (chargées avec une borne large côté DB, paginées côté client)
    private int _neverRunPage = 1;
    private int _neverRunPageSize = 10;
    private IEnumerable<DashboardJob> PagedNeverRunJobs => _neverRunJobs.Skip((_neverRunPage - 1) * _neverRunPageSize).Take(_neverRunPageSize);

    private int _notificationsPage = 1;
    private int _notificationsPageSize = 10;
    private IEnumerable<DashboardNotification> PagedNotifications => _recentNotifications.Skip((_notificationsPage - 1) * _notificationsPageSize).Take(_notificationsPageSize);

    private int _recentExecPage = 1;
    private int _recentExecPageSize = 10;
    private IEnumerable<DashboardExecution> PagedRecentExecutions => _recentExecutions.Skip((_recentExecPage - 1) * _recentExecPageSize).Take(_recentExecPageSize);

    private int _upcomingPage = 1;
    private int _upcomingPageSize = 10;
    private IEnumerable<DashboardTrigger> PagedUpcoming => _upcoming.Skip((_upcomingPage - 1) * _upcomingPageSize).Take(_upcomingPageSize);

    private int _credentialsPage = 1;
    private int _credentialsPageSize = 10;
    private IEnumerable<RemoteServer> PagedRemoteCredentials => _remoteCredentials.Skip((_credentialsPage - 1) * _credentialsPageSize).Take(_credentialsPageSize);

    private int _incidentsPage = 1;
    private int _incidentsPageSize = 10;
    private IEnumerable<DashboardIncident> PagedIncidents => _recentIncidents.Skip((_incidentsPage - 1) * _incidentsPageSize).Take(_incidentsPageSize);

    // Diagnostic global : classification de chaque incident par origine probable (CIT vs partenaire/armateur)
    private Dictionary<Guid, (SideClassification Diag, string Armateur)> _incidentSideByExecution = new();
    private int _citSideCount, _armateurSideCount, _indetermineSideCount;
    private List<(string Label, int Count)> _citSideDetails = new();
    private List<(string Label, int Count)> _armateurSideDetails = new();

    // Live Real-Time Auto-Refresh
    private bool _autoRefresh = true;
    private CancellationTokenSource? _cts;

    private sealed record RemoteServer(string Name, CredentialType Type, string? Host, int? Port, string? Username);

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
        StartRealTimeTimer();
    }

    private void StartRealTimeTimer()
    {
        if (_disposed) return;
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        _ = RunRealTimeLoopAsync(_cts.Token);
    }

    private async Task RunRealTimeLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (!_autoRefresh || _disposed) continue;
                await InvokeAsync(async () =>
                {
                    await LoadDashboardAsync();
                    if (!_disposed) StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (ObjectDisposedException) when (_disposed) { }
        catch (Exception error)
        {
            Logger.LogError(error, "Arrêt du rafraîchissement automatique du tableau de bord.");
        }
    }

    private void ToggleAutoRefresh()
    {
        _autoRefresh = !_autoRefresh;
    }

    private async Task LoadDashboardAsync()
    {
        if (_disposed) return;
        if (_refreshing) { _reloadRequested = true; return; }
        _refreshing = true;
        _loadError = null;
        var requestedPeriod = _periodHours;
        try
        {
            var snapshot = await DashboardCache.GetAsync(requestedPeriod, _lifetime.Token);
            if (_disposed || requestedPeriod != _periodHours) return;
            _totalJobs = snapshot.TotalJobs;
            _activeJobs = snapshot.ActiveJobs;
            _inactiveJobs = snapshot.TotalJobs - snapshot.ActiveJobs;
            _runningCount = snapshot.RunningCount;
            _successCount = snapshot.SuccessCount;
            _failedCount = snapshot.FailedCount;
            _successRate = snapshot.SuccessRate;
            _avgDurationSeconds = snapshot.AverageDurationSeconds;
            _filesProcessed = snapshot.FilesProcessed;
            _upcoming = snapshot.Upcoming;
            _recentExecutions = snapshot.RecentExecutions;
            _recentIncidents = snapshot.RecentIncidents;
            _neverRunJobs = snapshot.NeverRunJobs;
            _recentNotifications = snapshot.Notifications;
            _leastReliablePartners = snapshot.LeastReliablePartners;
            _armateurStats = snapshot.Partners;
            _totalEnvoyes = snapshot.TotalFilesSent;
            _totalRecuperes = snapshot.TotalFilesReceived;
            _snapshotAt = snapshot.GeneratedAt;
            _incidentSideByExecution = snapshot.RecentIncidents.ToDictionary(e => e.Id, e => (e.Diagnosis, e.Armateur));
            _citSideCount = snapshot.RecentIncidents.Count(e => e.Diagnosis.Side == AnomalySide.Cit);
            _armateurSideCount = snapshot.RecentIncidents.Count(e => e.Diagnosis.Side == AnomalySide.Armateur);
            _indetermineSideCount = snapshot.RecentIncidents.Count(e => e.Diagnosis.Side == AnomalySide.Indetermine);
            _citSideDetails = snapshot.RecentIncidents.Where(e => e.Diagnosis.Side == AnomalySide.Cit)
                .GroupBy(e => e.JobName).Select(g => (Label: g.Key, Count: g.Count())).OrderByDescending(x => x.Count).ToList();
            _armateurSideDetails = snapshot.RecentIncidents.Where(e => e.Diagnosis.Side == AnomalySide.Armateur && e.Armateur != "—")
                .GroupBy(e => e.Armateur, StringComparer.OrdinalIgnoreCase).Select(g => (Label: g.Key, Count: g.Count())).OrderByDescending(x => x.Count).ToList();
            _hasLoaded = true;
            await LoadRemoteServersAsync();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception error)
        {
            Logger.LogError(error, "Erreur lors du chargement des métriques du tableau de bord.");
            _loadError = _hasLoaded
                ? "Actualisation indisponible. Les dernières données affichées peuvent être anciennes. Réessayez dans quelques instants."
                : "La supervision est temporairement indisponible. Réessayez dans quelques instants.";
        }
        finally
        {
            _refreshing = false;
            if (_reloadRequested && !_disposed)
            {
                _reloadRequested = false;
                await LoadDashboardAsync();
            }
        }
    }

    private bool _reloadRequested;

    private async Task LoadRemoteServersAsync()
    {
        // Access rules are evaluated per circuit, on every refresh, outside the shared cache.
        _remoteCredentials = [];
        var user = (await AuthenticationState.GetAuthenticationStateAsync()).User;
        if (!new[] { "Administrateur", "Developpeur", "Superviseur", "Exploitant" }.Any(user.IsInRole)) return;
        await using var db = await DbFactory.CreateDbContextAsync(_lifetime.Token);
        var visible = new List<RemoteServer>(50);
        await foreach (var server in db.Credentials.AsNoTracking()
            .Where(c => c.Host != null && c.Host != "").OrderBy(c => c.Name)
            .Select(c => new { c.Name, c.Type, c.Host, c.Port, c.Username, c.AllowedRolesCsv })
            .AsAsyncEnumerable().WithCancellation(_lifetime.Token))
        {
            if (!string.IsNullOrWhiteSpace(server.AllowedRolesCsv) &&
                !server.AllowedRolesCsv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Any(user.IsInRole)) continue;
            visible.Add(new(server.Name, server.Type, server.Host, server.Port, server.Username));
            if (visible.Count == 50) break;
        }
        _remoteCredentials = visible;
    }

    private static string StatusBadge(JobStatus status) => status switch
    {
        JobStatus.Succes => "bg-emerald-50 text-emerald-700 border border-emerald-200",
        JobStatus.Echec => "bg-rose-50 text-rose-700 border border-rose-200",
        JobStatus.EnCours => "bg-amber-50 text-amber-700 border border-amber-200",
        JobStatus.Annule => "bg-slate-100 text-slate-700 border border-slate-200",
        _ => "bg-slate-100 text-slate-700 border border-slate-200"
    };

    private static string FormatDuration(double seconds)
    {
        if (seconds <= 0) return "0 s";
        if (seconds < 60) return $"{seconds:F1} s";
        var ts = TimeSpan.FromSeconds(seconds);
        return $"{(int)ts.TotalMinutes}m {ts.Seconds}s";
    }

    private static string FormatCountdown(TimeSpan remaining)
    {
        if (remaining <= TimeSpan.Zero) return "Imminent";
        if (remaining.TotalMinutes < 1) return $"dans {remaining.Seconds}s";
        if (remaining.TotalHours < 1) return $"dans {(int)remaining.TotalMinutes} min";
        if (remaining.TotalDays < 1) return $"dans {(int)remaining.TotalHours}h {remaining.Minutes}m";
        return $"dans {(int)remaining.TotalDays}j {remaining.Hours}h";
    }

    private bool _cleaningOrphans;
    private string? _recoveryNotice;

    private async Task CleanOrphanedExecutionsAsync()
    {
        if (_cleaningOrphans) return;
        _cleaningOrphans = true;
        try
        {
            var canceled = await OrphanedExecutionRecovery.CancelOrphanedAsync(_lifetime.Token);
            _recoveryNotice = canceled == 0
                ? "Aucune exécution bloquée à nettoyer : les traitements restants sont suivis par le moteur."
                : $"{canceled} exécution(s) bloquée(s) ont été annulée(s).";
            DashboardCache.Invalidate();
            await LoadDashboardAsync();
        }
        catch (Exception error)
        {
            Logger.LogError(error, "Échec du nettoyage des exécutions orphelines.");
            _recoveryNotice = "Le nettoyage n'a pas pu être exécuté. Consultez le journal du service.";
        }
        finally
        {
            _cleaningOrphans = false;
        }
    }
    private async Task StopRunningExecution(DashboardExecution ex)
    {
        var user = (await AuthenticationState.GetAuthenticationStateAsync()).User;
        if (!new[] { "Administrateur", "Superviseur", "Exploitant" }.Any(user.IsInRole)) return;
        ExecutionCoordinator.TryStopExecution(ex.Id);
        ExecutionCoordinator.TryStopJob(ex.JobId);
        await Task.Delay(400, _lifetime.Token);
        DashboardCache.Invalidate();
        await LoadDashboardAsync();
    }

    private static string GetArmateurColorClass(string armateur)
    {
        var upper = armateur.ToUpperInvariant();
        if (upper.Contains("MSC")) return "bg-amber-400";
        if (upper.Contains("MAERSK")) return "bg-sky-400";
        if (upper.Contains("CMA") || upper.Contains("CGM")) return "bg-indigo-500";
        if (upper.Contains("HAPAG")) return "bg-orange-500";
        if (upper.Contains("COSCO")) return "bg-rose-500";
        if (upper.Contains("GRIMALDI")) return "bg-emerald-500";
        return "bg-slate-400";
    }

