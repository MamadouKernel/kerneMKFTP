@page "/audit"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrateur,Auditeur")]
@using System.Text
@using Microsoft.EntityFrameworkCore
@using KernelMK.Core
@using KernelMK.Core.Entities
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Journal d'audit · Côte d'Ivoire Terminal · kernelMK</PageTitle>

<!-- Top Title Bar -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
        <div class="flex items-center gap-3">
            <h1 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2.5">
                <span class="h-9 w-9 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shadow-xs border border-indigo-100">
                    <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75M3.75 6.75h16.5M3.75 6.75v10.5A2.25 2.25 0 0 0 6 19.5h12a2.25 2.25 0 0 0 2.25-2.25V6.75m-16.5 0A2.25 2.25 0 0 1 6 4.5h12a2.25 2.25 0 0 1 2.25 2.25" />
                    </svg>
                </span>
                Pistes d'Audit &amp; Traçabilité
            </h1>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                Conformité Portuaire
            </span>
        </div>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
            Historique inaltérable des opérations : créations, exécutions, arrêts, suppressions et authentifications.
        </p>
    </div>

    <div class="flex items-center gap-2">
        <button type="button" @onclick="ExportCsv" class="kmk-btn-secondary text-xs py-2 px-3 flex items-center gap-1.5 shadow-xs" title="Exporter les pistes d'audit en CSV certifié">
            <svg class="h-3.5 w-3.5 text-slate-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
            <span>Exporter CSV</span>
        </button>

        <button type="button" @onclick="LoadAsync" class="kmk-btn-secondary text-xs py-2 px-3 flex items-center gap-1.5 shadow-xs">
            <svg class="h-3.5 w-3.5 text-slate-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
            </svg>
            <span>Actualiser</span>
        </button>
    </div>
</div>

<!-- Quick Stat Cards -->
@if (!_loading)
{
    var total = _entries.Count;
    var creations = _entries.Count(e => e.Action == AuditAction.Creation);
    var modifications = _entries.Count(e => e.Action == AuditAction.Modification);
    var arrêts = _entries.Count(e => e.Action is AuditAction.Desactivation or AuditAction.Annulation);
    var suppressions = _entries.Count(e => e.Action == AuditAction.Suppression);

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5 mb-6">
        <div class="kmk-card p-4 flex items-center gap-3.5 hover:shadow-md transition-shadow">
            <div class="h-11 w-11 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center shrink-0 border border-slate-200">
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75M3.75 6.75h16.5M3.75 6.75v10.5A2.25 2.25 0 0 0 6 19.5h12a2.25 2.25 0 0 0 2.25-2.25V6.75m-16.5 0A2.25 2.25 0 0 1 6 4.5h12a2.25 2.25 0 0 1 2.25 2.25" /></svg>
            </div>
            <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block">Total Audits</span>
                <span class="text-2xl font-bold text-slate-900 leading-none">@total</span>
            </div>
        </div>

        <div class="kmk-card p-4 flex items-center gap-3.5 hover:shadow-md transition-shadow">
            <div class="h-11 w-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 border border-emerald-200">
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            </div>
            <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block">Créations</span>
                <span class="text-2xl font-bold text-emerald-600 leading-none">@creations</span>
            </div>
        </div>

        <div class="kmk-card p-4 flex items-center gap-3.5 hover:shadow-md transition-shadow">
            <div class="h-11 w-11 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0 border border-amber-200">
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" /></svg>
            </div>
            <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block">Modifications</span>
                <span class="text-2xl font-bold text-amber-600 leading-none">@modifications</span>
            </div>
        </div>

        <div class="kmk-card p-4 flex items-center gap-3.5 hover:shadow-md transition-shadow">
            <div class="h-11 w-11 rounded-xl @(suppressions > 0 ? "bg-rose-50 text-rose-600 border border-rose-200" : "bg-slate-100 text-slate-400 border border-slate-200") flex items-center justify-center shrink-0">
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
            </div>
            <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block">Suppressions</span>
                <span class="text-2xl font-bold @(suppressions > 0 ? "text-rose-600" : "text-slate-800") leading-none">@suppressions</span>
            </div>
        </div>
    </div>
}

<!-- Filters Bar -->
<div class="kmk-card p-3.5 mb-5 flex flex-col md:flex-row md:items-center justify-between gap-3 bg-white/95">
    <div class="flex-1 grid grid-cols-1 sm:grid-cols-3 gap-2.5">
        <!-- Recherche plein texte -->
        <div class="relative">
            <input class="kmk-input !py-2 !pl-9 text-xs" placeholder="Rechercher utilisateur, entité, détails..." @bind="_searchQuery" @bind:event="oninput" />
            <svg class="h-4 w-4 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
            </svg>
        </div>

        <!-- Filtre par Action -->
        <select class="kmk-select !py-2 text-xs" @bind="_selectedAction">
            <option value="">Toutes les actions</option>
            @foreach (var act in Enum.GetValues<AuditAction>())
            {
                <option value="@act">@act</option>
            }
        </select>

        <!-- Filtre par Entité -->
        <select class="kmk-select !py-2 text-xs" @bind="_selectedEntity">
            <option value="">Tous les types d'entités</option>
            @foreach (var ent in _distinctEntities)
            {
                <option value="@ent">@ent</option>
            }
        </select>
    </div>

    @if (!string.IsNullOrWhiteSpace(_searchQuery) || !string.IsNullOrWhiteSpace(_selectedAction) || !string.IsNullOrWhiteSpace(_selectedEntity))
    {
        <button type="button" @onclick="ResetFilters" class="kmk-btn-secondary !py-2 !px-3 text-xs text-slate-500 hover:text-slate-800 shrink-0">
            <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
            Réinitialiser (@FilteredEntries.Count() résultat(s))
        </button>
    }
</div>

@if (_loading)
{
    <div class="kmk-card p-12 flex flex-col items-center justify-center gap-3 text-sm text-slate-500">
        <svg class="animate-spin h-6 w-6 text-brand-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
        <span>Chargement des pistes d'audit portuaire...</span>
    </div>
}
else
{
    <div class="kmk-table-container">
        <table class="kmk-table">
            <thead>
                <tr>
                    <th class="min-w-[150px]">Date &amp; Heure</th>
                    <th class="min-w-[150px]">Utilisateur</th>
                    <th class="min-w-[130px]">Action Opérée</th>
                    <th class="min-w-[110px]">Entité</th>
                    <th class="min-w-[170px]">Cible</th>
                    <th>Détails de l'opération</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in FilteredEntries)
                {
                    <tr>
                        <td class="text-xs text-slate-600 whitespace-nowrap">
                            <div class="font-semibold text-slate-800">@entry.Timestamp.ToLocalTime().ToString("dd/MM/yyyy")</div>
                            <div class="text-[11px] text-slate-400 font-mono">@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss")</div>
                        </td>
                        <td class="font-medium text-xs text-slate-800">
                            <span class="inline-flex items-center gap-1.5">
                                <span class="h-6 w-6 rounded-full bg-slate-100 text-slate-600 text-[10px] font-bold flex items-center justify-center border border-slate-200">
                                    @(string.IsNullOrWhiteSpace(entry.UserName) ? "?" : entry.UserName[0].ToString().ToUpper())
                                </span>
                                <span>@(string.IsNullOrWhiteSpace(entry.UserName) ? "Système" : entry.UserName)</span>
                            </span>
                        </td>
                        <td>
                            <span class="@ActionBadge(entry.Action)">
                                @entry.Action
                            </span>
                        </td>
                        <td class="text-xs font-mono font-semibold text-slate-700">
                            <span class="px-2 py-0.5 rounded bg-slate-100 border border-slate-200">@entry.EntityType</span>
                        </td>
                        <td class="text-xs font-bold text-slate-900 truncate max-w-xs">
                            @entry.EntityName
                        </td>
                        <td class="text-xs text-slate-500 truncate max-w-md" title="@entry.Details">
                            @entry.Details
                        </td>
                    </tr>
                }
                @if (!FilteredEntries.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-12 text-slate-400 text-xs">
                            Aucune entrée ne correspond aux filtres sélectionnés.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<AuditLogEntry> _entries = new();
    private List<string> _distinctEntities = new();
    private bool _loading = true;

    private string _searchQuery = "";
    private string _selectedAction = "";
    private string _selectedEntity = "";

    private IEnumerable<AuditLogEntry> FilteredEntries
    {
        get
        {
            var query = _entries.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.Trim().ToLowerInvariant();
                query = query.Where(e =>
                    (!string.IsNullOrEmpty(e.UserName) && e.UserName.ToLowerInvariant().Contains(q)) ||
                    (!string.IsNullOrEmpty(e.EntityName) && e.EntityName.ToLowerInvariant().Contains(q)) ||
                    (!string.IsNullOrEmpty(e.EntityType) && e.EntityType.ToLowerInvariant().Contains(q)) ||
                    (!string.IsNullOrEmpty(e.Details) && e.Details.ToLowerInvariant().Contains(q)));
            }

            if (!string.IsNullOrWhiteSpace(_selectedAction) && Enum.TryParse<AuditAction>(_selectedAction, out var act))
            {
                query = query.Where(e => e.Action == act);
            }

            if (!string.IsNullOrWhiteSpace(_selectedEntity))
            {
                query = query.Where(e => string.Equals(e.EntityType, _selectedEntity, StringComparison.OrdinalIgnoreCase));
            }

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _entries = await db.AuditLogEntries
                .OrderByDescending(a => a.Timestamp)
                .Take(250)
                .ToListAsync();

            _distinctEntities = _entries
                .Select(e => e.EntityType)
                .Where(e => !string.IsNullOrWhiteSpace(e))
                .Distinct()
                .OrderBy(e => e)
                .ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetFilters()
    {
        _searchQuery = "";
        _selectedAction = "";
        _selectedEntity = "";
    }

    private async Task ExportCsv()
    {
        var sb = new StringBuilder();
        // UTF-8 BOM
        sb.Append('\uFEFF');
        sb.AppendLine("Date & Heure;Utilisateur;Action;Entité;Nom Cible;Détails");

        foreach (var e in FilteredEntries)
        {
            var date = e.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss");
            var user = EscapeCsv(e.UserName ?? "Système");
            var action = EscapeCsv(e.Action.ToString());
            var entity = EscapeCsv(e.EntityType);
            var target = EscapeCsv(e.EntityName ?? "");
            var details = EscapeCsv(e.Details ?? "");

            sb.AppendLine($"{date};{user};{action};{entity};{target};{details}");
        }

        var bytes = Encoding.UTF8.GetBytes(sb.ToString());
        var base64 = Convert.ToBase64String(bytes);
        var fileName = $"audit-cit-{DateTime.Now:yyyyMMdd-HHmm}.csv";

        await JS.InvokeVoidAsync("kernelMK.downloadFile", fileName, "text/csv;charset=utf-8", base64);
    }

    private static string EscapeCsv(string value)
    {
        if (value.Contains(';') || value.Contains('"') || value.Contains('\n') || value.Contains('\r'))
        {
            return string.Concat("\"", value.Replace("\"", "\"\""), "\"");
        }
        return value;
    }

    private static string ActionBadge(AuditAction action) => action switch
    {
        AuditAction.Creation => "kmk-badge kmk-badge-success",
        AuditAction.Modification => "kmk-badge kmk-badge-warning",
        AuditAction.Suppression => "kmk-badge kmk-badge-danger",
        AuditAction.Activation => "kmk-badge kmk-badge-success",
        AuditAction.Desactivation => "kmk-badge kmk-badge-pause",
        AuditAction.ExecutionManuelle => "kmk-badge kmk-badge-info",
        AuditAction.Annulation => "kmk-badge kmk-badge-danger",
        AuditAction.Connexion => "kmk-badge kmk-badge-neutral",
        AuditAction.Sauvegarde => "kmk-badge kmk-badge-info",
        AuditAction.Restauration => "kmk-badge kmk-badge-warning",
        _ => "kmk-badge kmk-badge-neutral"
    };
}
