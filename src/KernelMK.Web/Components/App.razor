<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>kernelMK</title>
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["css/premium.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="manifest" href="manifest.json" />
    <HeadOutlet />
    <style>
        details summary {
            list-style: none !important;
        }
        details summary::-webkit-details-marker,
        details summary::marker {
            display: none !important;
            content: "" !important;
        }
    </style>
</head>

<body class="h-full">
    <Routes />

    <div id="components-reconnect-modal" role="dialog" aria-live="assertive" aria-labelledby="components-reconnect-title">
        <div class="kmk-reconnect-card">
            <div class="kmk-reconnect-spinner" aria-hidden="true"></div>
            <strong id="components-reconnect-title" class="components-reconnect-show">Reconnexion en cours…</strong>
            <p class="components-reconnect-show">La connexion au serveur a été interrompue. La page va reprendre automatiquement.</p>
            <strong class="components-reconnect-failed">Connexion au serveur impossible</strong>
            <p class="components-reconnect-failed">Vérifiez le réseau, puis réessayez.</p>
            <button id="components-reconnect-button" class="components-reconnect-failed kmk-recovery-button" type="button" onclick="window.Blazor?.reconnect?.()">Réessayer</button>
            <strong class="components-reconnect-rejected">La session n’est plus disponible</strong>
            <p class="components-reconnect-rejected">Le serveur a redémarré ou votre session a expiré.</p>
            <button class="components-reconnect-rejected kmk-recovery-button" type="button" onclick="location.reload()">Recharger la page</button>
        </div>
    </div>

    <div id="blazor-error-ui" data-nosnippet role="alert">
        Une erreur d’affichage est survenue.
        <a href="" class="reload" data-enhance-nav="false">Recharger la page</a>
        <button type="button" class="dismiss" aria-label="Fermer" onclick="this.parentElement.style.display='none'">×</button>
    </div>
    <script src="_framework/blazor.web.js"></script>
    <script src="js/app.js"></script>
    <script src="js/reseau3d.js"></script>
</body>

</html>
