@inherits LayoutComponentBase
@layout KernelMK.Web.Components.Layout.MainLayout

<div class="mb-6">
    <h1 class="flex items-center gap-2.5">
        <span class="h-9 w-9 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center shadow-sm">
            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
            </svg>
        </span>
        Mon compte
    </h1>
    <p class="text-sm text-slate-500 mt-1">Gère ton profil, ton mot de passe et la sécurité de ton compte.</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
    <nav class="lg:col-span-1">
        <div class="kmk-card lg:sticky lg:top-6">
            <div class="kmk-card-body p-2">
                <ManageNavMenu />
            </div>
        </div>
    </nav>
    <div class="lg:col-span-3 kmk-card">
        <div class="kmk-card-body">
            @Body
        </div>
    </div>
</div>
