@page "/Account/LoginWith2fa"
@layout KernelMK.Web.Components.Layout.EmptyLayout

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using KernelMK.Data.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<LoginWith2fa> Logger

<PageTitle>Double Authentification (2FA) · Côte d'Ivoire Terminal</PageTitle>

<div class="min-h-screen relative flex items-center justify-center px-4 overflow-hidden"
     style="background-image: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(99,102,241,0.12), transparent), linear-gradient(180deg, #0b1120 0%, #0f172a 45%, #f8fafc 45%);">

    <div class="absolute -top-24 -left-24 h-72 w-72 rounded-full bg-brand-500/20 blur-3xl"></div>
    <div class="absolute -top-10 right-0 h-64 w-64 rounded-full bg-violet-500/10 blur-3xl"></div>

    <div class="relative w-full max-w-sm">
        <div class="flex flex-col items-center justify-center gap-3 mb-6">
            <div class="bg-white rounded-2xl px-3 py-2 shadow-xl border border-white/20 flex items-center justify-center shrink-0" style="height: 52px; max-width: 180px;">
                <img src="images/logo_cit.jpeg" alt="Côte d'Ivoire Terminal" class="kmk-logo-cit-lg" style="height: 38px; max-height: 38px; width: auto; max-width: 160px; object-fit: contain; display: block;" />
            </div>
            <div class="text-center">
                <span class="text-white font-bold tracking-tight text-xl block">kernel<span class="text-brand-400">MK</span></span>
                <span class="text-xs text-slate-400 font-medium">Plateforme Sécurisée de Transferts &amp; EDI · Port d'Abidjan</span>
            </div>
        </div>

        <div class="kmk-card !shadow-2xl !shadow-slate-900/20">
            <div class="kmk-card-body">
                <div class="flex items-center gap-2.5 mb-2">
                    <div class="h-9 w-9 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0 shadow-xs border border-indigo-100">
                        <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-base font-bold text-slate-900">Vérification 2FA</h1>
                        <span class="text-[10px] font-semibold text-brand-600 uppercase tracking-wide">Sécurité Obligatoire CIT</span>
                    </div>
                </div>

                <p class="text-xs text-slate-500 mb-5 leading-relaxed">
                    Saisissez le code à 6 chiffres généré par votre application d'authentification (Google Authenticator, Microsoft Authenticator, etc.).
                </p>

                <StatusMessage Message="@message" IsError="true" />

                <EditForm Model="Input" FormName="login-with-2fa" OnValidSubmit="OnValidSubmitAsync" method="post" class="space-y-4">
                    <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
                    <input type="hidden" name="RememberMe" value="@RememberMe" />
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-red-600 text-xs" role="alert" />

                    <div>
                        <label for="Input.TwoFactorCode" class="kmk-label text-center block">Code Authenticator (6 chiffres)</label>
                        <InputText @bind-Value="Input.TwoFactorCode" id="Input.TwoFactorCode"
                                   class="kmk-input text-center text-2xl tracking-[0.35em] font-mono font-bold py-2.5"
                                   autocomplete="one-time-code" inputmode="numeric" placeholder="••••••" autofocus="true" />
                        <ValidationMessage For="() => Input.TwoFactorCode" class="text-red-600 text-xs text-center mt-1" />
                    </div>

                    <label class="flex items-center gap-2 text-xs text-slate-600 cursor-pointer select-none">
                        <InputCheckbox @bind-Value="Input.RememberMachine" class="kmk-checkbox" />
                        <span>Mémoriser ce navigateur (14 jours)</span>
                    </label>

                    <button type="submit" class="kmk-btn-primary w-full py-2.5 text-sm font-semibold flex items-center justify-center gap-2">
                        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                        </svg>
                        <span>Valider le code et accéder</span>
                    </button>

                    <div class="pt-3 border-t border-slate-100 flex flex-col items-center gap-2 text-center text-xs">
                        <a href="Account/LoginWithRecoveryCode?ReturnUrl=@ReturnUrl" class="text-brand-600 hover:text-brand-800 font-medium">
                            🔑 Utiliser un code de secours
                        </a>
                        <a href="Account/Login" class="text-slate-400 hover:text-slate-600">
                            ← Revenir à la page de connexion
                        </a>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private string? message;
    private ApplicationUser user = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private bool RememberMe { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // S'assure que l'utilisateur a franchi l'étape mot de passe
        user = await SignInManager.GetTwoFactorAuthenticationUserAsync() ??
            throw new InvalidOperationException("Session d'authentification 2FA introuvable ou expirée. Veuillez vous reconnecter.");
    }

    private async Task OnValidSubmitAsync()
    {
        var authenticatorCode = Input.TwoFactorCode!.Replace(" ", string.Empty).Replace("-", string.Empty);
        var result = await SignInManager.TwoFactorAuthenticatorSignInAsync(authenticatorCode, RememberMe, Input.RememberMachine);
        var userId = await UserManager.GetUserIdAsync(user);

        if (result.Succeeded)
        {
            Logger.LogInformation("Utilisateur ID '{UserId}' connecté avec succès via 2FA.", userId);
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("Compte utilisateur ID '{UserId}' verrouillé.", userId);
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            Logger.LogWarning("Code d'authentification 2FA invalide pour l'utilisateur '{UserId}'.", userId);
            message = "Code de validation 2FA incorrect ou expiré. Veuillez réessayer.";
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Le code à 6 chiffres est requis.")]
        [StringLength(7, ErrorMessage = "Le code doit comporter 6 chiffres.", MinimumLength = 6)]
        [DataType(DataType.Text)]
        [Display(Name = "Code Authenticator")]
        public string? TwoFactorCode { get; set; }

        [Display(Name = "Mémoriser ce navigateur")]
        public bool RememberMachine { get; set; }
    }
}
