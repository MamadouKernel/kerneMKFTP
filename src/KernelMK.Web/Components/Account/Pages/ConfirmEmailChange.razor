@page "/Account/ConfirmEmailChange"
@attribute [AllowAnonymous]

@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using KernelMK.Data.Identity

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Confirmation du changement d'email</PageTitle>

<h1>Confirmation du changement d'email</h1>

<StatusMessage Message="@message" IsError="@messageIsError" />

@code {
    private string? message;
    private bool messageIsError;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Email is null || Code is null)
        {
            RedirectManager.RedirectToWithStatus(
                "Account/Login", "Error: Lien de confirmation de changement d'email invalide.", HttpContext);
        }

        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null)
        {
            message = $"Impossible de trouver l'utilisateur avec l'ID '{UserId}'";
            messageIsError = true;
            return;
        }

        var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        var result = await UserManager.ChangeEmailAsync(user, Email, code);
        if (!result.Succeeded)
        {
            message = "Erreur lors du changement d'email.";
            messageIsError = true;
            return;
        }

        // Dans notre interface, l'email et le nom d'utilisateur sont identiques : on doit donc
        // mettre à jour le nom d'utilisateur en même temps que l'email.
        var setUserNameResult = await UserManager.SetUserNameAsync(user, Email);
        if (!setUserNameResult.Succeeded)
        {
            message = "Erreur lors du changement du nom d'utilisateur.";
            messageIsError = true;
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        message = "Merci d'avoir confirmé le changement de votre email.";
    }
}
