@page "/Account/Manage/Disable2fa"

@using Microsoft.AspNetCore.Identity
@using KernelMK.Data.Identity

@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager

<PageTitle>Désactivation 2FA non autorisée · Côte d'Ivoire Terminal</PageTitle>

<div class="space-y-4 max-w-xl">
    <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-sm space-y-1">
        <div class="font-bold flex items-center gap-1.5 text-amber-800">
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" /></svg>
            <span>Action non autorisée : 2FA obligatoire</span>
        </div>
        <p class="text-xs text-amber-700 leading-relaxed">
            Conformément à la politique de sécurité des systèmes d'information de Côte d'Ivoire Terminal (CIT), l'authentification à deux facteurs (2FA) est strictement obligatoire et ne peut pas être désactivée.
        </p>
    </div>

    <a href="Account/Manage/TwoFactorAuthentication" class="kmk-btn-primary inline-flex items-center gap-2 text-sm">
        <span>← Revenir aux paramètres 2FA</span>
    </a>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await UserAccessor.GetRequiredUserAsync(HttpContext);

        RedirectManager.RedirectToWithStatus(
            "Account/Manage/TwoFactorAuthentication",
            "Conformément à la politique de sécurité de Côte d'Ivoire Terminal (CIT), la double authentification (2FA) est obligatoire pour tous les utilisateurs et ne peut pas être désactivée.",
            HttpContext);
    }
}
