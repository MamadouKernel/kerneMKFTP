@implements IAsyncDisposable
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthState
@inject ILogger<GlobalSearch> Logger

@if (_isOpen)
{
    <div class="fixed inset-0 z-[100] flex items-start justify-center pt-24 px-4 bg-slate-900/50 backdrop-blur-xs" @onclick="Close">
        <div role="dialog" aria-modal="true" aria-label="Recherche globale" class="bg-white rounded-2xl shadow-2xl w-full max-w-xl border border-slate-200 overflow-hidden" @onclick:stopPropagation="true">
            <div class="flex items-center gap-2.5 px-4 py-3 border-b border-slate-100">
                <svg class="h-4 w-4 text-slate-400 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                </svg>
                <input id="kmk-global-search-input" class="flex-1 text-sm outline-none placeholder:text-slate-400"
                       aria-label="Rechercher" maxlength="100" placeholder="Rechercher un job, un partenaire..." value="@_query"
                       @oninput="OnQueryChanged" @onkeydown="OnKeyDown" />
                <kbd class="text-[10px] px-1.5 py-0.5 rounded bg-slate-100 text-slate-400 border border-slate-200 shrink-0">Échap</kbd>
            </div>

            <div class="max-h-96 overflow-y-auto">
                @if (string.IsNullOrWhiteSpace(_query))
                {
                    <div class="p-6 text-center text-xs text-slate-400">Tape pour chercher parmi les jobs, armateurs et credentials.</div>
                }
                else if (_searching)
                {
                    <div class="p-6 text-center text-xs text-slate-400" role="status">Recherche en cours…</div>
                }
                else if (_error is not null)
                {
                    <div class="p-6 text-center text-xs text-rose-600" role="alert">@_error</div>
                }
                else if (_results.Count == 0)
                {
                    <div class="p-6 text-center text-xs text-slate-400">Aucun résultat pour « @_query ».</div>
                }
                else
                {
                    <div class="divide-y divide-slate-100">
                        @for (var i = 0; i < _results.Count; i++)
                        {
                            var r = _results[i];
                            var isSelected = i == _selectedIndex;
                            <a href="@r.Url" class="flex items-center gap-3 px-4 py-2.5 transition-colors @(isSelected ? "bg-brand-50" : "hover:bg-slate-50")">
                                <span class="h-8 w-8 rounded-lg bg-slate-100 border border-slate-200 flex items-center justify-center text-sm shrink-0">@r.Icon</span>
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-semibold text-slate-900 truncate">@r.Label</div>
                                    <div class="text-[11px] text-slate-400 truncate">@r.SubLabel</div>
                                </div>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool _isOpen;
    private bool _searching;
    private string? _error;
    private CancellationTokenSource? _searchCts;
    private string _query = "";
    private List<SearchResult> _results = new();
    private int _selectedIndex = 0;
    private DotNetObjectReference<GlobalSearch>? _selfRef;
    private bool _jsRegistered;
    private Task? _registrationTask;
    private bool _disposed;

    private record SearchResult(string Label, string SubLabel, string Url, string Icon);

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed) return Task.CompletedTask;
        _selfRef = DotNetObjectReference.Create(this);
        _registrationTask = RegisterAsync();
        return _registrationTask;
    }

    private async Task RegisterAsync()
    {
        await JS.InvokeVoidAsync("kernelMK.globalSearch.register", _selfRef);
        _jsRegistered = true;
    }

    [JSInvokable]
    public async Task ToggleOpen()
    {
        _isOpen = !_isOpen;
        StateHasChanged();
        if (_isOpen)
        {
            await Task.Delay(50);
            await JS.InvokeVoidAsync("kernelMK.focusElementById", "kmk-global-search-input");
        }
    }

    private void Close()
    {
        _searchCts?.Cancel();
        _searching = false;
        _isOpen = false;
        _query = "";
        _results.Clear();
    }

    private async Task OnQueryChanged(ChangeEventArgs e)
    {
        _searchCts?.Cancel();
        using var request = new CancellationTokenSource();
        _searchCts = request;
        var ct = request.Token;
        _query = (e.Value?.ToString() ?? "")[..Math.Min(e.Value?.ToString()?.Length ?? 0, 100)];
        _selectedIndex = 0;
        _results.Clear();
        _error = null;
        _searching = false;
        try
        {
            var q = _query.Trim();
            if (q.Length < 2) return;
            _searching = true;
            await Task.Delay(300, ct);
            var user = (await AuthState.GetAuthenticationStateAsync()).User;
            if (user.Identity?.IsAuthenticated != true) return;
            var canEdit = user.IsInRole("Administrateur") || user.IsInRole("Developpeur");
            await using var db = await DbFactory.CreateDbContextAsync(ct);
            var jobs = await db.Jobs.AsNoTracking()
                .Where(j => j.Name.Contains(q) || (j.Description != null && j.Description.Contains(q)))
                .OrderBy(j => j.Name).Take(5)
                .Select(j => new { j.Id, j.Name, j.Description }).ToListAsync(ct);
            var results = jobs.Select(j => new SearchResult(j.Name, j.Description ?? "Job",
                canEdit ? $"jobs/{j.Id}/edit" : "jobs", "⚙️")).ToList();
            if (canEdit)
            {
                var credentials = await db.Credentials.AsNoTracking()
                    .Where(c => c.Name.Contains(q) || (c.Host != null && c.Host.Contains(q)))
                    .OrderBy(c => c.Name).Take(30)
                    .Select(c => new { c.Name, c.Host, c.AllowedRolesCsv }).ToListAsync(ct);
                results.AddRange(credentials.Where(c => user.IsInRole("Administrateur")
                        || string.IsNullOrWhiteSpace(c.AllowedRolesCsv)
                        || c.AllowedRolesCsv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Any(user.IsInRole))
                    .Take(5).Select(c => new SearchResult(c.Name, c.Host ?? "Connexion", "credentials", "🔑")));
            }
            ct.ThrowIfCancellationRequested();
            _results = results;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Échec de la recherche globale");
            if (!ct.IsCancellationRequested) _error = "Recherche indisponible. Réessayez dans un instant.";
        }
        finally
        {
            if (ReferenceEquals(_searchCts, request))
            {
                _searchCts = null;
                _searching = false;
            }
        }
    }
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                Close();
                break;
            case "ArrowDown":
                if (_results.Count > 0) _selectedIndex = Math.Min(_selectedIndex + 1, _results.Count - 1);
                break;
            case "ArrowUp":
                if (_results.Count > 0) _selectedIndex = Math.Max(_selectedIndex - 1, 0);
                break;
            case "Enter":
                if (_results.Count > 0)
                {
                    var target = _results[_selectedIndex].Url;
                    Close();
                    Navigation.NavigateTo(target);
                }
                break;
        }
        await Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        _searchCts?.Cancel();
        try
        {
            // Finish an in-flight registration before releasing its callback reference.
            if (_registrationTask is not null) await _registrationTask;
            // Static server rendering never runs OnAfterRenderAsync and cannot use JS interop.
            if (_jsRegistered)
            {
                _jsRegistered = false;
                await JS.InvokeVoidAsync("kernelMK.globalSearch.unregister");
            }
        }
        catch (JSDisconnectedException) { }
        finally
        {
            _selfRef?.Dispose();
            _selfRef = null;
        }
    }
}
