@if (TotalItems > 0)
{
    <div class="flex flex-col sm:flex-row items-center justify-between gap-2 px-4 py-3 border-t border-slate-100 text-xs">
        <div class="flex items-center gap-2 text-slate-500">
            <span>@FirstItem–@LastItem sur @TotalItems</span>
            <span class="text-slate-300">·</span>
            <label class="flex items-center gap-1.5">
                <span>Lignes/page</span>
                <select class="kmk-select !py-1 !text-xs !w-auto" value="@PageSize" @onchange="OnPageSizeChanged">
                    @foreach (var size in PageSizeOptions)
                    {
                        <option value="@size">@size</option>
                    }
                </select>
            </label>
        </div>
        <div class="flex items-center gap-1">
            <button type="button" class="kmk-btn-secondary kmk-btn-xs" disabled="@(CurrentPage <= 1)" @onclick="() => GoTo(1)" title="Première page">«</button>
            <button type="button" class="kmk-btn-secondary kmk-btn-xs" disabled="@(CurrentPage <= 1)" @onclick="() => GoTo(CurrentPage - 1)" title="Page précédente">‹</button>
            <span class="px-2 text-slate-600 font-semibold whitespace-nowrap">Page @CurrentPage / @TotalPages</span>
            <button type="button" class="kmk-btn-secondary kmk-btn-xs" disabled="@(CurrentPage >= TotalPages)" @onclick="() => GoTo(CurrentPage + 1)" title="Page suivante">›</button>
            <button type="button" class="kmk-btn-secondary kmk-btn-xs" disabled="@(CurrentPage >= TotalPages)" @onclick="() => GoTo(TotalPages)" title="Dernière page">»</button>
        </div>
    </div>
}

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public EventCallback<int> CurrentPageChanged { get; set; }
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }
    [Parameter] public int TotalItems { get; set; }

    private static readonly int[] PageSizeOptions = { 10, 25, 50, 100 };

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalItems / (double)PageSize));
    private int FirstItem => TotalItems == 0 ? 0 : (CurrentPage - 1) * PageSize + 1;
    private int LastItem => Math.Min(CurrentPage * PageSize, TotalItems);

    private async Task GoTo(int page)
    {
        page = Math.Clamp(page, 1, TotalPages);
        if (page == CurrentPage) return;
        CurrentPage = page;
        await CurrentPageChanged.InvokeAsync(page);
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var newSize) || newSize == PageSize) return;
        PageSize = newSize;
        await PageSizeChanged.InvokeAsync(newSize);
        // Revenir en page 1 : l'ancienne page courante n'a plus forcément de sens avec la nouvelle taille.
        await GoTo(1);
    }
}
