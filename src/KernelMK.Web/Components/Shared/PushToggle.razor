@rendermode InteractiveServer
@inject IJSRuntime JS

@if (_status == "subscribed")
{
    <button type="button" @onclick="Toggle" disabled="@_busy"
            class="hidden sm:flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-600 text-xs transition-colors"
            title="Notifications push activées sur cet appareil — cliquer pour désactiver">
        <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" /></svg>
    </button>
}
else if (_status == "unsubscribed")
{
    <button type="button" @onclick="Toggle" disabled="@_busy"
            class="hidden sm:flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-500 text-xs transition-colors"
            title="Activer les notifications push sur cet appareil (alertes même hors de l'onglet)">
        <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.143 17.082a24.248 24.248 0 0 1-5.454-1.31A8.967 8.967 0 0 0 6 9.75V9a6 6 0 0 1 6-6c1.517 0 2.913.526 4.01 1.406M18 9c0 1.821.414 3.545 1.152 5.08M3 3l18 18m-8.143-4.918a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" /></svg>
    </button>
}

@code {
    private string _status = "unsupported";
    private bool _busy = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _status = await JS.InvokeAsync<string>("kernelMK.push.getStatus");
            StateHasChanged();
        }
    }

    private async Task Toggle()
    {
        _busy = true;
        try
        {
            if (_status == "subscribed")
            {
                var ok = await JS.InvokeAsync<bool>("kernelMK.push.unsubscribe");
                if (ok) _status = "unsubscribed";
            }
            else
            {
                var ok = await JS.InvokeAsync<bool>("kernelMK.push.subscribe");
                _status = ok ? "subscribed" : await JS.InvokeAsync<string>("kernelMK.push.getStatus");
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
